{"id":76,"date":"2016-05-16T12:49:48","date_gmt":"2016-05-16T12:49:48","guid":{"rendered":"http:\/\/masterbadminton.dev\/badminton-serve\/"},"modified":"2016-09-05T13:50:07","modified_gmt":"2016-09-05T13:50:07","slug":"badminton-serve","status":"publish","type":"post","link":"https:\/\/masterbadminton.com\/zh\/badminton-serve.html","title":{"rendered":"\u7fbd\u6bdb\u7403\u53d1\u7403"},"content":{"rendered":"<div id=\"ContentColumn\">\n<div class=\"Liner\">\n<div style=\"float: left;\"><\/div>\n<p>\u7fbd\u6bdb\u7403\u53d1\u7403\u6709\u4e24\u79cd\u65b9\u6cd5\uff08\u9ad8\u53d1\u7403\u548c\u4f4e\u53d1\u7403\uff09\uff0c\u53d6\u51b3\u4e8e\u4f60\u60f3\u8ba9\u7fbd\u6bdb\u7403\u843d\u5728\u54ea\u91cc\u3002<\/p>\n<p class=\"translation-block\">\u5728\u8fdb\u884c\u53d1\u7403\u65f6\u5fc5\u987b\u9075\u5b88\u4e00\u5b9a\u7684\u89c4\u5219\u3002\u8bf7\u67e5\u770b\u7fbd\u6bdb\u7403\u53d1\u7403\u8fdd\u4f8b\u4ee5\u907f\u514d\u72af\u89c4\u3002<\/p>\n<h3>\u4e00\u4e2a\u597d\u7684\u7fbd\u6bdb\u7403\u53d1\u7403\u7684\u91cd\u8981\u6027<\/h3>\n<p>\u7fbd\u6bdb\u7403\u53d1\u7403\u662f\u6bd4\u8d5b\u4e2d\u5fc5\u4e0d\u53ef\u5c11\u7684\u4e00\u4e2a\u65b9\u9762\uff0c\u5f31\u52bf\u7684\u53d1\u7403\u5f88\u5bb9\u6613\u8ba9\u5bf9\u624b\u5728\u6bd4\u8d5b\u4e2d\u5360\u4e0a\u98ce\u3002\u4e00\u6b21\u7cdf\u7cd5\u7684\u53d1\u7403\u53ef\u80fd\u4f1a\u5bfc\u81f4\u4f60\u5931\u5206\u3002<\/p>\n<h3>1. \u9ad8\u8fdc\u53d1\u7403<\/h3>\n<p class=\"translation-block\">\u5f53\u4f60\u60f3\u8ba9\u7fbd\u6bdb\u7403\u843d\u5728\u573a\u5730\u540e\u65b9\u65f6\uff0c\u901a\u5e38\u4f1a\u91c7\u7528\u8fd9\u79cd\u53d1\u7403\u65b9\u5f0f\u3002\u4e00\u6b21\u597d\u7684\u9ad8\u8fdc\u53d1\u7403\u5fc5\u987b\u8ba9\u7fbd\u6bdb\u7403\u5728\u573a\u5730\u540e\u65b9\u9661\u5ced\u5730\u4e0b\u843d\u3002<\/p>\n<p>\u9ad8\u8fdc\u53d1\u7403\u4f1a\u9632\u6b62\u4f60\u7684\u5bf9\u624b\u8fdb\u884c\u5f3a\u6709\u529b\u7684\u8df3 smash\u3002\u76f8\u53cd\uff0c\u4f60\u7684\u5bf9\u624b\u66f4\u53ef\u80fd\u8fdb\u884c\u4e00\u4e2a\u9ad8\u540a\u7403\u6216\u8005\u4e0b\u538b\u7403\uff08\u9664\u975e\u4ed6\u4eec\u80fd\u591f\u8fdb\u884c\u8df3 smash\uff09\u3002<\/p>\n<p>\u8bd5\u7740\u5c06\u7fbd\u6bdb\u7403\u53d1\u5411\u5bf9\u624b\u7684\u53cd\u624b\u533a\u57df\u3002\u76ee\u6807\u662f\u8feb\u4f7f\u4f60\u7684\u5bf9\u624b\u4f7f\u7528\u4ed6\u7684\u53cd\u624b\u3002\u8fd9\u662f\u56e0\u4e3a\u5927\u591a\u6570\u7fbd\u6bdb\u7403\u9009\u624b\uff0c\u5373\u4f7f\u662f\u4e16\u754c\u7ea7\u9009\u624b\uff0c\u53cd\u624b\u6bd4\u6b63\u624b\u5f31\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/03\/348x196xhigh-serve-angle.jpg.pagespeed.ic.GrgfXjuCPR.jpg\" alt=\"high serve trajectory\" width=\"348\" height=\"196\" \/><\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/03\/400x203xserve-1.gif.pagespeed.ic.DnCxdC0CG3.png\" alt=\"badminton high serve location\" width=\"400\" height=\"203\" \/><\/p>\n<p>\u62bd\u8c61\u5730\u8bf4\uff0c\u5047\u8bbe\u4f60\u7ad9\u5728X\u70b9\u3002\u4f60\u51c6\u5907\u8fdb\u884c\u4e00\u4e2a\u9ad8\u8fdc\u53d1\u7403...\u800c\u4f60\u7684\u5bf9\u624b\u662f\u53f3\u624b\u9009\u624b\u3002\u5728\u8fd9\u79cd\u60c5\u51b5\u4e0b\uff0c\u5c06\u7fbd\u6bdb\u7403\u76f4\u63a5\u843d\u5728A\u70b9\u4f1a\u66f4\u597d\u3002<\/p>\n<p class=\"translation-block\">\u8fd9\u4f1a\u8feb\u4f7f\u5bf9\u624b\u4f7f\u7528\u53cd\u624b\uff0c\u56e0\u6b64\u4ed6\u4f1a\u66f4\u6709\u53ef\u80fd\u56de\u51fb\u4e00\u4e2a\u5f31\u70b9\u3002<\/p>\n<p class=\"translation-block\">\u5982\u679c\u4f60\u5c06\u7403\u6253\u5230\u5bf9\u624b\u7684\u53cd\u624b\u533a\u57df\uff0c\u4f46\u4ed6\/\u5979\u62d2\u7edd\u4f7f\u7528\u53cd\u624b\uff0c\u90a3\u4e48\u4ed6\u5c06\u4e0d\u5f97\u4e0d\u79bb\u5f00\u81ea\u5df1\u7684\u57fa\u7840\u4f4d\u7f6e\u66f4\u8fdc\uff01\u8fd9\u7ed9\u4e86\u4f60\u673a\u4f1a\uff0c\u5982\u679c\u4f60\u7684\u5bf9\u624b\u7684\u811a\u6b65\u6280\u672f\u4e0d\u597d\u7684\u8bdd\uff0c\u4f60\u53ef\u4ee5\u63a7\u5236\u6bd4\u8d5b\u3002\u8ba9\u6211\u5411\u4f60\u5c55\u793a\u5982\u4f55\u8fdb.<\/p>\n<p class=\"translation-block\">\u884c\u9ad8\u8fdc\u53d1\u7403...<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/03\/254x229xserve-2.jpg.pagespeed.ic.8rw1GB_eN5.jpg\" alt=\"badminton high serve\" width=\"254\" height=\"229\" \/><\/p>\n<ul>\n<li>\u5c06\u7fbd\u6bdb\u7403\u62cd\u5934\u5411\u4e0b\uff0c\u6293\u4f4f\u7fbd\u6bdb\u7403\u5934\u90e8\uff0c\u4f7f\u7fbd\u6bdb\u7403\u5782\u76f4\u5411\u4e0b\u3002<\/li>\n<\/ul>\n<ul>\n<li>\u7ad9\u5728\u4fa7\u9762\uff08\u9762\u5bf9\u7f51\u7684\u4e00\u4fa7\uff09\uff0c\u653e\u677e\u62ff\u62cd\u7684\u624b\u81c2\u3002<\/li>\n<\/ul>\n<ul>\n<li class=\"translation-block\">\u677e\u5f00\u7fbd\u6bdb\u7403\uff0c\u5411\u4e0a\u6325\u62cd\u81c2\u3002\u5728\u6325\u62cd\u7684\u540c\u65f6\uff0c\u626d\u8f6c\u8170\u90e8\u4f7f\u8eab\u4f53\u9762\u5411\u7f51\u3002\u5411\u60f3\u8981\u8ba9\u7fbd\u6bdb\u7403\u843d\u4e0b\u7684\u65b9\u5411\u5feb\u901f\u6325\u52a8\u624b\u8155\uff08\u5411\u4e0a\u6325\u52a8\u624b\u8155\uff0c\u8fd9\u6837\u7fbd\u6bdb\u7403\u5c31\u4f1a\u98de\u5f97\u66f4\u9ad8\uff09\u3002<\/li>\n<\/ul>\n<ul>\n<li>\u4f60\u7684\u540e\u817f\u5e94\u8be5\u81ea\u7136\u62ac\u8d77\uff08\u811a\u8dbe\u7740\u5730\u3002<\/li>\n<\/ul>\n<p>\u9ad8\u8fdc\u53d1\u7403\u5e38\u7528\u4e8e\u5bf9\u624b\u65e0\u6cd5\u5728\u573a\u5730\u540e\u7aef\u8fdb\u884c\u5f3a\u6709\u529b\u7684\u6263\u6740\u7684\u60c5\u51b5\u3002<\/p>\n<p class=\"translation-block\">\u7136\u800c\uff0c\u4e00\u4e9b\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\uff08\u5c24\u5176\u662f\u8eab\u6750\u8f83\u9ad8\u7684\u7403\u5458\uff09\u751a\u81f3\u5728\u573a\u5730\u540e\u7aef\u4e5f\u80fd\u8fdb\u884c\u5f3a\u6709\u529b\u7684\u6263\u6740\uff08\u901a\u5e38\u662f\u8df3\u8dc3\u6263\u6740\uff09\u3002<\/p>\n<p class=\"translation-block\">\u5982\u679c\u662f\u8fd9\u79cd\u60c5\u51b5\uff0c\u8003\u8651\u6539\u7528\u4f4e\u8fdc\u53d1\u7403\u3002\u8fd9\u4e5f\u662f\u4e3a\u4ec0\u4e48\u73b0\u5728\u804c\u4e1a\u7403\u5458\u66f4\u559c\u6b22\u4f7f\u7528\u4f4e\u8fdc\u53d1\u7403\u7684\u539f\u56e0\u3002<\/p>\n<h3>2. \u4f4e\u4f4d\u7fbd\u6bdb\u7403\u53d1\u7403<\/h3>\n<p>\u4f4e\u8ff7\u7403\u53d1\u7403\u662f\u7528\u4e8e\u4f7f\u7fbd\u6bdb\u7403\u843d\u5728\u7403\u573a\u524d\u65b9\uff08\u5728\u5bf9\u624b\u8eab\u524d\uff09\u7684\u53d1\u7403\u65b9\u5f0f\u3002<\/p>\n<p>\u4e00\u4e2a\u597d\u7684\u4f4e\u8ff7\u7403\u53d1\u7403\u5e94\u8be5\u4f7f\u7fbd\u6bdb\u7403\u98de\u8d8a\u7f51\u7684\u4e0a\u6cbf\u3002<\/p>\n<p>\u5426\u5219\uff0c\u4f60\u7684\u5bf9\u624b\u5c31\u6709\u673a\u4f1a\u5411\u524d\u51b2\u523a\u5e76\u5c06\u7fbd\u6bdb\u7403\u5f80\u4e0b\u91cd smash \u7ed9\u4f60\u3002<\/p>\n<p>\u4e00\u4e2a\u6f02\u4eae\u7684\u4f4e\u8ff7\u7403\u53d1\u7403\u53ef\u4ee5\u9632\u6b62\u5bf9\u624b\u53d1\u8d77\u653b\u52bf\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/03\/348x196xlow-serve-angle.jpg.pagespeed.ic.L_8fJ7fqvT.jpg\" alt=\"low serve trajectory\" width=\"348\" height=\"196\" \/><\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/03\/400x203xshort-serve-example1.jpg.pagespeed.ic.noavJ5QjUz.jpg\" alt=\"badminton low serve location\" width=\"400\" height=\"203\" \/><\/p>\n<p>\u4e0e\u9ad8\u8fdc\u53d1\u7403\u4e0d\u540c\uff0c\u4f60\u53ef\u4ee5\u8ba9\u7fbd\u6bdb\u7403\u5728\u5bf9\u624b\u524d\u65b9\u7684\u4efb\u4f55\u4f4d\u7f6e\u843d\u5730\uff08\u5728\u5bf9\u624b\u7684\u6b63\u624b\u533a\u57df\u6216\u53cd\u624b\u533a\u57df\uff09\u3002<\/p>\n<p>\u8fd9\u5e76\u4e0d\u4f1a\u6709\u6240\u5f71\u54cd\uff0c\u56e0\u4e3a\u8fd9\u4e0d\u4f1a\u6253\u4e71\u5bf9\u624b\u7684\u6b65\u6cd5\u3002<\/p>\n<p>\u4f5c\u4e3a\u4e00\u4e2a\u5f00\u59cb\uff0c\u7ec3\u4e60\u53d1\u7403\uff0c\u8ba9\u7fbd\u6bdb\u7403\u6389\u5728\u4f60\u5bf9\u624b\u7684\u6b63\u524d\u65b9\uff08\u4e0a\u56fe\u4e2d\u7684A\u70b9\uff09\u3002<\/p>\n<p><strong>\u8ba9\u6211\u6765\u5411\u60a8\u5c55\u793a