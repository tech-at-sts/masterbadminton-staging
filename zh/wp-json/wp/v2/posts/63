{"id":63,"date":"2016-05-16T12:48:50","date_gmt":"2016-05-16T12:48:50","guid":{"rendered":"http:\/\/masterbadminton.dev\/badminton-psychology\/"},"modified":"2023-05-01T00:35:24","modified_gmt":"2023-05-01T00:35:24","slug":"badminton-psychology-html-html","status":"publish","type":"post","link":"https:\/\/masterbadminton.com\/zh\/badminton-psychology.html","title":{"rendered":"\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66"},"content":{"rendered":"<div id=\"ContentColumn\">\n<div class=\"Liner\">\n<p>\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\u5728\u60a8\u7684\u6bd4\u8d5b\u4e2d\u626e\u6f14\u7740\u91cd\u8981\u89d2\u8272\uff0c\u5c24\u5176\u662f\u5f53\u60a8\u8fdb\u884c\u7ade\u6280\u6bd4\u8d5b\u65f6\uff08\u65e0\u8bba\u662f\u5b98\u65b9\u8fd8\u662f\u975e\u5b98\u65b9\u6bd4\u8d5b\uff09\u3002<\/p>\n<div style=\"float: left; margin-right: 10px;\">\u5728\u6bd4\u8d5b\u4e2d\uff0c\u6709\u65f6\u60a8\u9700\u8981\u5728\u60a8\u751f\u547d\u4e2d\u4ece\u672a\u6253\u8fc7\u7684\u7fbd\u6bdb\u7403\u573a\u4e0a\u6bd4\u8d5b\u3002\u6709\u4e9b\u5728\u8be5\u573a\u5730\u6253\u8fc7\u7403\u7684\u7403\u5458\u5c06\u62e5\u6709\u660e\u663e\u7684\u201c\u4e3b\u573a\u4f18\u52bf\u201d\uff0c\u8fd9\u53ef\u80fd\u4f1a\u589e\u5f3a\u4ed6\/\u5979\u7684\u5fc3\u7406\u529b\u91cf\u3002\u8fd9\u53ef\u80fd\u4f1a\u5728\u6bd4\u8d5b\u4e2d\u4f7f\u60a8\u611f\u5230\u4e0d\u5b89\u3002\u7136\u800c\uff0c\u826f\u597d\u7684\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\u53ef\u4ee5\u5e2e\u52a9\u60a8\u5728\u6bd4\u8d5b\u4e2d\u611f\u5230\u8212\u9002\uff0c\u5e76\u83b7\u5f97\u4f18\u52bf\u3002\u8fd9\u6709\u52a9\u4e8e\u60a8\u514b\u670d\u5bf9\u624b\u73a9\u7684\u5fc3\u7406\u6218\u3002\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\uff1a\u5bf9\u60a8\u4e0d\u5229\u7684\u56e0\u7d20<\/div>\n<p>\u5f53\u60a8\u5728\u4e0d\u719f\u6089\u7684\u65b0\u7fbd\u6bdb\u7403\u573a\u4e0a\u6bd4\u8d5b\u65f6\uff0c\u4ee5\u4e0b\u56e0\u7d20\u53ef\u80fd\u4f1a\u5728\u5fc3\u7406\u4e0a\u5f71\u54cd\u60a8\u3002<\/p>\n<p>\u8fd9\u4e9b\u56e0\u7d20\u53ef\u80fd\u4f1a\u5f71\u54cd\u60a8\u7684\u4fe1\u5fc3\uff0c\u5e76\u5bfc\u81f4\u8868\u73b0\u4e0d\u4f73\u3002<\/p>\n<p><b>1. \u7a7f\u68ad\u901f\u5ea6<\/b><\/p>\n<p>\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\uff0c\u60a8\u4f1a\u53d1\u73b0\u8eab\u5904\u4e0d\u540c\u5730\u533a\u65f6\u7fbd\u6bdb\u7403\u7684\u901f\u5ea6\u662f\u4e0d\u540c\u7684\u3002<\/p>\n<p>\u7fbd\u6bdb\u7403\u7684\u901f\u5ea6\u53d7\u6c14\u5019\u3001\u5929\u6c14\u3001\u7a7a\u6c14\u4e2d\u7684\u6e7f\u5ea6\u548c\u5176\u4ed6\u51e0\u4e2a\u56e0\u7d20\u7684\u5f71\u54cd\u3002<\/p>\n<p>\u60a8\u9700\u8981\u5728\u60a8\u6240\u5728\u7684\u5730\u533a\u4ee5\u9002\u5f53\u7684\u901f\u5ea6\u4f7f\u7528\u7fbd\u6bdb\u7403\u4ee5\u7b26\u5408\u56fd\u9645\u6807\u51c6\u3002<\/p>\n<p class=\"translation-block\">\u70b9\u51fb\u8fd9\u91cc\u9605\u8bfb\u66f4\u591a\u5173\u4e8e\u7fbd\u6bdb\u7403\u7a7f\u68ad\u901f\u5ea6\u7684\u4fe1\u606f\u3002<\/p>\n<p class=\"translation-block\">\u4f46\u662f\uff0c\u540c\u4e00\u5730\u533a\u7684\u540c\u4e00\u53ea\u6bfd\u5b50\uff0c\u5374\u53ef\u4ee5\u98de\u51fa\u4e0d\u540c\u7684\u901f\u5ea6\uff01<\/p>\n<p>\u7a7a\u6c14\u5bc6\u5ea6\u4e5f\u4f1a\u5f71\u54cd\u822a\u5929\u98de\u673a\u7684\u901f\u5ea6\u3002\u98de\u68ad\u5728\u4e0d\u540c\u7684\u7fbd\u6bdb\u7403\u9986\u4ee5\u4e0d\u540c\u7684\u901f\u5ea6\u98de\u884c\u3002\u5dee\u5f02\u5f88\u5c0f\uff0c\u4f46\u5bf9\u4e8e\u67d0\u4e9b\u73a9\u5bb6\u6765\u8bf4\uff0c\u7403\u901f\u7684\u5fae\u5c0f\u5dee\u5f02\u53ef\u80fd\u4f1a\u5bfc\u81f4\u4e25\u91cd\u7684\u8f93\u8d62\u3002<\/p>\n<p>\u60a8\u4f1a\u53d1\u73b0\u7fbd\u6bdb\u7403\u5f80\u5f80\u5728\u8f83\u5c0f\u7684\u7fbd\u6bdb\u7403\u9986\u4e2d\u98de\u5f97\u66f4\u5feb\uff0c\u800c\u5728\u8f83\u5927\u7684\u7fbd\u6bdb\u7403\u9986\u4e2d\u98de\u5f97\u66f4\u5feb\u3002<\/p>\n<p class=\"translation-block\">\u5982\u679c\u60a8\u8ba4\u4e3a\u6bd4\u8d5b\u7528\u7684\u7fbd\u6bdb\u7403\u98de\u5f97\u6bd4\u5e73\u65f6\u5feb\uff0c\u8bf7\u907f\u514d\u9ad8\u7403\u6216\u7a7a\u7403\u3002\u907f\u514d\u9ad8\u53d1\u7403\u3002\u4e5f\u5c3d\u91cf\u4e0d\u8981\u6253\u7fbd\u6bdb\u7403\u3002<\/p>\n<p>\u8fd9\u53ef\u4ee5\u5e2e\u52a9\u60a8\u51cf\u5c11\u5c06\u7403\u51fb\u51fa\u573a\u5916\u7684\u673a\u4f1a\u3002<\/p>\n<p><b>2.\u706f\u5149<br \/>\n<\/b><\/p>\n<p>\u5982\u679c\u6211\u5fc5\u987b\u76f4\u8a00\u4e0d\u8bb3\uff0c\u4e00\u4e9b\u7fbd\u6bdb\u7403\u573a\u5730\u7684\u7167\u660e\u6761\u4ef6\u786e\u5b9e\u5f88\u7cdf\u7cd5\u3002\u6709\u4e9b\u573a\u5730\u7684\u706f\u5149\u90fd\u5b89\u88c5\u5728\u5929\u82b1\u677f\u4e0a\uff0c\u4f4d\u7f6e\u4e0d\u4f73\u3002<\/p>\n<p>\u8fd9\u4f1a\u5f71\u54cd\u6bd4\u8d5b\u6548\u679c\uff0c\u5f53\u4f60\u9762\u5bf9\u7740\u706f\u5149\u65f6\u53ef\u80fd\u65e0\u6cd5\u6e05\u6670\u5730\u770b\u5230\u7fbd\u6bdb\u7403\u3002<\/p>\n<p>\u56e0\u6b64\uff0c\u4f60\u7684\u51fb\u7403\u65f6\u673a\u4f1a\u53d7\u5230\u8d1f\u9762\u5f71\u54cd\u3002\u751a\u81f3\u53ef\u80fd\u4f1a\u5b8c\u5168\u9519\u8fc7\u7fbd\u6bdb\u7403\uff01<\/p>\n<p>\u7136\u800c\uff0c\u5982\u679c\u4f60\u7684\u5bf9\u624b\u5728\u8fd9\u91cc\u6253\u4e86\u4e00\u6bb5\u65f6\u95f4\uff0c\u53ef\u80fd\u5df2\u7ecf\u4e60\u60ef\u4e86\u8fd9\u79cd\u60c5\u51b5\u3002<\/p>\n<p>\u4e0d\u8981\u611f\u5230\u6cae\u4e27\uff01<\/p>\n<p>\u5f53\u4f60\u4ece\u5bf9\u624b\u90a3\u91cc\u83b7\u5f97\u9ad8\u7403\u6216\u9ad8\u8fdc\u7403\u65f6\uff0c\u706f\u5149\u53ef\u80fd\u4f1a\u5e72\u6270\u4f60\u7684\u89c6\u7ebf\u3002<\/p>\n<p>\u5728\u8fd9\u4e9b\u60c5\u51b5\u4e0b\uff0c\u9009\u62e9\u6253\u51fa\u9ad8\u8fdc\u7403\u6216\u6311\u6218\u7403\uff0c\u800c\u4e0d\u662f\u653b\u51fb\u6027\u7684\u51fb\u7403.<\/p>\n<p>\u76f8\u6bd4\u4e8e\u653b\u51fb\u6027\u7684\u6253\u6cd5\uff0c\u9ad8\u8fdc\u7403\u6216\u6311\u6218\u7403\u66f4\u5bb9\u6613\u638c\u63a7\u597d\u65f6\u673a\u3002<\/p>\n<p>\u8010\u5fc3\u70b9\uff0c\u4e13\u6ce8\u4e8e\u96c6\u4f1a\u3002\u4e0d\u8981\u5192\u4e0d\u5fc5\u8981\u7684\u98ce\u9669\uff0c\u4f8b\u5982<br \/>\n\u5f53\u706f\u5149\u76f4\u63a5\u7167\u5c04\u5230\u60a8\u7684\u8138\u4e0a\u65f6\uff0c\u5c31\u50cf\u7c89\u788e\u4e00\u6837\u3002<\/p>\n<p><b>3. \u6e7f\u6ed1\u7684\u5730\u677f<br \/>\n<\/b><\/p>\n<p>\u6709\u4e9b\u5730\u677f\u975e\u5e38\u6ed1\uff0c\u7279\u522b\u662f\u5728\u6c14\u5019\u5e72\u71e5\u7684\u56fd\u5bb6\uff08\u6e7f\u5ea6\u8f83\u4f4e\u7684\u5730\u65b9\uff09\u3002\u6b64\u5916\uff0c\u5730\u677f\u4e0a\u7684\u7070\u5c18\u4e5f\u4f1a\u4f7f\u5730\u677f\u53d8\u5f97\u6ed1\u6e9c\u3002<\/p>\n<p>\u9664\u6b64\u4e4b\u5916\uff0c\u5730\u677f\u4e0a\u7684\u7070\u5c18\u4f1a\u4f7f\u5730\u677f\u5f88\u6ed1\u3002<\/p>\n<p>\u5982\u679c\u4f60\u53d1\u73b0\u5730\u677f\u6bd4\u5e73\u5e38\u7684\u7403\u573a\u66f4\u6ed1\uff0c\u53ef\u4ee5\u5728\u6bd4\u8d5b\u4e2d\u95f4\u4f11\u606f\u4e00\u4f1a\u513f\u3002<\/p>\n<p>\u5728\u573a\u5916\u8ba9\u6c34\u74f6\u4e2d\u6ef4\u51fa\u51e0\u6ef4\u6c34\u3002<\/p>\n<p>\u7136\u540e\u7528\u51e0\u6ef4\u6c34\u64e6\u978b\u3002\u8fd9\u5c06\u5e2e\u52a9\u60a8\u5728\u51e0\u6b21\u62c9\u529b\u8d5b\u4e2d\u83b7\u5f97\u826f\u597d\u7684\u6293\u5730\u529b\u3002<\/p>\n<p>\u4f46\u662f\u4e0d\u8981\u8fc7\u5ea6\u4f7f\u7528\uff01<\/p>\n<p>\u8981\u5feb\u901f\u5730\u5b8c\u6210\u5e76\u8fc5\u901f\u56de\u5230\u6bd4\u8d5b\u4e2d\u3002<\/p>\n<p>\u5426\u5219\uff0c\u5bf9\u624b\u53ef\u80fd\u4f1a\u62b1\u6028\uff0c\u4f60\u5c06\u88ab\u7981\u6b62\u8fd9\u6837\u505a\u3002<\/p>\n<p><span style=\"font-size: 20px; color: #ff0000;\"><b>3\u79cd\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\u65b9\u6cd5\uff0c\u5e2e\u52a9\u4f60\u91cd\u65b0\u8fdb\u5165\u6bd4\u8d5b<\/b><\/span><\/p>\n<p><b>1. \u7d27\u5f20\u65f6\u8ba9\u81ea\u5df1\u51b7\u9759\u4e0b\u6765<\/b><\/p>\n<p class=\"translation-block\">\u7fbd\u6bdb\u7403\u662f\u4e00\u9879\u9ad8\u5ea6\u4f9d\u8d56\u63a7\u5236\u7684\u8fd0\u52a8\u3002\u56e0\u6b64\uff0c\u653e\u677e\u808c\u8089\u4ee5\u66f4\u597d\u5730\u63a7\u5236\u7403\u62cd\u3002<\/p>\n<p>\u4e0d\u8981\u592a\u6025\u4e8e\u53d1\u7403\u3002\u5728\u6bd4\u8d5b\u4e2d\u95f4\u4f11\u606f\u4e00\u4f1a\u513f\uff0c\u4f7f\u81ea\u5df1\u4fdd\u6301\u51b7\u9759\u3002<\/p>\n<p>\u5982\u679c\u4f60\u611f\u5230\u7d27\u5f20\uff0c\u5c31\u4f1a\u5f71\u54cd\u4f60\u7684\u601d\u7ef4\u6e05\u6670\u5ea6\u3002<\/p>\n<p>\u4f60\u5c31\u65e0\u6cd5\u786e\u5b9a\u6b63\u5728\u9762\u5bf9\u4f55\u79cd\u7c7b\u578b\u7684\u6bd4\u8d5b\u3002<\/p>\n<p><b>2. \u63a7\u5236\u6bd4\u8d5b\u7684\u8282\u594f<\/b><\/p>\n<p>\u5982\u679c\u4f60\u6ce8\u610f\u5230\uff0c\u7fbd\u6bdb\u7403\u6bd4\u8d5b\u901a\u5e38\u4ee5\u4e00\u5b9a\u7684\u8282\u594f\u8fdb\u884c\u3002<\/p>\n<p>\u4e00\u4f4d\u6210\u529f\u7684\u7fbd\u6bdb\u7403\u5355\u6253\u9009\u624b\u5e94\u8be5\u59cb\u7ec8\u638c\u63a7\u6bd4\u8d5b\u7684\u8282\u594f\u3002<\/p>\n<p>\u8fd9\u610f\u5473\u7740\u4f60\u5e94\u8be5\u63a7\u5236\u6bd4\u8d5b\u4e2d\u7684\u56de\u5408\u901f\u5ea6\uff0c\u4ee5\u5728\u6bd4\u8d5b\u4e2d\u5360\u636e\u4e3b\u5bfc\u5730\u4f4d\u3002<\/p>\n<p>\u6709\u65f6\u5728\u6bd4\u8d5b\u4e2d\uff0c\u5982\u679c\u4f60\u592a\u7d27\u5f20\u6216\u7f3a\u4e4f\u81ea\u4fe1\uff0c\u4f60\u5e94\u8be5\u603b\u662f\u6253\u4e00\u4e2a\u6162\u4e00\u70b9\u7684\u6bd4\u8d5b\u3002<\/p>\n<p>\u4e0d\u8981\u592a\u9891\u7e41\u8fdb\u653b\u3002\u6253\u9ad8\u8fdc\u7403\u6765\u7ed9\u81ea\u5df1\u4e89\u53d6\u66f4\u591a\u65f6\u95f4\u3002<\/p>\n<p>\u73a9\u4e00\u4e2a\u7b56\u7565\u6027\u7684\u6bd4\u8d5b\u3002\u8ba1\u5212\u4f60\u7684\u4e0b\u4e00\u6b65\u3002\u4e0d\u8981\u53ea\u662f\u4e3a\u4e86\u5c06\u7403\u9001\u5230\u5bf9\u624b\u7684\u4e00\u4fa7\u800c\u8fd4\u56de\u7fbd\u6bdb\u7403\u3002<\/p>\n<p>\u907f\u514d\u4e0e\u5bf9\u624b\u4ea4\u6362\u5feb\u901f\u7fbd\u6bdb\u7403\u63a8\u7403\u3002\u4f60\u8d8a\u7d27\u5f20\uff0c\u8d8a\u6709\u53ef\u80fd\u628a\u7403\u51fb\u5f97\u8fc7\u731b\uff0c\u628a\u7403\u6253\u51fa\u573a\u5916\u3002<\/p>\n<p class=\"translation-block\">\u5f53\u5bf9\u624b\u76f4\u63a5\u5c06\u7fbd\u6bdb\u7403\u63a8\u5411\u4f60\u65f6\uff0c\u53ef\u4ee5\u6253\u4e00\u4e2a\u4e0b\u65cb\u7403\u6216\u9ad8\u8fdc\u7403\u3002<\/p>\n<p>\u5728\u6bd4\u8d5b\u4e2d\u91c7\u7528\u4e00\u4e9b\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\u7684\u65b9\u6cd5\uff01<\/p>\n<p><b>3. \u5728\u524d\u51e0\u4e2a\u56de\u5408\u4e2d\u5192\u4e00\u4e9b\u9669<\/b><\/p>\n<p>\u8981\u5229\u7528\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\u5bf9\u6297\u5bf9\u624b\uff0c\u4e00\u4e2a\u597d\u65b9\u6cd5\u662f\u5728\u6bd4\u8d5b\u7684\u524d\u51e0\u4e2a\u56de\u5408\u4e2d\u83b7\u5f97\u4e00\u4e9b\u4f18\u52bf\u3002<\/p>\n<p class=\"translation-block\">\u8fd9\u662f\u5728\u6bd4\u8d5b\u4e00\u5f00\u59cb\u5c31\u8ba9\u52bf\u5934\u671d\u4f60\u65b9\u503e\u659c\u7684\u597d\u65b9\u6cd5\u3002<\/p>\n<p class=\"translation-block\">\u662f\u7684\uff0c\u8fd9\u662f\u4e00\u79cd\u8ba9\u6bd4\u8d5b\u4e00\u5f00\u59cb\u5c31\u8ba9\u52bf\u5934\u671d\u4f60\u65b9\u503e\u659c\u7684\u597d\u65b9\u6cd5\u3002<\/p>\n<p>\u53ea\u8981\u4f60\u9884\u6599\u5230\u5bf9\u624b\u4f1a\u53d1\u4e00\u4e2a\u65cb\u8f6c\u7f51\u524d\u5c0f\u7403\uff0c\u5c31\u5411\u524d\u8dc3\u51fa\u5e76\u8fdb\u884c\u51fb\u6740\uff0c\u65e0\u8bba\u7403\u8def\u662f\u5426\u7d27\u5bc6\u3002<\/p>\n<p>\u8fd9\u662f\u4e00\u79cd\u9ad8\u98ce\u9669\u7684\u505a\u6cd5\u3002\u4f46\u5982\u679c\u8fd9\u4e2a\u51fb\u6740\u5f97\u624b\u4e86\uff0c\u4f60\u7684\u58eb\u6c14\u80af\u5b9a\u4f1a\u5927\u5927\u63d0\u9ad8\u3002<\/p>\n<p>\u5373\u4f7f\u4f60\u6ca1\u80fd\u628a\u7fbd\u6bdb\u7403\u8fc7\u7f51\uff0c\u8fd9\u4e2a\u7f51\u524d\u6740\u7403\u4e5f\u4f1a\u5728\u5fc3\u7406\u4e0a\u5bf9\u4f60\u7684\u5bf9\u624b\u4ea7\u751f\u5f71\u54cd\u3002<\/p>\n<p class=\"translation-block\">\u7136\u800c\uff0c\u8bf7\u6ce8\u610f\u4f60\u6b63\u5728\u5192\u5f88\u9ad8\u7684\u98ce\u9669\u3002\u4e0d\u8981\u671f\u671b\u6bcf\u6b21\u90fd\u80fd\u6210\u529f\u5730\u5b8c\u6210\u8fd9\u4e2a\u6740\u7403\u3002<\/p>\n<p>\u53ea\u8981\u4f60\u9884\u8ba1\u5230\u5bf9\u624b\u4f1a\u6253\u65cb\u8f6c\u7f51\u7403\uff0c\u4e0d\u8bba\u7403\u662f\u4e0d\u662f\u7d27\u8d34\u7740\u7f51\u6746\uff0c\u90fd\u5411\u524d\u8dc3\u8fdb\u8fdb\u884c\u6740\u7403\u3002<\/p>\n<p>\u8fd9\u662f\u5f88\u9ad8\u98ce\u9669\u7684\u3002\u4f46\u662f\u5982\u679c\u6740\u7403\u6210\u529f\uff0c\u4f60\u7684\u58eb\u6c14\u80af\u5b9a\u4f1a\u63d0\u9ad8\u3002<\/p>\n<p>\u5373\u4f7f\u4f60\u6ca1\u80fd\u628a\u7403\u6253\u8fc7\u7f51\u6746\uff0c\u7f51\u524d\u6740\u7403\u4e5f\u4f1a\u5728\u67d0\u79cd\u7a0b\u5ea6\u4e0a\u5f71\u54cd\u4f60\u7684\u5bf9\u624b\u5fc3\u7406\u3002 <em>\u7cbe\u795e\u529b\u91cf<\/em>.<\/p>\n<p>\u4e0d\u8fc7\uff0c\u8981\u6ce8\u610f\u4f60\u627f\u62c5\u7684\u98ce\u9669\u5f88\u9ad8\u3002\u4e0d\u8981\u671f\u671b\u6740\u7403\u603b\u662f\u6210\u529f\u7684\u3002<\/p>\n<p>\u53e6\u4e00\u4e2a\u5192\u9669\u5c1d\u8bd5\u662f\u8fdb\u884c\u6709\u529b\u7684\u6263\u6740\uff0c\u4e0d\u7ba1\u4f60\u6709\u6ca1\u6709\u597d\u7684\u5e73\u8861\u3002<\/p>\n<p>\u72e0\u72e0\u5730\u51fb\u6253\u7fbd\u6bdb\u7403\uff0c\u8ba9\u5bf9\u624b\u89c9\u5f97.<\/p>\n<p><a class=\"rethm\" href=\"\/zh\/badminton-articles.html\/\">\u8fd4\u56de\u81ea <strong>\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66<\/strong> \u5230 <strong>\u7fbd\u6bdb\u7403\u7528\u54c1<\/strong><\/a><\/p>\n<p style=\"text-align: center;\">\n<div class=\"fb-like\" data-href=\"https:\/\/www.facebook.com\/HowToPlayBadminton\" data-send=\"true\" data-width=\"100%\" data-show-faces=\"false\">\n<div id=\"COMMENTING\" class=\"fb-comment remove-comment\">\n<h3><span class=\"teelmeww\">\u544a\u8bc9\u6211\u4f60\u7684\u60f3\u6cd5\uff01<\/span><\/h3>\n<p>\u4f60\u5bf9\u521a\u521a\u8bfb\u5230\u7684\u5185\u5bb9\u6709\u4f55\u770b\u6cd5\uff1f\u5728\u4e0b\u9762\u7ed9\u6211\u7559\u8a00\u3002<\/p>\n<div class=\"fb-comments\" data-href=\"http:\/\/www.how-to-play-badminton.com\/badminton-psychology.html\" data-num-posts=\"15\" data-width=\"100%\"><\/div>\n<p>&gt;<\/p>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","protected":false},"excerpt":{"rendered":"<p>\u4e86\u89e3\u7fbd\u6bdb\u7403\u5fc3\u7406\u5b66\u5bf9\u4e8e\u8d62\u5f97\u6bd4\u8d5b\u5f88\u91cd\u8981\u3002\u786e\u5b9a\u771f\u6b63\u7684\u8d62\u5bb6\u8d85\u8d8a\u4e86\u6280\u80fd\u3002<\/p>","protected":false},"author":1,"featured_media":0,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"footnotes":""},"categories":[16],"tags":[],"class_list":["post-63","post","type-post","status-publish","format-standard","hentry","category-badminton-articles"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v25.6 - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<titl