4d\u7f6e\u624d\u80fd\u6253\u51fa\u6709\u529b\u7684\u6263\u7403\u3002\u4ed6\u5fc5\u987b\u7ad9\u5728\u7403\u7684\u540e\u9762\uff0c\u8fd9\u6837\u7403\u5458\u624d\u80fd\u901a\u8fc7\u81ea\u7136\u6325\u6746\u5c06\u7403\u5411\u4e0b\u5f15\u5bfc\uff0c\u4ece\u800c\u901a\u8fc7\u8df3\u8dc3\u6263\u7403\u5c06\u7403\u5411\u4e0b\u5f15\u5bfc\uff08\u89c1\u4e0a\u56fe\uff09\u3002 <\/p>\n<p>\u56e0\u6b64\uff0c\u5fc5\u987b\u8eb2\u5728\u7403\u7684\u540e\u9762\u624d\u80fd\u6253\u51fa\u6709\u529b\u800c\u6709\u6548\u7684\u6263\u7403\u3002 <\/p>\n<h3>\u5982\u4f55\u9884\u6d4b\u7c89\u788e<\/h3>\n<p>\u5728\u7537\u5b50\u5355\u6253\u6bd4\u8d5b\u4e2d\uff0c\u5f53\u4f60\u51fa\u73b0\u4ee5\u4e0b\u60c5\u51b5\u65f6\uff0c\u4f60\u6700\u6709\u53ef\u80fd\u9884\u6d4b\u5230\u6263\u7403\u7684\u5230\u6765\uff1a<\/p>\n<ul>\n<li><em>\u4e3e\u8d77<\/em> \u6216\u8005 <em>\u6e05\u9664<\/em> \u7a7f\u68ad\uff08\u7ed9\u4f60\u7684\u5bf9\u624b\u4e00\u4e2a\u7c89\u788e\u7684\u597d\u673a\u4f1a\uff09<\/li>\n<p><\/p>\n<li>\u6ce8\u610f\u4f60\u7684\u5bf9\u624b\u662f\u5426 <strong>\u5728\u4ed6\u7684\u8fd0\u52a8\u4e2d\u6ce8\u5165\u6b65\u4f10<\/strong>.\u8fd9\u610f\u5473\u7740\u4f60\u7684\u5bf9\u624b\u79fb\u52a8\u5230\u7403\u7684\u901f\u5ea6\u975e\u5e38\u5feb\uff08\u6bd4\u4ed6\u5728\u6bd4\u8d5b\u4e2d\u7684\u6b63\u5e38\u901f\u5ea6\u66f4\u5feb\uff09\uff0c\u8fd9\u6837\u4ed6\u5c31\u53ef\u4ee5\u8eb2\u5728\u7403\u540e\u9762\u5e76\u51fb\u51fa\u6263\u7403\u3002<\/li>\n<\/ul>\n<h3>\u51c6\u5907\u597d\u634d\u536b<\/h3>\n<p>\u5f53\u53d1\u751f\u8fd9\u79cd\u60c5\u51b5\u65f6\uff0c\u79fb\u52a8\u5230\u4f60\u7684\u9632\u5fa1\u57fa\u5730\u3002\u91c7\u7528\u4e00\u4e2a <a href=\"\/zh\/badminton-stance.html\/#defensive\"> \u9632\u5fa1\u59ff\u6001<\/a>. <\/p>\n<p>\u7ad9\u5728\u9002\u5f53\u7684\u533a\u57df\u9632\u5b88\u6263\u7403\uff08\u89c1\u4e0a\u56fe\uff09\u3002\u5b83\u7a0d\u5fae\u843d\u540e\u4e8e\u7403\u573a\u7684\u6b63\u4e2d\u5fc3\u3002\u8fd9\u662f\u56e0\u4e3a\u4f60\u60f3\u7ed9\u81ea\u5df1\u4e00\u4e9b\u65f6\u95f4\u6765\u68c0\u6d4b\u822a\u5929\u98de\u673a\u7684\u98de\u884c\u65b9\u5411\u3002\u8fd9\u8ba9\u4f60\u6709\u65f6\u95f4\u505a\u51fa\u53cd\u5e94\u3002 <\/p>\n<p>\u786e\u4fdd\u4e0d\u8981\u7ad9\u5728\u4f60\u7684\u540e\u65b9\u6216\u524d\u65b9\u592a\u8fdc <em>\u9632\u5fa1\u57fa\u5730<\/em>. <\/p>\n<p>\u5982\u679c\u4f60\u7ad9\u5728\u524d\u9762\u592a\u8fdc\uff0c\u4f60\u5c06\u6ca1\u6709\u8db3\u591f\u7684\u65f6\u95f4\u770b\u5230\u7c89\u788e\u7684\u65b9\u5411\u3002 <\/p>\n<p>\u5982\u679c\u4f60\u7ad9\u5728\u8fdc\u5904\uff08<em>\u6211\u4eec\u79f0\u8fd9\u592a\u8fc7\u6df1\u5165\u4f60\u7684\u9632\u5fa1<\/em>)\uff0c\u5982\u679c\u4f60\u7684\u5bf9\u624b\u51b3\u5b9a\u4e0d\u51fb\u7403\uff0c\u4f60\u5c06\u65e0\u6cd5\u53d6\u56de\u7403 <a href=\"\/zh\/badminton-drop.html\/\">\u7fbd\u6bdb\u7403\u6295\u7bee<\/a>.<\/p>\n<h3>\u6700\u540e\u63d0\u793a<\/h3>\n<p>\u5728\u7fbd\u6bdb\u7403\u7537\u5b50\u5355\u6253\u6bd4\u8d5b\u4e2d\uff0c\u4e0e\u7537\u5b50\u53cc\u6253\u76f8\u6bd4\uff0c\u4f60\u9700\u8981\u8986\u76d6\u66f4\u5bbd\u7684\u6263\u7403\u89d2\u5ea6\u3002\u65e0\u6cd5\u5224\u65ad\u5bf9\u624b\u4f1a\u5411\u60a8\u7684\u8eab\u4f53\u3001\u6b63\u624b\u533a\u57df\u8fd8\u662f\u53cd\u624b\u533a\u57df\u6263\u7403\u3002 <\/p>\n<p>\u4f46\u662f\uff0c\u8bf7\u9075\u5faa\u6b63\u786e\u7684\u7fbd\u6bdb\u7403\u9632\u5b88\u6280\u672f\u3002\u5b83\u4f1a\u5e2e\u52a9\u60a8\u6709\u6548\u5730\u9632\u5fa1\u6263\u7403\uff0c\u65e0\u8bba\u6263\u7403\u662f\u53bb\u5f80\u60a8\u7684\u6b63\u624b\u8fd8\u662f\u53cd\u624b\u533a\u57df\u3002 <\/p>\n<p>\u5173\u952e\u662f\u51c6\u5907\u597d\u3002\u5f53\u4f60\u7684\u5bf9\u624b\u51fb\u4e2d\u6263\u7403\u65f6\u4fdd\u6301\u8b66\u60d5\u3002\u5982\u679c\u4f60\u63aa\u624b\u4e0d\u53ca\uff08\u5373\u6ca1\u6709\u7ad9\u5728\u4f60\u7684\u9632\u5b88\u57fa\u5730\u6216\u6ca1\u6709\u7ad9\u5728\u9632\u5b88\u59ff\u6001\uff09\uff0c\u4f60\u5c31\u4e0d\u592a\u53ef\u80fd\u6062\u590d\u6263\u7403\u3002\u5373\u4f7f\u4f60\u8bbe\u6cd5\u53d6\u56de\u4e86\u7a7f\u68ad\u673a\uff0c\u4e5f\u672a\u5fc5\u662f\u4e2a\u597d\u56de\u62a5\u3002 <br \/><a href=\"\/zh\/defend-badminton-smash.html\/\">\u5355\u51fb\u6b64\u5904\u83b7\u53d6\u6709\u5173\u5982\u4f55\u9632\u5fa1\u5bf9\u624b\u6263\u7403\u7684\u5206\u6b65\u6559\u7a0b<\/a><\/p>\n<h3>\u7ed3\u8bba<\/h3>\n<p>\u5f53\u60a8\u62ac\u8d77\u6216\u6e05\u9664\u7403\u5e76\u770b\u5230\u5bf9\u624b\u5728\u4ed6\u7684\u8fd0\u52a8\u4e2d\u6ce8\u5165\u6b65\u4f10\u65f6\uff0c\u671f\u5f85\u51fb\u7403\uff01<\/p>\n<p>\u4f46\u662f\uff0c\u60a8\u4e0d\u80fd 100% \u786e\u5b9a\u60a8\u7684\u5bf9\u624b\u662f\u5426\u4f1a\u6263\u6740\uff0c\u6216\u8fdb\u884c\u6295\u7bee\u3002\u6700\u597d\u7684\u529e\u6cd5\u662f\u505a\u597d\u51c6\u5907\u3002 <\/p>\n<p>\u638c\u63e1\u6b63\u786e\u7684\u7fbd\u6bdb\u7403\u9632\u5b88\u6280\u672f\uff0c\u60a8\u5c06\u80fd\u591f\u9632\u5b88\u6263\u7403\u6216\u540a\u7403\u3002<\/p><\/div>\n<p>\n\t <a href=\"\/zh\/how-do-we-read-our-opponents-shot-before-they-could-deliver-comment-form.html\/\" class=\"old-comments\">\u70b9\u51fb\u6b64\u5904\u53d1\u8868\u8bc4\u8bba<\/a>\n         <\/p>\n<p style=\"text-align:left;\">\n          <a href=\"\/zh\/badminton-techniques-questions.html\/#INV\" class=\"noplsin\"><br \/>\n              \u52a0\u5165\u5e76\u7f16\u5199\u81ea\u5df1\u7684\u7f51\u9875\uff01\u8fd9\u5f88\u5bb9\u6613\u505a\u5230\u3002\u5982\u4f55\uff1f\u53ea\u9700\u5355\u51fb\u6b64\u5904\u8fd4\u56de <b>\u5173\u4e8e\u6280\u5de7\u548c\u6295\u7bee\u7684\u95ee\u9898<\/b>.<\/a>\n          <\/p>\n<like href=\"index.html\" send=\"false\" width=\"450\" show_faces=\"false\"\/>\n<div align=\"left\">\n<like-box href=\"https:\/\/www.facebook.com\/pages\/How-To-Play-Badminton\/365607500122681\" width=\"400\" height=\"300\" show_faces=\"false\" stream=\"true\" header=\"true\"\/>\n<\/div><\/div><\/div>","protected":false},"excerpt":{"rendered":"<p>\u4f5c\u8005\uff1aFairuz\uff08\u9a6c\u6765\u897f\u4e9a\u5f6d\u4ea8\u5dde\u5173\u4e39\uff09\u95ee\uff1a\u5728\u5bf9\u624b\u53d1\u7403\u4e4b\u524d\uff0c\u6211\u4eec\u5982\u4f55\u89e3\u8bfb\u4ed6\u4eec\u7684\u51fb\u7403\uff1f\u6bd4\u5982\u5728\u7537\u5355\u6bd4\u8d5b\u4e2d\