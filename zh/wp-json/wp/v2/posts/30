{"id":30,"date":"2016-05-16T12:49:06","date_gmt":"2016-05-16T12:49:06","guid":{"rendered":"http:\/\/masterbadminton.dev\/how-to-play-the-badminton-backhand-smash\/"},"modified":"2016-10-10T07:22:50","modified_gmt":"2016-10-10T07:22:50","slug":"badminton-backhand-smash-html","status":"publish","type":"post","link":"https:\/\/masterbadminton.com\/zh\/badminton-backhand-smash.html","title":{"rendered":"\u5982\u4f55\u6253\u7fbd\u6bdb\u7403\u53cd\u624b\u8df3 smash"},"content":{"rendered":"<div id=\"ContentColumn\">\n<div class=\"Liner\">\n<div style=\"float: left; margin-right: 10px;\"><\/div>\n<p>&nbsp;<\/p>\n<table border=\"1\" width=\"400px\" cellspacing=\"0\" cellpadding=\"0\" align=\"center\">\n<tbody>\n<tr>\n<td bgcolor=\"#eb7d2e\" width=\"50%\" height=\"20px\"><span style=\"color: #fbfbef; font-family: Arial; font-size: small;\"><strong>\u7fbd\u6bdb\u7403\u53cd\u624b\u6263\u6740<\/strong><\/span><\/td>\n<\/tr>\n<tr>\n<td bgcolor=\"#ffffff\" width=\"50%\"><span style=\"color: #000000; font-family: Arial; font-size: small;\"><span style=\"color: #000000; font-family: Arial; font-size: small;\"><br \/>\n<\/span><\/span><\/p>\n<table border=\"0\">\n<tbody>\n<tr>\n<td><strong>\u7b49\u7ea7<\/strong><\/td>\n<td>\u9ad8\u7ea7<\/td>\n<\/tr>\n<tr>\n<td><strong>\u7c7b\u578b<\/strong><\/td>\n<td>\u653b\u51fb\u6027<\/td>\n<\/tr>\n<tr>\n<td><strong>\u5148\u51b3\u6761\u4ef6<\/strong><\/td>\n<td class=\"translation-block\">\u53cd\u624b\u6e05\u7403\u3001\u53cd\u624b\u6311\u7403<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p style=\"text-align: left;\"><span style=\"font-size: 19px; color: #ff0000;\"><b>\u4ecb\u7ecd<br \/>\n<\/b><\/span><\/p>\n<p>\u8fd9\u9879\u6280\u672f\u662f\u7fbd\u6bdb\u7403\u4e2d\u6700\u96be\u8868\u73b0\u7684\u53d1\u7403\u4e4b\u4e00\u3002<\/p>\n<p class=\"translation-block\">\u4ece\u5e95\u7ebf\u5230\u5e95\u7ebf\u7684\u53cd\u624b\u6e05\u7403\u9700\u8981\u5f88\u5927\u7684\u529b\u91cf\u3002\u7fbd\u6bdb\u7403\u53cd\u624b\u8df3\u6253\u9700\u8981\u66f4\u5927\u7684\u529b\u91cf\uff01<\/p>\n<p>\u7136\u800c\uff0c\u5982\u679c\u5b8c\u7f8e\u5730\u6267\u884c\uff0c\u8fd9\u4e2a\u7403\u4e00\u5b9a\u4f1a\u8ba9\u4f60\u7684\u5bf9\u624b\u611f\u5230\u60ca\u8bb6\uff0c\u5e76\u4f7f\u4ed6\u56de\u51fb\u4e00\u4e2a\u5f31\u7403\u3002<\/p>\n<p>\u5bf9\u4e8e\u6b63\u624b\u53d1\u7403\uff0c\u5f88\u5bb9\u6613\u770b\u51fa\u4e00\u540d\u7403\u5458\u8981\u53d1\u51fa\u4e00\u4e2a\u6263\u6740\u6216\u8df3\u6263\u3002\u4e0d\u50cf\u6b63\u624b\u53d1\u7403\uff0c\u5f88\u96be\u9884\u6599\u5230\u7403\u5458\u8981\u6253\u4ec0\u4e48\u7c7b\u578b\u7684\u53cd\u624b\u7403\uff08\u56e0\u4e3a\u53cd\u624b\u6325\u62cd\u9700\u8981\u7403\u5458\u80cc\u5411\u7403\u573a\uff0c\u8fdb\u884c\u9884\u52a0\u8f7d\uff09\u3002<\/p>\n<p>\u56e0\u6b64\uff0c\u5982\u679c\u4f60\u80fd\u591f\u6253\u51fa\u5f3a\u6709\u529b\u7684\u7fbd\u6bdb\u7403\u53cd\u624b\u8df3\u6253\uff0c\u4f60\u4e00\u5b9a\u4f1a\u8ba9\u4f60\u7684\u5bf9\u624b\u63aa\u624b\u4e0d\u53ca\uff01<\/p>\n<p class=\"translation-block\">\u70b9\u51fb\u6b64\u5904\u9605\u8bfb\u4f20\u5947\u53cd\u624b\u9009\u624bTaufik Hidayat\u7684\u4ecb\u7ecd\uff0c\u5e76\u89c2\u770bTaufik\u7684\u7cbe\u5f69\u53cd\u624b\u8df3\u6253\u89c6\u9891\u3002<\/p>\n<p><span style=\"font-size: 19px; color: #ff0000;\"><b>\u53cd\u624b\u8df3\u6253\u7684\u529b\u91cf<br \/>\n<\/b><\/span><\/p>\n<p>\u8fd9\u4e2a\u7403\u7684\u529b\u91cf\u6765\u81ea\u4e8e\uff1a<\/p>\n<ul>\n<li class=\"translation-block\">\u826f\u597d\u7684\u53cd\u624b\u6325\u62cd\u6280\u672f\uff1a\u4f60\u5fc5\u987b\u80fd\u591f\u8fdb\u884c\u826f\u597d\u7684\u7fbd\u6bdb\u7403\u53cd\u624b\u6325\u62cd\uff0c\u624d\u80fd\u5728\u53cd\u624b\u8df3\u6253\u4e2d\u53d1\u6325\u6700\u5927\u7684\u529b\u91cf\u3002\u826f\u597d\u7684\u6280\u672f\u80fd\u591f\u8ba9\u4f60\u53d1\u6325\u6700\u5927\u7684\u6325\u62cd\u5e45\u5ea6\uff0c\u4ece\u800c\u5728\u6325\u62cd\u4e2d\u4ea7\u751f\u5f88\u5927\u7684\u52a8\u91cf\u3002\u70b9\u51fb\u6b64\u5904\u5b66\u4e60\u6216\u590d\u4e60\u4f60\u7684\u57fa\u7840\u53cd\u624b\u6325\u62cd\u6280\u672f\u3002<\/li>\n<li class=\"translation-block\">\u5145\u5206\u53d1\u6325\u624b\u8155\u4f5c\u7528\uff1a\u5728\u7fbd\u6bdb\u7403\u4e2d\uff0c\u624b\u8155\u52a8\u4f5c\u80fd\u591f\u521b\u9020\u5f88\u5927\u7684\u529b\u91cf\u3002\u901a\u8fc7\u8fc5\u901f\u201c\u5f39\u52a8\u201d\u624b\u8155\uff0c\u6267\u884c\u5feb\u901f\u7684\u201c\u6296\u52a8\u201d\u52a8\u4f5c\uff0c\u4ea7\u751f\u66f4\u591a\u7684\u529b\u91cf\u3002<\/li>\n<li class=\"translation-block\">\u5982\u4f55\u63e1\u62cd\uff1a\u91c7\u7528\u7fbd\u6bdb\u7403\u53cd\u624b\u63e1\u62cd\u65b9\u5f0f\u3002\u4e0d\u8981\u63e1\u62cd\u8fc7\u7d27\u3002\u5982\u679c\u4f60\u63e1\u62cd\u8fc7\u7d27\uff0c\u4f60\u7684\u808c\u8089\u4f1a\u53d8\u5f97\u5f88\u7d27\u5f20\u3002\u5f53\u4f60\u7684\u624b\u81c2\u808c\u8089\u592a\u8fc7\u7d27\u5f20\u65f6\uff0c\u4f60\u7684\u624b\u8155\u6d3b\u52a8\u80fd\u529b\u4f1a\u53d7\u5230\u9650\u5236\uff0c\u4f60\u4f1a\u53d1\u73b0\u5f88\u96be\u5feb\u901f\u5730\u6296\u52a8\u624b\u8155\u3002\u4f60\u4e5f\u53ef\u4ee5\u5229\u7528\u624b\u6307\u52a8\u4f5c\uff08\u62c7\u6307\uff09\u6765\u5e2e\u52a9\u4f60\u4ea7\u751f\u66f4\u5f3a\u7684\u624b\u8155\u4f5c\u7528\u3002<\/li>\n<\/ul>\n<p><span style=\"font-size: 19px; color: #ff0000;\"><b>\u4f60\u5e94\u8be5\u6267\u884c\u8fd9\u4e2a\u7403\u5417\uff1f<br \/>\n<\/b><\/span><\/p>\n<p>\u5982\u679c\u4f60\u80fd\u591f\uff1a<\/p>\n<ul>\n<li>\u5feb\u901f\u79fb\u52a8\u5230\u7fbd\u6bdb\u7403\u53cd\u624b\u8df3\u6253\u7684\u4f4d\u7f6e\uff1b\u5e76\u4e14<\/li>\n<li class=\"translation-block\">\u5feb\u901f\u5207\u6362\u5230\u53cd\u624b\u63e1\u62cd\u3002<\/li>\n<\/ul>\n<p>\u7531\u4e8e\u7fbd\u6bdb\u7403\u53cd\u624b\u8df3\u6253\u9700\u8981\u5f88\u5927\u7684\u529b\u91cf\uff0c\u4f60\u9700\u8981\u66f4\u957f\u7684\u9884\u52a0\u8f7d\u65f6\u95f4\u6765\u4ea7\u751f\u8df3\u6253\u7684\u529b\u91cf\u3002\u4f60\u7684\u9884\u52a0\u8f7d\u65f6\u95f4\u8d8a\u957f\uff0c\u4f60\u80fd\u4ea7\u751f\u7684\u529b\u91cf\u5c31\u8d8a\u5927\u3002<\/p>\n<p class=\"translation-block\">\u5728\u9884\u52a0\u8f7d\u9636\u6bb5\uff0c\u5207\u6362\u5230\u53cd\u624b\u63e1\u62cd\u3002\u56e0\u6b64\uff0c\u4f60\u5fc5\u987b\u5feb\u901f\u5730\u5207\u6362\u5230\u53cd\u624b\u63e1\u62cd\uff0c\u4ee5\u4fbf\u7ed9\u81ea\u5df1\u66f4\u591a\u7684\u9884\u52a0\u8f7d\u65f6\u95f4\u3002<\/p>\n<p>\u9664\u975e\u4f60\u975e\u5e38\u786e\u5b9a\u4f60\u80fd\u591f\u901a\u8fc7\u8df3\u6253\u201c\u51fb\u6740\u201d\u5bf9\u624b\uff0c\u5426\u5219\u4e0d\u8981\u6267\u884c\u8fd9\u4e2a\u7403\u3002<\/p>\n<p>\u7531\u4e8e\u53cd\u624b\u6325\u62cd\u9700\u8981\u4f60\u9762\u5411\u7403\u573a\u540e\u65b9\uff08\u9762\u5411\u4f60\u7684\u53cd\u624b\u533a\u57df\uff09\uff0c\u4f60\u7684\u6b63\u624b\u533a\u57df\u4f1a\u53d8\u5f97\u975e\u5e38\u8106\u5f31\u3002<\/p>\n<p>\u8fd9\u610f\u5473\u7740\uff0c\u5982\u679c\u4f60\u7684\u5bf9\u624b\u63a5\u4f4f\u4e86\u4f60\u7684\u53cd\u624b\u8df3\u6253\uff0c\u5e76\u5c06\u7403\u6253\u56de\u4f60\u7684\u6b63\u624b\u533a\u57df\uff0c\u4f60\u53ef\u80fd\u4f1a\u6709\u9ebb\u70e6\u6765\u56de\u6551\u7403\uff01<\/p>\n<p class=\"translation-block\">\u6b64\u5916\uff0c\u4f60\u5728\u6267\u884c\u53cd\u624b\u6325\u62cd\u65f6\u4f1a\u5931\u53bb\u4e00\u5b9a\u7a0b\u5ea6\u7684\u8eab\u4f53\u5e73\u8861\u3002\u56e0\u6b64\uff0c\u5728\u56de\u5230\u539f\u6765\u7684\u4f4d\u7f6e\u4e4b\u524d\uff0c\u4f60\u9700\u8981\u66f4\u957f\u7684\u65f6\u95f4\u6765\u6062\u590d\/\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u3002<\/p>\n<p style=\"text-align: left;\"><span style=\"font-size: 19px; color: #ff0000;\"><b>\u6559\u7a0b<br \/>\n<\/b><\/span><\/p>\n<p><b>1. \u51c6\u5907\u9636\u6bb5<\/b><\/p>\n<p>\u5feb\u901f\u5207\u6362\u5230\u6b63\u624b\u63e1\u62cd\uff0c\u540c\u65f6\u8f6c\u5411\u540e\u573a\uff0c\u9762\u5411\u7403\u573a\u7684\u540e\u65b9\u3002<\/p>\n<p><b>2. \u9884\u8f7d\u9636\u6bb5<\/b><\/p>\n<p>\u5c06\u62cd\u81c2\u5c3d\u53ef\u80fd\u9760\u8fd1\u8eab\u4f53\uff0c\u4ee5\u6700\u5927\u5316\u4f60\u7684\u53cd\u624b\u6325\u62cd\u3002<\/p>\n<p>\u4fdd\u6301\u975e\u62cd\u81c2\u51c6\u5907\u597d\uff0c\u4ee5\u5e2e\u52a9\u4f60\u5728\u6325\u62cd\u65f6\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u3002<\/p>\n<p>\u8bb0\u4f4f\uff0c\u4f60\u80fd\u591f\u5feb\u901f\u5207\u6362\u5230\u53cd\u624b\u63e1\u62cd\uff0c\u5c31\u80fd\u591f\u83b7\u5f97\u66f4\u591a\u7684\u9884\u8f7d\u65f6\u95f4\uff08\u83b7\u5f97\u66f4\u591a\u7684\u529b\u91cf\uff09\u3002<\/p>\n<p><b>3. \u6267\u884c<\/b><\/p>\n<p>\u5c3d\u53ef\u80fd\u5728\u6700\u9ad8\u70b9\u63a5\u7403\u53ef\u4ee5\u4f7f\u7403\u7684\u5f27\u7ebf\u66f4\u9661\u5ced\uff0c\u843d\u70b9\u66f4\u597d\u3002<\/p>\n<p>\u5f00\u59cb\u8fdb\u884c\u53cd\u624b\u6325\u62cd\u52a8\u4f5c\u3002\u8bf7\u8bb0\u4f4f\uff0c\u6b63\u786e\u7684\u6325\u62cd\u52a8\u4f5c\u662f\u4ea7\u751f\u529b\u91cf\u7684\u5173\u952e\u3002<\/p>\n<p>\u4ece\u8fd9\u4e2a\u70b9\u5f00\u59cb\uff0c\u60a8\u7684\u6325\u62cd\u5e94\u8be5\u662f\u4e00\u4e2a\u5e73\u7a33\u5b8c\u6574\u7684\u52a8\u4f5c\uff0c\u76f4\u5230\u60a8\u51fb\u4e2d\u7fbd\u6bdb\u7403\u3002\u5728\u6325\u62cd\u8fc7\u7a0b\u4e2d\u4e0d\u8981\u534a\u9014\u505c\u987f\uff0c\u8fd9\u4f1a\u7834\u574f\u6325\u62cd\u7684\u52a8\u529b\u3002<\/p>\n<p>\u5f53\u60a8\u5373\u5c06\u63a5\u89e6\u5230\u7fbd\u6bdb\u7403\u65f6\uff0c\u8bf7\u7528\u624b\u8155\u6267\u884c\u5f3a\u6709\u529b\u7684\u62bd\u6253\u52a8\u4f5c\u3002\u7528\u624b\u8155\u8fc5\u901f\u201c\u5f39\u201d\u51fa\u7403\uff0c\u4ee5\u8fc5\u731b\u7684\u529b\u91cf\u51fb\u6253\u7403\u3002<\/p>\n<p>\u60a8\u7684\u624b\u8155\u52a8\u4f5c\u4ee5\u53ca\u53cd\u624b\u6325\u62cd\u52a8\u4f5c\u5171\u540c\u662f\u53d1\u529b\u53cd\u624b\u7684\u6e90\u6cc9\u3002<\/p>\n<p class=\"translation-block\">\u9664\u4e86\u624b\u8155\u52a8\u4f5c\u4e4b\u5916\uff0c\u624b\u6307\u63a7\u5236\uff08\u62c7\u6307\u548c\u98df\u6307\uff09\u5bf9\u4e8e\u66f4\u597d\u5730\u63a7\u5236\u7403\u62cd\u4e5f\u975e\u5e38\u91cd\u8981\u3002\u4f7f\u7528\u624b\u6307\uff08\u7279\u522b\u662f\u53cd\u624b\u7684\u62c7\u6307\uff09\uff0c\u53ef\u4ee5\u5e2e\u52a9\u66f4\u597d\u5730\u4ea7\u751f\u5f3a\u5927\u7684\u62bd\u6253\u52a8\u4f5c\u3002<\/p>\n<p>\u628a\u7fbd\u6bdb\u7403\u5f80\u4e0b\u65b9\u5411\u51fb\u6253\uff0c\u4ee5\u4fbf\u7403\u7ecf\u8fc7\u5bf9\u65b9\u573a\u5730\u65f6\u79bb\u7f51\u53ea\u6709\u4e00\u70b9\u70b9\u7684\u9ad8\u5ea6\u3002<\/p>\n<p>\u4e0d\u8981\u6293\u63e1\u7403\u62cd\u8fc7\u7d27\uff0c\u8fd9\u53ef\u4ee5\u4f7f\u624b\u8155\u52a8\u4f5c\u66f4\u52a0\u7075\u6d3b\uff0c\u4e5f\u6709\u52a9\u4e8e\u624b\u6307\u79fb\u52a8\u4ee5\u83b7\u5f97\u66f4\u597d\u7684\u63a7\u5236\u3002<\/p>\n<p>\u5373\u4f7f\u4f60\u6253\u5b8c\u4e86\u7fbd\u6bdb\u7403\uff0c\u4e5f\u8981\u7ee7\u7eed\u5b8c\u6210\u4f60\u7684\u53cd\u624b\u6325\u62cd\u52a8\u4f5c\uff0c\u505a\u597d\u540e\u6446\u3002<\/p>\n<p>\u5728\u4f60\u51fb\u6253\u7fbd\u6bdb\u7403\u540e\uff0c\u4f60\u5f88\u53ef\u80fd\u4f1a\u5931\u53bb\u8eab\u4f53\u5e73\u8861\uff0c\u5229\u7528\u4f60\u7684\u975e\u7403\u62cd\u624b\u81c2\u5e2e\u52a9\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u662f\u975e\u5e38\u91cd\u8981\u7684\u3002<\/p>\n<p>\u5728\u4f60\u7684\u53cd\u624b\u6325\u6746\u52a8\u4f5c\u5b8c\u6210\u540e\uff0c\u8fc5\u901f\u56de\u5230\u4f60\u7684\u57fa\u5730\u51c6\u5907\u4e0b\u4e00\u6b21\u51fb\u7403\u3002<\/p>\n<p style=\"text-align: left;\">\u00a0<span style=\"font-size: 19px; color: #ff0000;\"><b>\u91cd\u8981\u63d0\u793a\/\u5efa\u8bae<\/b><\/span><\/p>\n<ol>\n<li>\u9664\u975e\u4f60\u975e\u5e38\u786e\u5b9a\u53ef\u4ee5\u53d6\u5f97\u80dc\u5229\uff0c\u5426\u5219\u4e0d\u8981\u5c1d\u8bd5\u8fdb\u884c\u7fbd\u6bdb\u7403\u53cd\u624b\u653b\u51fb\u3002<\/li>\n<li>\u4e0d\u8981\u4e00\u76f4\u7ef7\u7d27\u808c\u8089\uff0c\u5426\u5219\u4f1a\u9650\u5236\u4f60\u7684\u6325\u62cd\u52a8\u4f5c\u548c\u624b\u8155\u529b\u91cf\u3002<\/li>\n<li class=\"translation-block\">\u5f53\u4f60\u521d\u5b66\u7fbd\u6bdb\u7403\u53cd\u624b\u653b\u51fb\u65f6\uff0c\u4e0d\u8981\u5728\u6325\u62cd\u65f6\u65bd\u52a0\u8fc7\u591a\u7684\u529b\u91cf\uff0c\u5426\u5219\u53ef\u80fd\u4f1a\u51fa\u73b0\u6280\u672f\u4e0a\u7684\u9519\u8bef\u3002\u6b63\u786e\u7684\u6280\u672f\u6bd4\u529b\u91cf\u66f4\u91cd\u8981\u3002\u4e00\u65e6\u638c\u63e1\u4e86\u6b63\u786e\u7684\u6280\u672f\uff0c\u9010\u6e10\u589e\u52a0\u529b\u91cf\u3002<\/li>\n<li>\u624b\u8155\u7684\u5feb\u901f\"