u653b\u6027\u51fb\u7403\u3002<\/li>\n<li>\u5b83\u5411\u4e0b\u98de\u5411\u5bf9\u624b\u7684\u4e00\u4fa7\u3002<\/li>\n<\/ul>\n<p style=\"text-align: center;\"><span style=\"font-size: 18.6px; color: #ff3300;\"><b>\u5206\u6b65\u6559\u7a0b<br \/>\n<\/b><\/span><\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" style=\"border: 1px solid #bab6b6;\" src=\"..\/wp-content\/uploads\/2016\/04\/drop-shot-animation.gif.pagespeed.ce.EvT4UUDX0r.gif\" width=\"200\" data-pin-media=\"http:\/\/www.how-to-play-badminton.com\/images\/drop-shot-animation.gif\" \/><\/div>\n<p style=\"text-align: left;\"><span style=\"color: #ff3300;\"><b>1. \u5c31\u4f4d\u5e76\u91c7\u7528\u6b63\u624b\u63e1\u62cd.<\/b><\/span><\/p>\n<p>\u5982\u679c\u60a8\u6253\u7b97\u53d1\u51fa\u6263\u6740\uff0c\u5e94\u8be5\u8fc5\u901f\u671d\u5411\u7fbd\u6bdb\u7403\u79fb\u52a8\u3002\u5728\u804c\u4e1a\u7fbd\u6bdb\u7403\u6bd4\u8d5b\u4e2d\uff0c\u6211\u4eec\u79f0\u4e4b\u4e3a\u201c\u52a0\u901f\u63a8\u8fdb\u201d\u3002<\/p>\n<p>\u7406\u60f3\u60c5\u51b5\u4e0b\uff0c\u60a8\u7684\u8eab\u4f53\u5e94\u8be5\u9762\u5411\u7403\u573a\u7684\u4e00\u4fa7\u3002\u60a8\u7684\u53cc\u811a\u4e5f\u5e94\u8be5\u671d\u5411\u4fa7\u9762\u3002<\/p>\n<p style=\"text-align: center;\"><span style=\"text-decoration: none;\"><b>\u6b63\u624b\u63e1\u62cd<\/b><\/span><\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/300xNxgrip-forehand.jpg.pagespeed.ic.q-qrUoaP65.jpg\" width=\"300\" data-pin-media=\"images\/grip-forehand.jpg\" \/><\/div>\n<p><span style=\"color: #ff3300;\"><strong>2\u3001\u7ad9\u7a33\u811a\u6b65\u3002<\/strong><\/span><br \/>\n\u5982\u679c\u60a8\u7ad9\u7acb\u4e0d\u7a33\uff0c\u60a8\u7684\u6263\u6740\u5c31\u4e0d\u4f1a\u5f88\u5f3a\uff0c\u56e0\u4e3a\u60a8\u7684\u8eab\u4f53\u4f1a\u5148\u4e13\u6ce8\u4e8e\u5e73\u8861\uff0c\u800c\u4e0d\u662f\u505a\u51fa\u5f3a\u6709\u529b\u7684\u6325\u62cd\u3002<\/p>\n<p><span style=\"color: #ff3300;\"><b>3. \u4e3e\u8d77\u7403\u62cd\u81c2\u548c\u975e\u7403\u62cd\u81c2\u3002<\/b><\/span><br \/>\n\u786e\u4fdd\u60a8\u5c06\u7403\u62cd\u81c2\u5c3d\u53ef\u80fd\u5411\u540e\u4f38\u5c55\u3002\u8fd9\u6709\u52a9\u4e8e\u786e\u4fdd\u60a8\u8fdb\u884c\u5b8c\u6574\u7684\u6325\u81c2\u52a8\u4f5c.<\/p>\n<p>\u540c\u65f6\uff0c\u4e3e\u8d77\u60a8\u7684\u975e\u7403\u62cd\u81c2\u4ee5\u5e73\u8861\u7403\u62cd\u81c2\u7684\u91cd\u91cf\u3002\u8fd9\u975e\u5e38\u91cd\u8981\uff0c\u53ef\u4ee5\u5e2e\u52a9\u60a8\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u3002<\/p>\n<p>\u73b0\u5728\uff0c\u60a8\u5df2\u7ecf\u51c6\u5907\u597d\u53d1\u51fa\u6263\u6740\u4e86\u3002\u8fd9\u5c31\u662f\u60a8\u5e94\u8be5\u7684\u7ad9\u59ff......<\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/300xNxsmash-ready-position.jpg.pagespeed.ic.Mny5uG4q6o.jpg\" width=\"300\" data-pin-media=\"images\/smash-ready-position.jpg\" \/><\/div>\n<p><b><span style=\"color: #ff3300;\">4. \u5c3d\u53ef\u80fd\u5728\u6700\u9ad8\u70b9\u63a5\u7403\u3002<\/span><br \/>\n<\/b><span style=\"font-weight: normal;\">\u8fd9\u4f1a\u4f7f\u60a8\u7684\u6263\u6740\u4ee5\u8f83\u9661\u5ced\u7684\u89d2\u5ea6\u98de\u5411\u5bf9\u624b\u3002<br \/>\n<\/span><\/p>\n<p><span style=\"color: #ff3300;\"><b>5. \u5168\u81c2\u6446\u52a8\u51fb\u7403\u3002<\/b><\/span><br \/>\n\u6df1\u5438\u4e00\u53e3\u6c14\u3002\u5c3d\u91cf\u4f38\u5c55\u4f60\u7684\u80f8\u90e8\u3002\u4f38\u51fa\u4f60\u7684\u975e\u7403\u62cd\u81c2.<\/p>\n<p>\u7136\u540e\u547c\u6c14\u65f6\u5411\u524d\u6325\u62cd\u3002\u540c\u65f6\u6536\u7f29\u8179\u808c\u3002\u5c06\u4f60\u7684\u7403\u62cd\u811a\u6d17\u5230\u524d\u9762\u3002<\/p>\n<table class=\"columns_block grid_block\" style=\"width: 100%;\" border=\"0\">\n<tbody>\n<tr>\n<td class=\"column_0\" style=\"width: 50%; vertical-align: top;\">\n<div class=\"ImageBlock ImageBlockCenter\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/262xNxsmash-swing-position.jpg.pagespeed.ic.uLKAaUdnrY.jpg\" width=\"258\" height=\"281\" data-pin-media=\"images\/smash-swing-position.jpg\" \/><\/div>\n<\/td>\n<td class=\"column_1\" style=\"width: 50%; vertical-align: top;\">\n<div class=\"ImageBlock ImageBlockCenter\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/240xNxsmash-follow-through.jpg.pagespeed.ic.DbOORP6ZUg.jpg\" width=\"215\" height=\"326\" data-pin-media=\"images\/smash-follow-through.jpg\" \/><\/div>\n<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><span style=\"color: #ff3300;\"><b>6. \u6301\u7eed\u6325\u62cd\u3002<\/b><\/span><br \/>\n\u5728\u4f60\u51fb\u6253\u7fbd\u6bdb\u7403\u4e4b\u540e\uff0c\u8981\u6301\u7eed\u6325\u62cd\u5e76\u5b8c\u6210\u52a8\u4f5c\u3002\u6325\u62cd\u540e\uff0c\u8eab\u4f53\u5e94\u8be5\u9762\u5411\u524d\u65b9\u3002\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u5e76\u505a\u597d\u6062\u590d\u51c6\u5907\u3002<\/p>\n<p><span style=\"font-size: 19px; color: #ff0000;\"><span style=\"color: #ff3300;\"><b>\u5e38\u89c1\u7684\u8bef\u89e3<\/b><\/span><br \/>\n<\/span><\/p>\n<p>\u6bcf\u4e2a\u4eba\u90fd\u53ef\u4ee5\u8fdb\u884c smash \u53d1\u7403\u3002\u5f88\u7b80\u5355...<\/p>\n<p>\u5411\u524d\u7528\u529b\u6325\u62cd\uff0c\u5c31\u53ef\u4ee5\u8fdb\u884c smash \u53d1\u7403\u4e86\uff01<\/p>\n<p>\u77e5\u9053\u5982\u4f55\u6263\u6740\u5e76\u4e0d\u610f\u5473\u7740\u4f60\u662f\u4e00\u540d\u804c\u4e1a\u9009\u624b\u3002\u4f7f\u7528\u6b63\u786e\u7684\u6280\u672f\u6765\u6263\u6740\u662f\u63d0\u9ad8\u4f60\u7684\u7fbd\u6bdb\u7403\u6c34\u5e73\u7684\u5173\u952e\u3002<\/p>\n<p>\u5f3a\u529b\u6263\u6740\u5e76\u4e0d\u80fd\u5e2e\u4f60\u8d62\u5f97\u6bd4\u5206\u3002\u4f46\u662f\u4f7f\u7528\u5de7\u5999\u7684\u65b9\u5f0f\u6263\u6740\u5374\u53ef\u4ee5\uff01<\/p>\n<p class=\"translation-block\">\u5728\u8fd9\u4e2a\u9875\u9762\u4e0a\uff0c\u4f60\u5c06\u5b66\u4e60\u5982\u4f55\u5de7\u5999\u5730\u548c\u6b63\u786e\u5730\u8fdb\u884c\u6263\u6740\u3002<\/p>\n<p><span style=\"color: #ff0000;\"><strong>\u91cd\u8981\u63d0\u793a\u548c\u5efa\u8bae<\/strong><\/span><\/p>\n<ul>\n<li class=\"translation-block\">\u5b8c\u5584\u4f60\u7684\u6b63\u624b\u8fc7\u5934\u62cd\u6253\uff1a\u4e3a\u4e86\u80fd\u591f\u4ea7\u751f\u9ad8\u8d28\u91cf\u7684\u6263\u6740\uff0c\u4f60\u9700\u8981\u5c06\u4f60\u7684\u6b63\u624b\u8fc7\u5934\u62cd\u6253\u505a\u5230\u5b8c\u7f8e\u3002<\/li>\n<li class=\"translation-block\">\u5b8c\u5584\u4f60\u7684\u6263\u6740\u6280\u672f\uff1a\u5f53\u8fdb\u884c\u7fbd\u6bdb\u7403\u6263\u6740\u65f6\uff0c\u826f\u597d\u7684\u6280\u672f\u975e\u5e38\u91cd\u8981\u3002<\/li>\n<\/ul>\n<p>\u5f53\u4f60\u5f00\u59cb\u8bad\u7ec3\u6263\u6740\u65f6\uff0c\u5c1d\u8bd5\u5148\u8fdb\u884c\u8f7b\u67d4\u7684\u6263\u6740\uff0c\u4ee5\u719f\u6089\u6b63\u786e\u7684\u6280\u672f\u3002<\/p>\n<p>\u4e00\u65e6\u4f60\u719f\u6089\u4e86\u8fd9\u9879\u6280\u672f\uff0c\u9010\u6e10\u589e\u52a0\u4f60\u6263\u7403\u7684\u529b\u91cf<br \/>\n\u968f\u7740\u65f6\u95f4\u7684\u63a8\u79fb\u3002<\/p>\n<p>\u975e\u5e38\u91cd\u8981\u7684\u662f\uff0c\u4e0d\u8981\u4e00\u5f00\u59cb\u5c31\u4f7f\u7528\u4f60\u7684\u5168\u90e8\u529b\u91cf\u3002\u4f60\u7684\u6ce8\u610f\u529b\u4f1a\u88ab\u5206\u6563\u5230\u8fdb\u884c\u5f3a\u70c8\u7684\u6325\u62cd\u548c\u5e73\u8861\u4e0a\uff0c\u800c\u4e0d\u662f\u6267\u884c\u6b63\u786e\u7684\u6280\u672f\u3002<\/p>\n<ul>\n<li class=\"translation-block\">\u653e\u677e\u4f60\u7684\u8eab\u4f53\u3002\u5982\u679c\u4f60\u7684\u8eab\u4f53\u8fc7\u4e8e\u7d27\u5f20\uff0c\u5c31\u65e0\u6cd5\u6b63\u786e\u5730\u638c\u63e1\u6280\u672f\u3002\u653e\u677e\u4f60\u7684\u808c\u8089\uff0c\u4e0d\u8981\u8fc7\u4e8e\u7d27\u63e1\u7403\u62cd\u3002<\/li>\n<li class=\"translation-block\">\u975e\u7403\u62cd\u624b\u81c2\uff1a\u6211\u53d1\u73b0\u8fd9\u662f\u5927\u591a\u6570\u4eba\u7ecf\u5e38\u72af\u7684\u9519\u8bef\u3002\u522b\u5fd8\u4e86\u7528\u4f60\u7684\u975e\u7403\u62cd\u624b\u81c2\u6765\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u3002\u4f60\u5e94\u8be5\u517b\u6210\u8fd9\u4e2a\u4e60\u60ef\uff01\u9664\u4e86\u5e73\