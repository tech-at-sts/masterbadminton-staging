373\u4f7f\u60a8\u662f\u521d\u5b66\u8005\uff0c\u5b66\u4e60\u57fa\u672c\u7684\u6263\u6740\u4e5f\u662f\u5fc5\u987b\u7684\u3002\u5f00\u59cb\u7528\u6263\u6740\u8d62\u5f97\u4e00\u4e9b\u5206\u6570\u3002\u6bcf\u4e2a\u4eba\u90fd\u53ef\u4ee5\u6263\u6740\u3002\u5c31\u50cf\u5c3d\u53ef\u80fd\u7528\u529b\u5730\u5411\u524d\u6325\u52a8\u7403\u62cd\u4e00\u6837\u7b80\u5355\u3002\u4f46\u662f\uff0c\u4e3a\u4e86\u50cf\u804c\u4e1a\u9009\u624b\u4e00\u6837\u6253\u7403\u5e76\u83b7\u80dc\uff0c\u60a8\u9700\u8981\u5b66\u4e60\u6b63\u786e\u7684\u6280\u672f...\u4e0d\u8981\u8d70\u6377\u5f84\uff01<\/p>\n<\/td>\n<\/tr>\n<tr>\n<td class=\"column_0\" style=\"width: 40.04%; vertical-align: top;\">\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/badminton-jump-smash-4.jpg\" width=\"150\" data-pin-media=\"images\/badminton-jump-smash-4.jpg\" \/><\/div>\n<\/td>\n<td class=\"column_1\" style=\"width: 59.96%; vertical-align: top;\"><a href=\"\/zh\/badminton-jump-smash.html\/\"><u><strong>\u7fbd\u6bdb\u7403\u8df3\u6263\u6740<\/strong><\/u><\/a><\/p>\n<p>\u60f3\u8981\u6263\u6740\u66f4\u5f3a\u6709\u529b\u3001\u66f4\u9661\u5ced\u7684\u89d2\u5ea6\u5417\uff1f\u5b66\u4e60\u8df3\u6263\u6740\u5427\uff01\u8fd9\u53ef\u80fd\u662f\u7fbd\u6bdb\u7403\u4e2d\u6700\u9177\u7684\u51fb\u7403\u65b9\u5f0f\u3002\u4e3a\u4e86\u53d1\u6325\u6700\u5927\u7684\u5a01\u529b\uff0c\u60a8\u5fc5\u987b\u5b66\u4e60\u6b63\u786e\u7684\u6280\u672f\uff01\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u8dc3\u5165\u7a7a\u4e2d\u7136\u540e\u5411\u524d\u6325\u52a8\u7403\u62cd\u8fd9\u4e48\u7b80\u5355\u3002<\/p>\n<p>\u521d\u5b66\u8005\u5e94\u5728\u5b66\u4e60\u8df3\u6263\u6740\u4e4b\u524d\u59cb\u7ec8\u5148\u5b66\u4e60\u57fa\u672c\u7684\u6263\u6740\u6280\u672f\u3002<\/p>\n<\/td>\n<\/tr>\n<tr>\n<td class=\"column_0\" style=\"width: 40.04%; vertical-align: top;\">\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/badminton-overhead-backhand-stroke-2.jpg\" width=\"150\" data-pin-media=\"images\/badminton-overhead-backhand-stroke-2.jpg\" \/><\/div>\n<\/td>\n<td class=\"column_1\" style=\"width: 59.96%; vertical-align: top;\"><a href=\"\/zh\/badminton-backhand-smash.html\/\"><u><strong>\u7fbd\u6bdb\u7403\u53cd\u624b\u6263\u6740<\/strong><\/u><\/a><\/p>\n<p>\u65b0\u624b\u8bf7\u52ff\u9760\u8fd1\u3002\u8fd9\u662f\u6700\u96be\u7684\u4e00\u79cd\u51fb\u7403\u65b9\u5f0f\u3002<\/p>\n<p>\u5982\u679c\u4f60\u662f\u9ad8\u7ea7\u73a9\u5bb6\uff0c\u6211\u4e0d\u5efa\u8bae\u4f60\u4ece\u5e95\u7ebf\u5f00\u59cb\u4f7f\u7528\u8fd9\u4e2a\u955c\u5934\u3002\u5373\u4f7f\u662f\u804c\u4e1a\u7403\u5458\u4e5f\u4e0d\u592a\u53ef\u80fd\u7528\u4ed6\u4eec\u7684\u53cd\u624b\u51fb\u7403<br \/>\n\u57fa\u7ebf\u3002\u4e00\u662f\u53d1\u7535\u96be\u3002\u5176\u6b21\uff0c\u5b83\u4f1a\u51cf\u6162\u60a8\u7684\u6062\u590d\u65f6\u95f4\u3002<\/p>\n<p>\u4f46\u662f\uff0c\u5b66\u4f1a\u4ece\u4e2d\u573a\u6253\u53cd\u624b\u6263\u6740\u4f1a\u8ba9\u60a8\u5728\u6bd4\u8d5b\u4e2d\u5360\u636e\u4f18\u52bf\u3002\u5982\u679c\u60a8\u7684\u5bf9\u624b\u5c06\u4e00\u4e2a\u5f31\u7684\u534a\u573a\u7403\u56de\u4f20\u5230\u60a8\u7684\u53cd\u624b\u533a\u57df\uff0c\u53cd\u624b\u6263\u6740\u53ef\u80fd\u4f1a\u8ba9\u60a8\u7684\u5bf9\u624b\u63aa\u624b\u4e0d\u53ca\u3002<\/p>\n<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p><span style=\"font-size: 18.6px; color: #ff3300;\"><b><br \/>\n\u7fbd\u6bdb\u7403\u6263\u6740\u7684\u76ee\u6807\u662f\u4ec0\u4e48\uff1f<\/b><\/span><\/p>\n<p>\u975e\u5e38\u7b80\u5355\u660e\u4e86\u2026\u2026<\/p>\n<ol>\n<li>\u7ed3\u675f\u56de\u5408\u5e76\u8d62\u5f97\u4e00\u5206\u3002<\/li>\n<li>\u8feb\u4f7f\u5bf9\u624b\u56de\u4f20\u5f31\u7403.<\/li>\n<\/ol>\n<p class=\"translation-block\">\u57fa\u672c\u7684\u7ecf\u9a8c\u6cd5\u5219\u662f\uff1a\u5982\u679c\u60a8\u8ba4\u4e3a\u53ef\u4ee5\u5b9e\u73b0\u4e0a\u8ff0\u4efb\u4f55\u4e00\u4e2a\u76ee\u6807\uff0c\u8bf7\u5c3d\u60c5\u6263\u6740\uff01<\/p>\n<p>\u5426\u5219\uff0c\u8bf7\u4e09\u601d\u800c\u540e\u884c\uff0c\u56e0\u4e3a\u6263\u6740\u53ef\u80fd\u4f1a\u8ba9\u60a8\u5931\u53bb\u4e00\u4e9b\u5b9d\u8d35\u7684\u56de\u5408\u5206\u3002<\/p>\n<p>\u867d\u7136\u6263\u6740\u975e\u5e38\u6709\u529b\uff0c\u4f46\u5b83\u4e5f\u6709\u4e00\u5b9a\u7684\u7f3a\u70b9\uff0c\u60a8\u9700\u8981\u4e86\u89e3\u5b83\u4eec\u3002<\/p>\n<p><b>\u6263\u6740\u7684\u7f3a\u70b9<\/b><\/p>\n<p>\u57fa\u672c\u4e0a\uff0c\u7fbd\u6bdb\u7403\u6263\u6740\u6709\u4e24\u4e2a\u7f3a\u70b9\uff1a<\/p>\n<ul>\n<li class=\"translation-block\">\u51cf\u6162\u4e86\u60a8\u7684\u811a\u6b65\u79fb\u52a8\uff1a\u6263\u6740\u9700\u8981\u60a8\u505a\u51fa\u5f3a\u6709\u529b\u7684\u5b8c\u6574\u6325\u62cd\u3002\u6325\u62cd\u7684\u529b\u91cf\u4f1a\u8ba9\u60a8\u5931\u53bb\u4e00\u4e9b\u8eab\u4f53\u5e73\u8861\u3002\u7136\u540e\u60a8\u5c06\u4e13\u6ce8\u4e8e\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\uff0c\u800c\u5931\u53bb\u8fd4\u56de\u57fa\u7840\u4f4d\u7f6e\u7684\u65f6\u95f4\u3002\u5982\u679c\u60a8\u7684\u5bf9\u624b\u63a5\u56de\u4e86\u60a8\u7684\u6263\u6740\uff0c\u90a3\u4e48\u60a8\u5c31\u5f88\u96be\u53ca\u65f6\u5230\u8fbe\u7fbd\u6bdb\u7403\u3002<\/li>\n<li><strong>\u4ece\u60a8\u7684\u57fa\u7ebf\u6267\u884c\u65f6\u6548\u679c\u8f83\u5dee\uff1a <\/strong>\u8fd9\u662f\u56e0\u4e3a\u6ca1\u6709\u8db3\u591f\u7684\u89d2\u5ea6\u6765\u4ea7\u751f\u9661\u5ced\u7684\u7c89\u788e\u3002\u7531\u4e8e\u7c89\u788e\u4f1a\u524a\u5f31\u4f60\u7684\u6b65\u6cd5\u5e76\u51cf\u6162\u4f60\u7684\u6062\u590d\u901f\u5ea6\uff0c\u56e0\u6b64\u57fa\u7ebf\u7c89\u788e\u53ef\u80fd\u4f1a\u7ed9\u4f60\u7684\u5bf9\u624b\u63d0\u4f9b\u53cd\u51fb\u4f60\u7684\u673a\u4f1a<br \/>\n\u7c89\u788e\u3002<\/li>\n<\/ul>\n<p style=\"text-align: left;\"><span style=\"font-size: 19.6px; color: #ff3300;\"><b>\u529f\u7387\u548c\u7cbe\u5ea6\u4e4b\u95f4\u7684\u6743\u8861<br \/>\n<\/b><\/span><\/p>\n<p class=\"translation-block\">\u5df4\u5fb7\u7c73\u987f\u7403\u62cd\u6253\u662f\u4e00\u79cd\u901a\u5e38\u7528\u4e8e\u8d62\u5f97\u5df4\u5fb7\u7c73\u987f\u7403\u8d5b\u7684\u7403\u62cd\u6253\u3002\u5b83\u662f\u6700\u5f3a\u5927\u7684\u5df4\u5fb7\u7c73\u987f\u7403\u62cd\u6253.<\/p>\n<p>\u4f60\u53ef\u4ee5\u9009\u62e9:<\/p>\n<ul>\n<li class=\"translation-block\">\u6253\u51fa\u5a01\u529b\u5f3a\u4f46\u51c6\u786e\u5ea6\u4f4e\u7684\u5df4\u5fb7\u7c73\u987f\u7403\u62cd\u6253; \u6216<\/li>\n<li class=\"translation-block\">\u6253\u51fa\u5a01\u529b\u8f83\u5c0f\u4f46\u51c6\u786e\u5ea6\u9ad8\u7684\u5df4\u5fb7\u7c73\u987f\u7403\u62cd\u6253\u3002<\/li>\n<\/ul>\n<p class=\"translation-block\">\u901a\u5e38\uff0c\u5982\u679c\u4f60\u9009\u62e9\u6253\u51fa\u5f3a\u6709\u529b\u7684\u653b\u51fb\uff0c\u4f60\u9700\u8981.<\/p>\n<p><strong>\u4e3a\u4ec0\u4e48\u5728\u529b\u91cf\u548c\u51c6\u786e\u6027\u4e4b\u95f4\u5b58\u5728\u6743\u8861\uff1f<\/strong><\/p>\n<p>\u5f53\u4f60\u5c1d\u8bd5\u4e3a\u4f60\u7684\u6263\u6740\u4ea7\u751f\u66f4\u591a\u7684\u529b\u91cf\u65f6\uff0c\u4f60\u7684\u6263\u6740\u4f1a\u53d8\u5f97\u4e0d\u90a3\u4e48\u51c6\u786e\u3002\u4f60\u53ef\u80fd\u65e0\u6cd5\u5c06\u7fbd\u6bdb\u7403\u6253\u5230\u4f60\u60f3\u8981\u7684\u4f4d\u7f6e\u3002<\/p>\n<p>\u4f60\u7684\u8eab\u5fc3\u4f1a\u96c6\u4e2d\u5728\u4e3a\u6263\u6740\u4ea7\u751f\u529b\u91cf\u4e0a\uff0c\u800c\u4e0d\u662f\u8bd5\u56fe\u5c06\u7fbd\u6bdb\u7403\u6253\u5230\u76ee\u6807\u4f4d\u7f6e\u3002<\/p>\n<p class=\"translation-block\">\u53e6\u4e00\u65b9\u9762\uff0c\u4f60\u53ef\u4ee5\u9009\u62e9\u5728\u51c6\u786e\u7684\u51fb\u7403\u4f4d\u7f6e\u4e0a\u727a\u7272\u529b\u91cf\u3002\u8fd9\u610f\u5473\u7740\u4f60\u653e\u5f03\u4e86\u4e00\u4e9b\u6216\u5927\u90e8\u5206\u7684\u6263\u6740\u529b\u91cf\uff0c\u5e76\u5c06\u4f60\u7684\u6263\u6740\u7784\u51c6\u7740\u843d\u5728\u4f60\u60f3\u8981\u7684\u4f4d\u7f6e\u3002<\/p>\n<p>\u4e0d\u9700\u8981\u5c06\u5f88\u591a\u529b\u91cf\u65bd\u52a0\u5230\u4f60\u7684\u6325\u62cd\u4e0a\uff0c\u4f60\u66f4\u6709\u53ef\u80fd\u6253\u51fa\u51c6\u786e\u7684\u6263\u6740.<\/p>\n<p><b>\u4f60\u5e94\u8be5\u9009\u62e9<span style=\"font-style: normal;\"> \u529b\u91cf<\/span> \u8d85\u8fc7 <span style=\"font-style: normal;\">\u51c6\u786e\u6027\uff1f<br \/>\n<\/span><\/b><\/p>\n<p class=\"translation-block\">\u5728\u7fbd\u6bdb\u7403\u5355\u6253\u6bd4\u8d5b\u4e2d\uff0c\u5e94\u8be5\u8ffd\u6c42\u51c6\u786e\u6027\uff01\u4f60\u7684\u5bf9\u624b\u9700\u8981\u5b88\u536b\u4e00\u4e2a\u8f83\u5927\u7684\u533a\u57df\u3002\u56e0\u6b64\uff0c\u5e94\u8be5\u5411\u7403\u573a\u7684\u8fb9\u7ebf\u65b9\u5411\u53d1\u529b\u3002\u5982\u679c\u4f60\u7684\u6263\u6740\u80fd\u591f\u843d\u5728\u8fb9\u7ebf\u4e0a\uff08\u6216\u9760\u8fd1\u8fb9\u7ebf\uff09\uff0c\u4f60\u7684\u5bf9\u624b\u4f1a\u5f88\u96be\u63a5\u5230\u8fd9\u4e2a\u7403\u3002<\/p>\n<p>\u5982\u679c\u4f60\u671d\u8fb9\u7ebf\u65b9\u5411\u53d1\u529b\u8fdb\u884c\u6263\u6740\uff0c\u6709\u5f88\u5927\u7684\u53ef\u80fd\u6027\u4f60\u7684\u7403\u4f1a\u98de\u51fa\u573a\u5916\u3002\u5168\u529b\u51fa\u51fb\u7684\u60c5\u51b5\u4e0b\uff0c\u6263\u6740\u7684\u51c6\u786e\u6027\u5c31\u4f1a\u76f8\u5bf9\u8f83\u5f31\u3002<\/p>\n<p class=\"translation-block\">\u5728\u7fbd\u6bdb\u7403\u53cc\u6253\u6bd4\u8d5b\u4e2d\uff0c\u5e94\u8be5\u8ffd\u6c42\u529b\u91cf\uff01\u6bcf\u8fb9\u573a\u5730\u6709\u4e24\u540d\u7403\u5458\uff0c\u6bcf\u4e2a\u7403\u5458\u9700\u8981\u5b88\u536b\u534a\u4e2a\u573a\u5730\u3002\u56e0\u6b64\uff0c\u6bcf\u4e2a\u7403\u5458\u9700\u8981\u5b88\u536b\u7684\u533a\u57df\u76f8\u5bf9\u8f83\u5c0f\u3002\u63a5\u5230\u671d\u8fb9\u7ebf\u65b9\u5411\u7684\u6263\u6740\u5e76\u4e0d\u50cf\u5355\u6253\u6bd4\u8d5b\u90a3\u6837\u56f0\u96be\u3002<\/p>\n<p>\u5982\u679c\u4f60\u8bd5\u56fe\u671d\u8fb9\u7ebf\u65b9\u5411\u53d1\u51fa\u529b\u91cf\u8f83\u5c0f\u4f46\u51c6\u786e\u7684\u6263\u6740\uff0c\u4f60\u7684\u5bf9\u624b\u5c31\u4e0d\u9700\u8981\u79fb\u52a8\u5f88\u8fdc\u5c31\u53ef\u4ee5\u63a5\u5230\u8fd9\u4e2a\u7403\u3002\u8fd9\u4f1a\u4f7f\u4f60\u7684\u6263\u6740\u6548\u679c\u53d8\u5dee\u3002<\/p>\n<p>\u5728\u53cc\u6253\u6bd4\u8d5b\u4e2d\uff0c\u671d\u7403\u573a\u5185\u90e8\u533a\u57df\u53d1\u51fa\u6709\u529b\u7684\u6263\u6740\u66f4\u52a0\u6709\u6548.<\/p>\n<p>\u53cc\u6253\u6bd4\u8d5b\u7684\u83b7\u80dc\u7b56\u7565\u662f\u901a\u8fc7\