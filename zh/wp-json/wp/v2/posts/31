u60a8\u8fdb\u884c\u5b8c\u6574\u7684\u53cd\u624b\u51fb\u7403\u4ee5\u4ea7\u751f\u5f3a\u529b\u53cd\u624b\u51fb\u7403\u7684\u529b\u91cf\u3002<\/li>\n<\/ul>\n<p>\u7fbd\u6bdb\u7403\u7684\u53cd\u624b\u6325\u6746\u6a21\u5f0f\u4e0e\u7f51\u7403\/\u58c1\u7403\u6709\u5f88\u5927\u4e0d\u540c\u3002<\/p>\n<ul>\n<li><strong>\u58c1\u7403\/\u7f51\u7403\uff1a <\/strong> \u53cd\u624b\u51fb\u7403\u7684\u65b9\u5f0f\u662f\u4ece\u8eab\u4f53\u7684\u4fa7\u9762\u51fb\u6253\u7f51\u7403\u3002<\/li>\n<li><strong>\u7fbd\u6bdb\u7403\uff1a <\/strong> \u6b63\u786e\u7684\u53cd\u624b\u51fb\u7403\u6280\u672f\u53ef\u4ee5\u8ba9\u4f60\u5728\u534a\u7a7a\u4e2d\u65f6\u5728\u53cd\u624b\u533a\u57df\u51fb\u7403\uff08<em>\u5728\u4f60\u7684\u5934\u4e0a<\/em>).\u56e0\u6b64\uff0c\u7fbd\u6bdb\u7403\u7684\u6325\u6746\u6a21\u5f0f\u662f\u975e\u5e38\u4e0d\u540c\u7684\u3002\u53ea\u6709\u4f7f\u7528\u6b63\u786e\u7684\u6280\u672f\uff0c\u60a8\u624d\u80fd\u4ea7\u751f\u5f3a\u5927\u7684\u529b\u91cf\u5e76\u6253\u51fa\u9ad8\u8d28\u91cf\u7684\u53cd\u624b\u51fb\u7403\u3002\n<p>\u4e0b\u9762\u7684\u6559\u7a0b\u5411\u60a8\u5c55\u793a\u4e86\u7fbd\u6bdb\u7403\u53cd\u624b\u51fb\u7403\u7684\u6b63\u786e\u6280\u5de7\u3002<\/li>\n<\/ul>\n<p><span style=\"font-size: 19px; color: #ff0000;\"><b>\u6559\u7a0b<br \/>\n<\/b><\/span><\/p>\n<p><b>\u8981\u77e5\u9053\u7684\u4e8b\u60c5<br \/>\n<\/b><\/p>\n<ul>\n<li><strong>\u53cd\u624b\u63e1\u62cd\uff1a <\/strong> \u4e3a\u4e86\u6253\u51fa\u597d\u7684\u7fbd\u6bdb\u7403\u53cd\u624b\u51fb\u7403\uff0c\u4f7f\u7528 <a href=\"\/zh\/badminton-gripping-technique.html\/#backhand\">\u53cd\u624b\u63e1\u62cd<\/a>.<\/li>\n<li><strong>\u624b\u8155\u52a8\u4f5c\uff1a <\/strong> \u7fbd\u6bdb\u7403\u8fd0\u52a8\u4e2d\u7684\u624b\u8155\u52a8\u4f5c\u4e3a\u60a8\u7684\u51fb\u7403\u8d21\u732e\u4e86\u5f88\u591a\u529b\u91cf\u3002\u7ec3\u4e60\u7529\u8155\u53d1\u529b\u7684\u6b63\u786e\u65b9\u6cd5\u3002<\/li>\n<\/ul>\n<p>\u4e0d\u8981\u628a\u7403\u62cd\u63e1\u5f97\u592a\u7d27\uff0c\u4e5f\u4e0d\u8981\u7d27\u5f20\u4f60\u7684\u624b\u81c2\u808c\u8089\u3002\u5f53\u4f60\u7684\u808c\u8089\u592a\u7d27\u5f20\u65f6\uff0c\u4f60\u7684\u624b\u8155\u5c31\u4e0d\u4f1a\u7075\u6d3b\u5730\u5feb\u901f\u5f39\u52a8\u3002<\/p>\n<p><b>1.\u51c6\u5907\u548c\u7784\u51c6\u9636\u6bb5<\/b><\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-1-3.jpg\" width=\"201\" data-pin-media=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-1-3.jpg\" \/><\/div>\n<p style=\"text-align: center;\">\u91c7\u7528\u53cd\u624b\u63e1\u62cd\u3002<\/p>\n<p>\u5728\u60a8\u7684\u521d\u59cb\u4f4d\u7f6e\uff0c\u60a8\u5c06\u9762\u5411\u7403\u573a\u524d\u65b9\u3002\u4ece\u90a3\u91cc\u5f00\u59cb\uff0c\u6162\u6162\u5c06\u8eab\u4f53\u8f6c\u5411\u540e\u65b9\uff08<em>\u89c1\u4e0a\u56fe<\/em>).\u4e3a\u53cd\u624b\u5b9a\u4f4d\u81ea\u5df1\u3002<\/p>\n<p>\u8eab\u4f53\u5411\u540e\u8f6c\u7684\u540c\u65f6\uff0c\u5c06\u7403\u62cd\u62ac\u9ad8\u81f3\u4e0e\u4e0a\u56fe\u76f8\u4f3c\u7684\u4f4d\u7f6e\u3002<\/p>\n<p><b>2. \u9884\u88c5\u8f7d\u9636\u6bb5\uff08\u79ef\u7d2f\u529b\u91cf\u7684\u9636\u6bb5\uff09<\/b><\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-2-3.jpg\" width=\"200\" data-pin-media=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-2-3.jpg\" \/><\/div>\n<p>\u8ba9\u4f60\u7684\u7403\u62cd\u81c2\u5c3d\u53ef\u80fd\u9760\u8fd1\u4f60\u7684\u8eab\u4f53\uff08<em>\u89c1\u4e0a\u56fe<\/em>).\u8fd9\u662f\u4e3a\u4e86\u786e\u4fdd\u53ef\u4ee5\u6267\u884c\u5b8c\u6574\u7684\u53cd\u624b\u6325\u6746\u52a8\u4f5c\u3002<\/p>\n<p>\u8bb0\u4f4f\u4e0d\u8981\u628a\u7403\u62cd\u63e1\u5f97\u592a\u7d27\u3002\u5c06\u7403\u62cd\u63e1\u5f97\u592a\u7d27\u4f1a\u9650\u5236\u624b\u8155\u7684\u8fd0\u52a8\u3002<\/p>\n<p><b>3. \u6267\u884c<\/b><\/p>\n<p>\u6b63\u8981\u6253\u53cd\u624b\u65f6\uff0c\u8eab\u4f53\u5e94\u8be5\u5df2\u7ecf\u9762\u5411\u7403\u573a\u540e\u65b9\u3002<\/p>\n<p><em>\u8bf7\u6ce8\u610f\uff0c\u6267\u884c\u9636\u6bb5\u5e94\u8be5\u662f 1 \u4e2a\u5e73\u7a33\u7684\u6446\u52a8\u52a8\u4f5c\u3002<\/em><\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-3-3.jpg\" width=\"200\" data-pin-media=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-3-3.jpg\" \/><\/div>\n<p>\u8fd9\u90e8\u5206\u5f88\u91cd\u8981\u3002\u5c06\u4f60\u7684\u62cd\u81c2\u4e3e\u5230\u4e0e\u4e0a\u56fe\u76f8\u4f3c\u7684\u4f4d\u7f6e\uff0c\u4f46\u4e0d\u8981\u505c\u5728\u8fd9\u4e2a\u4f4d\u7f6e\uff0c\u5b83\u5e94\u8be5\u5e73\u7a33\u5feb\u901f\u5730\u6325\u52a8\uff0c\u76f4\u5230\u4f60\u51fb\u4e2d\u7403\u3002<\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-4-3.jpg\" width=\"200\" data-pin-media=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-4-3.jpg\" \/><\/div>\n<p>\u5373\u4f7f\u51fb\u4e2d\u7403\u540e\uff0c\u60a8\u4ecd\u7136\u5fc5\u987b\u5b8c\u6210\u6325\u6746\u52a8\u4f5c\u3002\u7528\u4f60\u7684\u7403\u62cd\u8ddf\u8fdb\u3002\u8ddf\u8fdb\u6709\u52a9\u4e8e\u63d0\u9ad8\u51c6\u786e\u6027\u3002\u4e0e\u5176\u8bf4\u662f\u529b\u91cf\uff0c\u529b\u91cf\u6765\u81ea\u4e8e\u9884\u52a0\u8f7d\u9636\u6bb5\u548c\u624b\u8155\u7684\u8f7b\u5f39\u3002<\/p>\n<p>\u56e0\u6b64\uff0c\u5728\u60a8\u5b8c\u6210\u6325\u6746\u52a8\u4f5c\u65f6\uff0c\u65e0\u9700\u589e\u52a0\u66f4\u591a\u529b\u91cf\uff0c\u5426\u5219\u60a8\u4f1a\u5931\u53bb\u5e73\u8861\u3002<\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-6-3.jpg\" width=\"200\" data-pin-media=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/badminton-overhead-backhand-stroke-6-3.jpg\" \/><\/div>\n<p style=\"text-align: center;\">\u4e0a\u56fe\u663e\u793a\u4e86\u4f60\u5e94\u8be5\u5728\u7684\u4f4d\u7f6e\uff08\u5728\u4f60\u5b8c\u6210\u53cd\u624b\u6325\u6746\u4e4b\u540e\uff09\u3002<\/p>\n<p><span style=\"font-size: 19px; color: #ff0000;\"><b>\u91cd\u8981\u63d0\u793a\/\u5efa\u8bae<br \/>\n<\/b><\/span><\/p>\n<ol>\n<li>\u7fbd\u6bdb\u7403\u53cd\u624b\u51fb\u7403\u4e0d\u662f\u7f51\u7403\u53cd\u624b\u51fb\u7403\u3002<\/li>\n<li>\u624b\u8155\u7684\u8f7b\u5f39\u4f1a\u4ea7\u751f\u5f3a\u5927\u7684\u62cd\u51fb\u52a8\u4f5c\u3002\u4e0d\u8981\u628a\u7403\u62cd\u63e1\u5f97\u592a\u7d27\uff0c\u4e5f\u4e0d\u8981\u62c9\u7d27\u624b\u81c2\u808c\u8089\uff0c\u8fd9\u6837\u624b\u8155\u5c31\u53ef\u4ee5\u7075\u6d3b\u5730\u5feb\u901f\u6325\u62cd\u3002<\/li>\n<li>\u53cd\u624b\u6325\u6746\u5e94\u8be5\u662f 1 \u5e73\u7a33\u5feb\u901f\u7684\u52a8\u4f5c\uff0c\u76f4\u5230\u4f60\u7684\u7403\u62cd\u4e00\u76f4\u5230\u8fbe\u524d\u9762\u3002\u7136\u800c\uff0c\u901a\u8fc7\u4f60\u7684\u5feb\u901f\u62cd\u51fb\u52a8\u4f5c\u5c06\u6325\u6746\u4e2d\u7684\u6240\u6709\u529b\u91cf\u8f6c\u79fb\u5230\u4f60\u7684\u7403\u62cd\u4e0a<br \/>\n\u624b\u8155\u3002<\/li>\n<\/ol>\n<p>&nbsp;<\/p>\n<p><a class=\"rethm\" href=\"\/zh\/badminton-strokes.html\/\">\u8fd4\u56de\u81ea <strong>\u7fbd\u6bdb\u7403\u53cd\u624b\u51fb\u7403<\/strong> \u5230 <strong>\u7fbd\u6bdb\u7403\u51fb\u7403<\/strong><\/a><\/p>\n<p>&nbsp;<\/p>\n<p style=\"text-align: center;\"><span class=\"redtagtitlelfb\"><b style=\"display: none;\">\u8bf7\u5728 Facebook \u4e0a\u4e3a\u6211\u70b9\u8d5e\u3002\u8c22\u8c22\uff01<\/b><\/span><\/p>\n<div class=\"fb-like\" data-href=\"https:\/\/www.facebook.com\/HowToPlayBadminton\" data-send=\"true\" data-width=\"100%\" data-show-faces=\"false\">\n<div id=\"COMMENTING\" class=\