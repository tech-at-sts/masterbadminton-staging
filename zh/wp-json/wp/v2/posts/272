c\u9a6c\u6765\u897f\u4e9a\u516c\u5f00\u8d5b\u8d44\u683c\u8d5b\u671f\u95f4\u4e3b\u8981\u6bd4\u8d5b\u7684\u7cbe\u5f69\u7247\u6bb5\u3002<\/p>\n<h2>\u4e3b\u8981\u6bd4\u8d5b\u4eae\u70b9<\/h2>\n<h3>Mohd Zakry Abdul Latif\/Mohd Fairuzizuan Mohd Tazri (MAS) v \u6881\u745e\u4f1f\/\u5ed6\u5bbd\u6d69 (TPE)<\/h3>\n<p class=\"Thumbnail\"><img decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/mohd-and-mohd.jpg\" alt=\"Zakry Abdul Latif Fairuzizuan Mohd Tazri\" width=\"394.4\" height=\"247.6\" \/><\/p>\n<p>\u9a6c\u6765\u897f\u4e9a\u961f\u5f00\u5c40\u5f3a\u52b2\uff0c\u8f7b\u677e\u5b8c\u6210\u7b2c\u4e00\u5c40\u6bd4\u8d5b\u3002<\/p>\n<p>\u7b2c\u4e8c\u5c40\u6bd4\u8d5b\u7684\u7ade\u4e89\u66f4\u52a0\u6fc0\u70c8\u3002\u4e2d\u56fd\u7ec4\u5408\u9009\u62e9\u4e86\u66f4\u591a\u7684\u8fdb\u653b\uff0c\u5e76\u5728\u67d0\u4e9b\u60c5\u51b5\u4e0b\u6210\u529f\u7a81\u7834\u4e86\u9a6c\u6765\u897f\u4e9a\u961f\u7684\u9632\u5b88\u3002<\/p>\n<p>\u7b2c\u4e8c\u5c40\u6bd4\u5206\u5dee\u8ddd\u66f4\u52a0\u7f29\u5c0f\u3002\u4e8b\u5b9e\u4e0a\uff0c\u4e2d\u56fd\u7ec4\u5408\u5728\u7b2c\u4e8c\u5c40\u4e2d\u53d6\u5f97\u4e86\u5e73\u5206\u3002<\/p>\n<p>\u5f88\u660e\u663e\uff0c\u7b2c\u4e8c\u573a\u6bd4\u8d5b\u4ed6\u4eec\u7684\u8868\u73b0\u8981\u597d\u5f97\u591a\u3002\u4e5f\u8bb8\u4ed6\u4eec\u624d\u521a\u521a\u5f00\u59cb\u9002\u5e94\u56fd\u5916\u7684\u73af\u5883\u3002\u4f46\u6211\u4e0d\u5f97\u4e0d\u8bf4\uff0c\u4ed6\u4eec\u7684\u4fe1\u5fc3\u4f3c\u4e4e\u5e76\u4e0d\u9ad8\u3002<\/p>\n<p>\u4e0d\u5e78\u7684\u662f\uff0c\u5bf9\u4e8e Jui \u548c Kuan \u6765\u8bf4\uff0c\u4ed6\u4eec\u9002\u5e94\u5f97\u4e0d\u591f\u5feb\u3002\u9a6c\u6765\u897f\u4e9a\u961f\u57282012\u5e74\u9a6c\u6765\u897f\u4e9a\u7fbd\u6bdb\u7403\u516c\u5f00\u8d5b\u9884\u9009\u8d5b\u4e2d\u53d6\u5f97\u80dc\u5229\uff0c\u7b2c\u4e8c\u5929\u60a8\u5c06\u5728\u7b2c\u4e00\u8f6e\u6bd4\u8d5b\u4e2d\u89c1\u5230\u4ed6\u4eec\u3002<\/p>\n<p>\u4ee4\u4eba\u60ca\u8bb6\u7684\u662f\u5728\u6d3b\u52a8\u671f\u95f4\u770b\u5230\u4e86\u4e00\u5927\u7fa4\u4eba <em>\u8d44\u683c\u8d5b<\/em>\u3002\u5927\u591a\u6570\u4eba\u7fa4\u662f\u9a6c\u6765\u897f\u4e9a\u4eba\uff0c\u4ed6\u4eec\u5728\u90a3\u91cc\u4e3a\u81ea\u5df1\u56fd\u5bb6\u7684\u7403\u5458\u52a0\u6cb9\u3002<\/p>\n<h3>\u9ec4\u7efc\u7ff0 (MAS) v Mohd Arif Abdul Latif (MAS)<\/h3>\n<p class=\"Thumbnail\"><img decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/wong-choong-hann.jpg\" alt=\"wong choong hann\" width=\"425.6\" height=\"260\" \/><\/p>\n<p>\u9ec4\u7efc\u7ff0\u662f\u4eca\u5929\u8d44\u683c\u8d5b\u7684\u660e\u661f\u3002<\/p>\n<p>\u8fd9\u4f4d\u524d\u7fbd\u6bdb\u7403\u4e16\u754c\u7b2c\u4e00\u73b0\u5728\u5c06\u7fbd\u6bdb\u7403\u4f5c\u4e3a\u4e1a\u4f59\u804c\u4e1a\u3002<\/p>\n<p>\u7531\u4e8e\u4ed6\u5728\u7fbd\u575b\u7684\u4e16\u754c\u6392\u540d\u76f8\u5bf9\u8f83\u4f4e\uff0c\u56e0\u6b64\u9700\u8981\u5728\u4eca\u5929\u7684\u6bd4\u8d5b\u4e2d\u664b\u7ea7\u624d\u80fd\u53c2\u52a0\u4f59\u4e0b\u7684\u6bd4\u8d5b\u3002<\/p>\n<h4>\u7ecf\u9a8c\u4e0e\u5929\u8d4b<\/h4>\n<p>\u7efc\u7ff0\u7684\u5bf9\u624b\u6bd4\u4ed6\u5e74\u8f7b\u5f88\u591a\uff0c\u4e24\u4eba\u4e4b\u95f4\u7684\u5e74\u9f84\u5dee\u8ddd\u5f88\u5927\uff08\u7efc\u7ff0\u51fa\u751f\u4e8e1977\u5e74\uff1b\u83ab\u54c8\u672b\u963f\u91cc\u592b\u51fa\u751f\u4e8e1989\u5e74\uff09\u3002<\/p>\n<p>\u7efc\u7ff0\u7528\u4e86\u81ea\u5df1\u6240\u6709\u7684\u7fbd\u6bdb\u7403\u6280\u672f\u548c\u7ecf\u9a8c\u6765\u53c2\u52a0\u8fd9\u573a\u6bd4\u8d5b\u3002\u4ed6\u5728\u7403\u573a\u524d\u90e8\u9605\u8bfb\u6bd4\u8d5b\u7684\u80fd\u529b\u975e\u5e38\u51fa\u8272\u3002\u4ed6\u7684\u5927\u90e8\u5206\u5236\u80dc\u6295\u7bee\u90fd\u6765\u81ea\u4e8e\u4ed6\u7684\u7f51\u524d\u8fdb\u653b\u3002<\/p>\n<p>\u83ab\u54c8\u672b\u963f\u91cc\u592b\uff08Mohd Arif\uff09\u654f\u6377\u4e14\u76f8\u5bf9\u6fc0\u8fdb\u3002\u5373\u4f7f\u662f\u7efc\u7ff0\u4e5f\u65e0\u6cd5\u9632\u5b88\u83ab\u54c8\u672b\u963f\u91cc\u592b\u5728\u573a\u8fb9\u7684\u4e00\u4e9b\u6740\u7403\u3002<\/p>\n<h4>\u7b56\u7565\u3001\u7cbe\u51c6\u5ea6\u548c\u7ecf\u9a8c<\/h4>\n<p>\u7efc\u7ff0\u7684\u7b56\u7565\u5e76\u4e0d\u662f\u8981\u8feb\u4f7f\u96c6\u4f1a\u52a0\u5feb\u6b65\u4f10\u3002\u4ed6\u77e5\u9053\u81ea\u5df1\u65e0\u6cd5\u8ddf\u4e0a\u5e74\u8f7b\u5bf9\u624b\u7684\u4f53\u80fd\u6c34\u5e73\u3002<\/p>\n<p>\u7efc\u7ff0\u91c7\u7528\u7684\u7b56\u7565\u662f\u5c06\u7403\u5c04\u5411\u7403\u573a\u7684\u56db\u4e2a\u89d2\u843d\uff0c\u8fd9\u8feb\u4f7f\u963f\u91cc\u592b\u52aa\u529b\u5c04\u95e8\uff0c\u5e76\u8feb\u4f7f\u4e00\u4e9b\u56de\u7403\u8f83\u5f31\u3002<\/p>\n<p>\u7efc\u7ff0\u7684\u5236\u80dc\u4e00\u7403\u975e\u5e38\u597d\u5730\u51fa\u73b0\u5728\u573a\u8fb9\uff0c\u8fd9\u901a\u5e38\u5728\u9632\u5b88\u4e0a\u975e\u5e38\u6709\u6548\u3002 <em>\u4efb\u4f55<\/em> \u7fbd\u6bdb\u7403\u5355\u6253\u6bd4\u8d5b\u3002<\/p>\n<p>\u8fd9\u4f4d\u524d\u4e16\u754c\u7b2c\u4e00\u53ea\u662f\u60f3\u5c3d\u5feb\u7ed3\u675f\u96c6\u4f1a\u3002\u5f53\u83ab\u54c8\u672b\u963f\u91cc\u592b\u5f00\u59cb\u79ef\u84c4\u52a8\u529b\u65f6\uff0c\u7efc\u7ff0\u5bf9\u6b64\u65e0\u80fd\u4e3a\u529b\u3002<\/p>\n<p>\u7b80\u800c\u8a00\u4e4b\uff0c\u7efc\u7ff0\u4e00\u770b\u5230\u673a\u4f1a\u5c31\u8bd5\u56fe\u4ee5\u5236\u80dc\u4e00\u51fb\u7684\u65b9\u5f0f\u5c3d\u5feb\u7ed3\u675f\u6bd4\u8d5b\u3002\u7136\u800c\uff0c\u4ed6\u4e5f\u8bd5\u56fe\u51cf\u6162\u6bd4\u8d5b\u7684\u901f\u5ea6\u3002<\/p>\n<p>\u8fd9\u786e\u5b9e\u662f\u7efc\u7ff0\u91c7\u53d6\u7684\u660e\u667a\u7b56\u7565\u3002<\/p>\n<h4>\u7b2c\u4e09\u5c40\u2014\u2014\u963f\u91cc\u592b\u670d\u52a1\u98ce\u683c\u7684\u8f6c\u53d8<\/h4>\n<p>\u6bd4\u8d5b\u8fdb\u5165\u7b2c\u4e09\u5c40\uff0c\u4e5f\u662f\u51b3\u80dc\u5c40\u3002\u9ec4\u7efc\u7ff0\u5728\u6bd4\u8d5b\u4e2d\u9065\u9065\u9886\u5148\u3002\u83ab\u54c8\u672b\u00b7\u963f\u91cc\u592b\u4ee5\u67d0\u79cd\u65b9\u5f0f\u8f6c\u800c\u4f7f\u7528\u9ad8\u53d1\u7403\u800c\u4e0d\u662f\u4f4e\u53d1\u7403\u3002<\/p>\n<p>\u6211\u4e0d\u592a\u6e05\u695a\u4e3a\u4ec0\u4e48\u4ed6\u4f1a\u9009\u62e9\u8fd9\u4e2a\u9009\u62e9\uff0c\u56e0\u4e3a\u83ab\u54c8\u672b\u963f\u91cc\u592b\u7684\u9ad8\u53d1\u7403\u5b9e\u9645\u4e0a\u6709\u5229\u4e8e\u8eab\u6750\u9ad8\u5927\u7684\u7efc\u7ff0\u3002<