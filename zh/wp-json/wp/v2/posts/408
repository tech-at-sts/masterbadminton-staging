eec\u7684\u5f00\u5c40\u5f88\u8270\u96be\u3002<\/p>\n<p>\u4e0d\u8fc7\uff0c\u4ed6\u4eec\u8fd8\u662f\u6210\u529f\u7f29\u5c0f\u4e86\u6bd4\u5206\u5dee\u8ddd\uff0c\u4ee521-18\u7ed3\u675f\u9996\u5c40\u3002<\/p>\n<p>\u7b2c\u4e8c\u5c40\u5f00\u5c40\uff0cChin\/Wong \u7684\u5f00\u5c40\u52bf\u5934\u5f3a\u52b2\u3002\u5f53\u65e5\u672c\u961f\u5bf9\u9a6c\u6765\u897f\u4e9a\u4eba\u7684\u5a01\u80c1\u5f00\u59cb\u51cf\u5f31\u65f6\uff0c\u5931\u8bef\u6210\u4e86\u9a6c\u6765\u897f\u4e9a\u4eba\u6700\u5927\u7684\u632b\u6298\u3002<\/p>\n<p>\u6700\u7ec8\uff0c\u65e5\u672c\u961f\u5bf9\u9a6c\u6765\u897f\u4e9a\u961f\u6765\u8bf4\u592a\u5f3a\u5927\u4e86\u3002\u677e\u5c3e\/\u5185\u85e4\u4ee521-18\u300121-11\u9501\u5b9a\u80dc\u5c40\u3002<\/p>\n<h3>Porntip (THA) v \u5218\u6b23 (CHN)<\/h3>\n<p><strong>WS \u51b3\u8d5b\u7b2c 1 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/fJoth9ExVpw\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p><strong>WS \u51b3\u8d5b\u7b2c 2 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/j-bTHWgWjRc\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p><strong>WS \u51b3\u8d5b\u7b2c 3 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/EPI3YxaLJik\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p>\u5728\u51fb\u8d25\u738b\u7433\u9501\u5b9a\u51b3\u8d5b\u5e2d\u4f4d\u540e\uff0c\u5f88\u591a\u4eba\u90fd\u5728\u671f\u5f85\u84ec\u8482\u666e\u80fd\u5426\u5728\u6fb3\u7f51\u6253\u51fa\u7c7b\u4f3c\u7684\u8868\u73b0\uff0c\u51fb\u8d25\u53e6\u4e00\u4f4d\u4e2d\u56fd\u9009\u624b\uff08\u4e00\u53f7\u79cd\u5b50\u5218\u6615\uff09\u593a\u51a0\u3002<\/p>\n<p>\u84ec\u8482\u666e\u6709\u6280\u672f\u548c\u6280\u672f\uff0c\u65e0\u53ef\u4e89\u8bae\u5730\u6210\u4e3a\u5218\u6b23\u7684\u5f3a\u52b2\u5bf9\u624b\u3002\u4e0d\u5e78\u7684\u662f\uff0c\u8fd9\u4f4d\u5e74\u8f7b\u7684\u6cf0\u56fd\u7403\u5458\u7684\u6bd4\u8d5b\u7f3a\u4e4f\u4fe1\u5fc3\u3002\u5218\u6b23\u7684\u9ad8\u629b\u7403\u3001\u7280\u5229\u7684\u6263\u7403\u548c\u7cbe\u6e5b\u7684\u6b65\u6cd5\uff0c\u8868\u73b0\u51fa\u8272\u3002\u4f46\u662fPorntip\u7684\u8868\u73b0\u4e0d\u5982\u5979\u5728\u534a\u51b3\u8d5b\u4e2d\u7684\u8868\u73b0\u3002<\/p>\n<p>\u4e24\u5c40\u6bd4\u5206\u5dee\u8ddd\u62c9\u5927\uff0c\u5218\u6b23\u4e00\u8def\u9886\u5148\u3002 Porntip \u4f3c\u4e4e\u6ca1\u6709\u673a\u4f1a\u3002\u8fd9\u4f4d\u5e74\u8f7b\u7684\u6cf0\u56fd\u4eba\u6709\u5929\u8d4b\uff0c\u4f46\u7f3a\u4e4f\u53c2\u52a0\u9ad8\u6c34\u5e73\u6bd4\u8d5b\u7684\u7cbe\u795e\u529b\u91cf\u3002<\/p>\n<h3>Choong Hann (MAS) v Sho (JPN) \u2013 \u4eae\u70b9<\/h3>\n<p><strong>MS \u6700\u7ec8\u7b2c 1 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/SlKQZCnC4pU\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p><strong>MS \u51b3\u8d5b\u7b2c 2 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/BNlVnKNbpvA\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p><strong>WS \u51b3\u8d5b\u7b2c 3 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/Ytu9PRV2NA0\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p><strong>WS \u6700\u7ec8\u7b2c 4 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/f26foRHCPmE\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p><strong>WS \u51b3\u8d5b\u7b2c 5 \u90e8\u5206<\/strong><\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/ju377fGuhm4\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p>\u6700\u540e\uff0c2011\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u51b3\u8d5b\u7684\u91cd\u5934\u620f\u662f\u524d\u4e16\u754c\u6392\u540d\u7b2c\u4e8c\u7684\u9ec4\u5fe0\u7ff0\u4e0e\u4f50\u4f50\u6728\u7fd4\u7684MS\u5bf9\u51b3\u3002<\/p>\n<p>\u524d\u82f1\u8054\u90a6\u8fd0\u52a8\u4f1a\u91d1\u724c\u5f97\u4e3b Choong Hann \u7684\u9ad8\u8d85\u6280\u827a\u7edd\u5bf9\u662f\u663e\u800c\u6613\u89c1\u7684\uff1b\u4f46\u662fSho Sasaki\u5728\u4ed6\u7684\u6bd4\u8d5b\u4e2d\u6709\u5f88\u5f3a\u7684\u4f53\u529b\u548c\u7a33\u5b9a\u6027\u3002\u5728\u8fd9\u573a\u6bd4\u8d5b\u4e4b\u524d\uff0c\u51e0\u4e4e\u4e0d\u53ef\u80fd\u9884\u6d4b\u6bd4\u5206\u3002<\/p>\n<p>\u8fd9\u573a\u7ade\u4e89\u6fc0\u70c8\u7684MS\u6bd4\u8d5b\u6700\u7ec8\u8fdb\u5165\u80f6\u7740\u72b6\u6001\u3002<\/p>\n<p>\u5728\u7b2c\u4e00\u76d8\u4e2d\uff0cSho \u5411\u5bf9\u624b\u53d1\u5c04\u4e86\u4ed6\u6240\u6709\u7684\u4e1c\u897f\u3002 Choong Hann \u5f88\u6709\u8010\u5fc3\uff0c\u5bf9\u6bcf\u4e00\u6b21\u5c04\u95e8\u90fd\u8fdb\u884c\u4e86\u9632\u5b88\u3002\u9a6c\u6765\u897f\u4e9a\u4eba\u9009\u62e9\u4e86\u9632\u5b88\u7b56\u7565\uff0c\u6700\u7ec8\u4ee5\u4f50\u4f50\u6728\u7fd4\u7684\u4e0d\u65ad\u8f70\u70b8\u544a\u7ec8\u3002<\/p>\n<p>\u5728\u7b2c\u4e8c\u573a\u6bd4\u8d5b\u4e2d\uff0c\u5f62\u52bf\u53d1\u751f\u4e86\u9006\u8f6c\u3002\u4e0e\u670b\u53cb\u804a\u4e86\u51e0\u53e5\u540e\uff0cChoong Hann \u8f6c\u800c\u91c7\u53d6\u66f4\u5177\u653b\u51fb\u6027\u7684\u7b56\u7565\u3002\u5728\u9a6c\u6765\u897f\u4e9a\u4eba\u7684\u6bd4\u8d5b\u4e2d\uff0c\u9661\u5ced\u800c\u6709\u529b\u7684\u8de8\u573a\u6263\u7403\u53d8\u5f97\u66f4\u52a0\u660e\u663e\u3002\u5f53 Choong Hann \u53d1\u51fa\u8fd9\u4e9b\u653b\u51fb\u65f6\uff0cSho \u65e0\u80fd\u4e3a\u529b\u3002\u7b2c\u4e8c\u5c40\u6bd4\u5206\u5dee\u8ddd\u62c9\u5927\uff0c\u949f\u7ff0\u4e00\u5ea6\u4ee517-7\u9886\u5148\u3002<\/p>\n<p>\u4e0d\u5e78\u7684\u662f\uff0c\u5bf9\u4e8e Choong Hann \u6765\u8bf4\uff0c\u5e74\u9f84\u662f\u7b2c\u4e09\u573a\u6bd4\u8d5b\u593a\u51a0\u7684\u969c\u788d\u3002\u5f88