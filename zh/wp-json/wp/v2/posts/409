8ba8\u8bba\u8fd9\u4e00\u4e8b\u4ef6\uff0c\u56e0\u4e3a\u5b83\u6807\u5fd7\u7740\u6fb3\u5927\u5229\u4e9a\u7fbd\u6bdb\u7403\u8fd0\u52a8\u7684\u53d1\u5c55\u3002 2011 \u5e74\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u5c06\u9996\u6b21\u8d5e\u52a9 120,000 \u7f8e\u5143\u7684\u5956\u91d1\u3002<\/p>\n<p>\u53bb\u5e742010\u5e74\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u7684\u5956\u91d1\u4ec5\u4e3a5\u4e07\u7f8e\u5143\u3002\u4eca\u5e74\uff0c\u5c24\u5c3c\u514b\u65af\u613f\u610f\u4e3a\u8fd9\u9879\u56fd\u9645\u7fbd\u6bdb\u7403\u8d5b\u4e8b\u8d5e\u52a912\u4e07\u7f8e\u5143\u3002\u8fd9\u8868\u660e\u7fbd\u6bdb\u7403\u786e\u5b9e\uff08\u5e76\u4e14 <em>\u53d8\u5f97<\/em>\uff09\u662f\u6fb3\u5927\u5229\u4e9a\u6d41\u884c\u7684\u8fd0\u52a8\u3002<\/p>\n<p>2011\u5e74\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u5438\u5f15\u4e86\u6765\u81ea\u4e16\u754c\u5404\u5730\u7684\u4f17\u591a\u4e16\u754c\u7ea7\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u3002\u5373\u5c06\u6765\u58a8\u5c14\u672c\u7684\u4eba\u5305\u62ec\uff1a<\/p>\n<ul><strong\/><\/p>\n<li>\u6587\u8428\u514b\u00b7\u84ec\u8428\u7eb3 [7]<\/li>\n<li>\u7d22\u5c3c\u00b7\u5fb7\u7ef4\u00b7\u6606\u79d1\u7f57 [33]<\/li>\n<li>\u9ec4\u7efc\u7ff0 [32]<\/li>\n<li>\u7a46\u7f55\u9ed8\u5fb7\u00b7\u54c8\u83f2\u5179\u00b7\u54c8\u5e0c\u59c6 [26]<\/li>\n<li>\u962e\u8fdb\u660e [7]<\/li>\n<li>\u738b\u7433 [91] \u2013 \u73b0\u4efb\u7fbd\u6bdb\u7403\u4e16\u754c\u51a0\u519b<\/li>\n<li>\u8fd8\u6709\u5f88\u591a\uff01<\/li>\n<\/ul>\n<p>\u8fd9\u4e9b\u90fd\u662f\u771f\u6b63\u7684\u9876\u7ea7\u7403\u5458\u3002\u7a46\u7f55\u9ed8\u5fb7\u00b7\u54c8\u83f2\u5179\u00b7\u54c8\u5e0c\u59c6\u662f <em>2002\u5e74\u82f1\u8054\u90a6\u8fd0\u52a8\u4f1a\u91d1\u724c\u5f97\u4e3b<\/em>, \u9ec4\u5fe0\u6c49 <em>1998\u5e74\u82f1\u8054\u90a6\u8fd0\u52a8\u4f1a\u91d1\u724c\u5f97\u4e3b<\/em>\uff0c\u6240\u4ee5\u8fd9\u6b21\u7fbd\u6bdb\u7403\u8d5b\u4e8b\u5bf9\u4e8e\u6bcf\u4e2a\u6fb3\u5927\u5229\u4e9a\u4eba\u6765\u8bf4\u90fd\u662f\u4e00\u4e2a\u96be\u5f97\u7684\u673a\u4f1a\u6765\u89c2\u770b\u8fd9\u4e9b\u9876\u7ea7\u9009\u624b\u7684\u73b0\u573a\u6bd4\u8d5b\uff01<\/p>\n<p>\u7fbd\u6bdb\u7403\u5728\u6b27\u6d32\u548c\u4e9a\u6d32\u662f\u4e00\u9879\u6d41\u884c\u7684\u8fd0\u52a8\uff0c\u6211\u4eec\u76f8\u4fe1\u5b83\u7684\u53d7\u6b22\u8fce\u7a0b\u5ea6\u5c06\u4f20\u64ad\u5230\u6fb3\u5927\u5229\u4e9a\u3002\u6211\u4eec\u8ba4\u4e3a\u5c24\u5c3c\u514b\u65af\u575a\u4fe1\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5c06\u5728\u6fb3\u5927\u5229\u4e9a\u8d8a\u6765\u8d8a\u53d7\u6b22\u8fce\uff0c\u8fd9\u4e5f\u662f\u4eca\u5e74\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u5956\u91d1\u5927\u5e45\u589e\u52a0\u7684\u539f\u56e0\u3002<\/p>\n<p>\u5bf9\u4e8e\u5c45\u4f4f\u5728\u6fb3\u5927\u5229\u4e9a\uff08\u5c24\u5176\u662f\u7ef4\u591a\u5229\u4e9a\u5dde\uff09\u4e14\u559c\u6b22\u6253\u7fbd\u6bdb\u7403\u7684\u4eba\u6765\u8bf4\uff0c\u60a8\u53ef\u80fd\u4f1a\u8003\u8651\u5229\u7528\u5468\u672b\uff082011 \u5e74 4 \u6708 9 \u65e5\u81f3 10 \u65e5\uff09\u89c2\u770b Yonex \u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u9ec4\u91d1\u5927\u5956\u8d5b\u73b0\u573a\u76f4\u64ad\u3002<\/p>\n<p>\u6210\u4e3a\u60a8\u6700\u559c\u7231\u7684\u8fd0\u52a8\u53d1\u5c55\u7684\u4e00\u90e8\u5206\u3002\u5982\u679c2011\u5e74\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u7684\u534a\u51b3\u8d5b\u548c\u51b3\u8d5b\u73b0\u573a\u4eba\u5c71\u4eba\u6d77\uff0c\u8c01\u77e5\u9053\u660e\u5e74\u4f1a\u6709\u66f4\u591a\u7684\u4f01\u4e1a\u8d5e\u52a9\u66f4\u591a\u7684\u5956\u91d1\u5462\uff1f <\/p>\n<p>\u66f4\u5927\u7684\u5956\u91d1\u80af\u5b9a\u4f1a\u5438\u5f15\u66f4\u591a\u7684\u4e16\u754c\u7ea7\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u3002\u5c4a\u65f6\uff0c\u6fb3\u5927\u5229\u4e9a\u4eba\u5c06\u80fd\u591f\u6b23\u8d4f\u548c\u89c2\u770b\u4e16\u754c\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u66f4\u52a0\u7cbe\u6e5b\u7684\u73b0\u573a\u8868\u6f14\uff01<\/p>\n<p>\u6211\u559c\u6b22\u6253\u7fbd\u6bdb\u7403\uff0c\u76ee\u524d\u5c45\u4f4f\u5728\u6fb3\u5927\u5229\u4e9a\u3002\u6211\u771f\u5fc3\u5e0c\u671b\u7fb