h3>\n<p>\u57282011\u5e74\u5c24\u5c3c\u514b\u65af\u4e39\u9ea6\u516c\u5f00\u8d5b\uff08\u672c\u5c4a\u8d5b\u4e8b\u524d\u4e00\u5468\u4e3e\u884c\uff09\u4e2d\uff0c\u4e39\u9ea6\u4eba\u5728\u534a\u51b3\u8d5b\u4e2d\u9762\u5bf9\u4e16\u754c\u6392\u540d\u7b2c\u4e00\u7684\u4e2d\u56fd\u9009\u624b\uff0c\u5728\u51b3\u8d5b\u4e2d\u9762\u5bf9\u4e16\u754c\u6392\u540d\u7b2c\u4e8c\u7684\u9009\u624b\u3002<\/p>\n<p>\u548c\u672c\u5c4a\u5927\u8d5b\u4e00\u6a21\u4e00\u6837\uff01<\/p>\n<p><a href=\"\/zh\/yonex-denmark-open-2011-mixed-doubles-finals.html\/\" onclick=\"return FIX.track(this);\">\u5355\u51fb\u6b64\u5904\u89c2\u770b\u4ed6\u4eec\u4e4b\u524d\u5728 <strong>2011\u5c24\u5c3c\u514b\u65af\u4e39\u9ea6\u516c\u5f00\u8d5b\u51b3\u8d5b<\/strong><\/a><\/p>\n<p>\u5728 2011 \u5e74 Yonex \u6cd5\u56fd\u7f51\u7403\u516c\u5f00\u8d5b\u51b3\u8d5b\u4e2d\uff1b Jaochim\u548cChristinna\u8fde\u7eed\u4e24\u5c40\u518d\u6b21\u51fb\u8d25\u4e86\u5f90\u7a0b\u548c\u9a6c\u8fdb\u3002<\/p>\n<p>\u8fd9\u7ed9\u4e86\u4ed6\u4eec\u5728\u6cd5\u7f51\u7684\u7b2c\u4e00\u4e2a\u51a0\u519b\u5934\u8854\u3002<\/p>\n<h3>\u4eba\u7fa4\u652f\u6301<\/h3>\n<p>2011 \u5e74 Yonex \u6cd5\u56fd\u7f51\u7403\u516c\u5f00\u8d5b\u7684\u5927\u591a\u6570\u89c2\u4f17\u90fd\u652f\u6301\u4e39\u9ea6\u4eba\u3002<\/p>\n<p>\u4f60\u4f1a\u5728\u4eba\u7fa4\u7684\u638c\u58f0\u4e2d\u6ce8\u610f\u5230\u8fd9\u4e00\u70b9\u3002\u6211\u60f3\u8bf4\u8fd9\u662f\u4e39\u9ea6\u4eba\u5728\u672c\u5c4a\u9526\u6807\u8d5b\u4e2d\u8868\u73b0\u5982\u6b64\u51fa\u8272\u7684\u4e00\u4e2a\u4fc3\u6210\u56e0\u7d20\u3002<\/p>\n<h3>\u65b0\u5bf9\u624b\uff1f<\/h3>\n<p>\u8fd9\u5bf9\u4e39\u9ea6\u7ec4\u5408\u5728\u8fde\u7eed\u4e24\u7ad9\u6bd4\u8d5b\u4e2d\u4e24\u6b21\u51fb\u8d25\u4e16\u754c\u6392\u540d\u7b2c\u4e00\u548c\u4e16\u754c\u6392\u540d\u7b2c\u4e8c\u7684\u6df7\u53cc\u7ec4\u5408\uff01<\/p>\n<p>\u4ed6\u4eec\u662f\u4e2d\u56fd\u56fd\u5bb6\u6df7\u53cc\u961f\u7684\u514b\u661f\u5417\uff1f<\/p>\n<h3>\u6bd4\u8d5b\u4e2d\u7684\u8868\u73b0<\/h3>\n<p>\u4e24\u5bf9\u5f00\u59cb\u90fd\u5f88\u6162\uff0c\u56e0\u4e3a\u4ed6\u4eec\u521a\u521a\u9002\u5e94\u7403\u573a\u3002\u975e\u53d7\u8feb\u6027\u9519\u8bef\u63a5\u8fde\u51fa\u73b0\u3002<\/p>\n<p>\u5f53\u53cc\u65b9\u5f00\u59cb\u627e\u5230\u81ea\u5df1\u7684\u72b6\u6001\u65f6\uff0c\u96c6\u4f1a\u53d8\u5f97\u66f4\u52a0\u4ee4\u4eba\u5174\u594b\u3002<\/p>\n<p>\u6211\u4eec\u5f88\u5c11\u770b\u5230\u7537\u5b50\u5728\u6807\u51c6\u7684\u7fbd\u6bdb\u7403\u6df7\u53cc\u6bd4\u8d5b\u4e2d\u51b2\u5411\u7f51\u524d\u3002<\/p>\n<p>\u7136\u800c\uff0c\u7ea6\u963f\u5e0c\u59c6\u4e00\u770b\u5230\u673a\u4f1a\uff0c\u5c31\u51b2\u4e86\u4e0a\u53bb\uff01\u4ed6\u5927\u90e8\u5206\u65f6\u95f4\u90fd\u8d62\u5f97\u4e86\u62c9\u529b\u8d5b\uff0c\u8fd9\u4f7f\u4ed6\u7684\u6253\u6cd5\u975e\u5e38\u6709\u6548\u3002<\/p>\n<p>\u867d\u7136\u9996\u5c40\u6bd4\u5206\u975e\u5e38\u80f6\u7740\uff0c\u4f46\u6211\u4eec\u53ef\u4ee5\u660e\u663e\u770b\u51fa\u4e39\u9ea6\u4eba\u5728\u6bd4\u5206\u4e0a\u5360\u636e\u4f18\u52bf\u3002<\/p>\n<h3>\u8d1f\u9762\u60c5\u7eea\u548c\u5fc3\u7406\u6e38\u620f<\/h3>\n<p>\u5f90\u57ce\u548c\u9a6c\u8fdb\u62c5\u5fc3\u53c8\u8981\u8f93\u7ed9\u4e39\u9ea6\u4eba\u4e86\u3002<\/p>\n<p>\u5982\u679c\u4f60\u89c2\u5bdf\u6e05\u695a\u7684\u8bdd\uff0c\u4e2d\u56fd\u961f\u5728\u4e24\u56de\u5408\u4e4b\u95f4\u5728\u7403\u573a\u4e0a\u53d1\u751f\u4e86\u4e00\u4e9b\u8f7b\u5fae\u7684\u4e89\u5435\u3002<\/p>\n<p>\u7ea6\u963f\u5e0c\u59c6\u548c\u514b\u91cc\u65af\u8482\u5a1c\u62fc\u547d\u628a\u9a6c\u8fdb\u903c\u5230\u540e\u573a\u3002<\/p>\n<p>\u4e0e\u6b64\u540c\u65f6\uff0c\u8fd9\u5bf9\u4e2d\u56fd\u7ec4\u5408\u62fc\u5c3d\u5168\u529b\u56de\u5230\u4e86\u81ea\u5df1\u559c\u6b22\u7684\u9635\u578b\uff0c\u540e\u6392\u662f\u5f90\u8bda\uff0c\u524d\u6392\u662f\u9a6c\u664b\u3002<\/p>\n<p>\u7136\u800c\uff0c\u5f53\u4e39\u9ea6\u4eba\u5982\u6b64\u6210\u529f\u5730\u8ba9\u9a6c\u8fdb\u5728\u7403\u573a\u540e\u573a\u5de5\u4f5c\u65f6\uff0c\u4e2d\u56fd\u4eba\u9677\u5165\u4e86\u5fc3\u7406\u9677\u9631\u3002<\/p>\n<p>\u5f90\u8bda\u8fdb\u653b\u592a\u6025\uff0c\u903c\u51fa\u4e86\u5f88\u591a\u5931\u8bef\u3002<\/p>\n<h3>\u4e00\u4e2a\u7f55\u89c1\u7684\u9519\u8bef<\/h3>\n<p>\u6bd4\u8d5b\u6253\u5230\u9ad8\u6f6e\u65f6\uff0c\u4e2d\u56fd\u961f\u4eba\u5fc3\u60f6\u60f6\uff0c\u9669\u4e9b\u8f93\u6389\u6bd4\u8d5b\u3002<\/p>\n<p>\u8fd9\u5bf9\u4e2d\u56fd\u7ec4\u5408\u72af\u4e86\u4e00\u4e2a\u91cd\u5927\u9519\u8bef\uff0c\u8fd9\u662f\u6211\u5728\u4e3b\u8981\u7fbd\u6bdb\u7403\u6bd4\u8d5b\u4e2d\u4ece\u672a\u89c1\u8fc7\u7684\u3002<\/p>\n<p>\u5f90\u57ce\u548c\u9a6c\u664b\u649e\u5728\u4e86\u5bf9\u65b9\u7684\u540e\u573a\uff0c\u4e24\u4eba\u7684\u8eab\u4f53\u649e\u5728\u4e86\u4e00\u8d77\uff01<\/p>\n<p>\u4e5f\u8bb8\u4e24\u540d\u7403\u5458\u90fd\u592a\u6e34\u671b\u8fdb\u653b\u5e76\u8d62\u5f97\u6bd4\u8d5b\u3002\u8fd9\u79cd\u201c\u4e00\u4eba\u79c0\u201d\u7684\u6218\u672f\u5728\u7fbd\u6bdb\u7403\u53cc\u6253\u6bd4\u8d5b\u4e2d\u975e\u5e38\u4e0d\u5229\u3002<\/p>\n<p>\u8fd9\u53d1\u751f\u5728\u6bd4\u8d5b\u63a5\u8fd1\u5c3e\u58f0\u65f6\u3002\u8fd9\u662f\u4e00\u4e2a\u5fc5\u987b\u770b\u5230\u7684\uff01<\/p>\n<div class=\"retnvbx1\"><\/div>\n<div class=\"fb-comments-intro-ns\">\n<div class=\"retnvbx\"><\/div>\n<h3><span class=\"teelmeww\">\u544a\u8bc9\u6211\u4f60\u7684\u60f3\u6cd5\uff01<\/span><\/h3>\n<p> \u4f60\u5bf9\u521a\u521a\u8bfb\u5230\u7684\u5185\u5bb9\u6709\u4f55\u770b\u6cd5\uff1f\u5728\u4e0b\u9762\u7ed9\u6211\u7559\u8a00\u3002<\/p><\/div>\n<div id=\"COMMENTING\" class=\"fb-comment\">\n<div class=\"fb-comments\" data-href=\"http:\/\/www.how-to-play-badminton.com\/yonex-french-open-2011-mixed-doubles-final.html\" data-num-posts=\"15\" data-width=\"100%\"\/><\/div>\n<h3 class=\"fblikeste\">\u559c\u6b22 Masterbadminton.com\uff1f<\/h3>\n<p\/>\n<div id=\"fb-root\"\/><script><![CDATA[(function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(d.getElementById(id)){return;}js=d.createElement(s);js.id=id;js.src=\"..\/connect.facebook.net\/en_US\/all.js#xfbml=1\";fjs.parentNode.insertBefore(js,fjs);}(document,'script','facebook-jssdk'));]]><\/script><like href=\"index.html\" send=\"false\" width=\"450\" show_fac