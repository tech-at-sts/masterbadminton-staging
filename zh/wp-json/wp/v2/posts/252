{"id":252,"date":"2016-05-16T12:50:12","date_gmt":"2016-05-16T12:50:12","guid":{"rendered":"http:\/\/masterbadminton.dev\/lee-chong-wei\/"},"modified":"2016-09-06T11:29:07","modified_gmt":"2016-09-06T11:29:07","slug":"lee-chong-wei","status":"publish","type":"post","link":"https:\/\/masterbadminton.com\/zh\/lee-chong-wei.html","title":{"rendered":"\u674e\u5b97\u4f1f"},"content":{"rendered":"<div id=\"ContentColumn\">\n<div class=\"Liner\">\n<div style=\"float: left;\"><\/div>\n<p>\u674e\u5b97\u4f1f\u662f\u8fd9\u9879\u8fd0\u52a8\u5386\u53f2\u4e0a\u6700\u6210\u529f\u3001\u6700\u7a33\u5b9a\u7684\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u4e4b\u4e00\u3002<\/p>\n<p>&nbsp;<\/p>\n<p><span style=\"color: #000000; font-family: Arial; font-size: small;\"><span style=\"color: #000000; font-family: Arial; font-size: small;\"><br \/>\n<\/span><\/span><\/p>\n<table border=\"1\" width=\"400px\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td bgcolor=\"#66CCFF\" width=\"50%\" height=\"30px\"><span style=\"color: #000000; font-family: Arial; font-size: medium;\"><strong>\u73a9\u5bb6\u8d44\u6599<\/strong><\/span><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<table border=\"0\">\n<tbody>\n<tr>\n<td><strong>\u4e16\u754c\u7fbd\u8054\u6700\u4f73\u6392\u540d<\/strong><\/td>\n<td>: 1<\/td>\n<\/tr>\n<tr>\n<td><strong>\u51fa\u751f\u65e5\u671f<\/strong><\/td>\n<td>: 1982 \u5e74 10 \u6708 21 \u65e5<\/td>\n<\/tr>\n<tr>\n<td><strong>\u4e13\u4e1a<\/strong><\/td>\n<td>\uff1a\u6b65\u6cd5\uff0c\u9632\u5fa1\uff0c\u654f\u6377<\/td>\n<\/tr>\n<tr>\n<td><strong>\u56fd\u5bb6<\/strong><\/td>\n<td>: \u9a6c\u6765\u897f\u4e9a<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/lee-chong-wei.jpg\" alt=\"lee chong wei\" width=\"332\" height=\"298\" \/><\/p>\n<h3>\u4e00\u81f4\u6027<\/h3>\n<p>\u622a\u81f32011\u5e7412\u6708\uff0c\u674e\u5b97\u4f1f\u8fd8\u6ca1\u6709\u8d62\u5f97\u8fc7\u7fbd\u6bdb\u7403\u5927\u6ee1\u8d2f\u7b49\u51a0\u519b\u5934\u8854\u3002 <strong>\u5965\u8fd0\u4f1a<\/strong> \u6216\u8005 <strong>\u7fbd\u6bdb\u7403\u4e16\u754c\u9526\u6807\u8d5b\u51a0\u519b\u3002<\/strong><\/p>\n<p>\u7136\u800c\uff0c\u4ed6\u5df2\u7ecf\u4fdd\u6301\u4e86\u8fd13\u5e74\u7684BWF\u4e16\u754c\u7b2c\u4e00\u6392\u540d\u3002\u5386\u53f2\u4e0a\u8fd8\u6ca1\u6709\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u80fd\u5728\u4e16\u754c\u7b2c\u4e00\u7684\u4f4d\u7f6e\u4e0a\u4fdd\u6301\u8fd9\u4e48\u4e45\u3002<\/p>\n<p>\u9a6c\u6765\u897f\u4e9a\u4eba\u88ab\u79f0\u4e3a\u6709\u53f2\u4ee5\u6765\u6700\u7a33\u5b9a\u7684\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u4e4b\u4e00\u3002<\/p>\n<p>2011\u5e74\uff0c\u4ed6\u53c2\u52a0\u7684\u6240\u6709\u8d5b\u4e8b\u90fd\u8fdb\u5165\u4e86\u51b3\u8d5b\uff0c\u9664\u4e86\u4e24\u6b21\u8d85\u7ea7\u7cfb\u5217\u8d5b\uff0c\u4ed6\u90fd\u5728\u534a\u51b3\u8d5b\u4e2d\u88ab\u6797\u4e39\u51fb\u8d25\u3002<\/p>\n<p>\u4ed6\u8ba1\u5212\u57282012\u5e74\u9000\u5f79\u3002\u56e0\u6b64\uff0c\u4ed6\u5c06\u57282012\u5e74\u6700\u540e\u4e00\u640f\u4f26\u6566\u5965\u8fd0\u4f1a\u91d1\u724c\u548c\u7fbd\u6bdb\u7403\u4e16\u9526\u8d5b\u51a0\u519b\u3002<\/p>\n<h3>\u6539\u8fdb<\/h3>\n<p>\u591a\u5e74\u6765\uff0c\u8fd9\u4f4d\u7403\u5458\u7684\u7fbd\u6bdb\u7403\u6280\u672f\u6709\u4e86\u663e\u7740\u63d0\u9ad8\u3002 2011\u5e74\uff0c\u4ed6\u5728\u7fbd\u575b\u51e0\u4e4e\u7acb\u4e8e\u4e0d\u8d25\u4e4b\u5730\u3002\u9664\u4e86\u6797\u4e39\u548c\u8c0c\u9f99\uff0c\u6ca1\u6709\u5176\u4ed6\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u80fd\u6253\u8d25\u4ed6\u3002<\/p>\n<h3>\u6700\u5f3a\u5bf9\u624b<\/h3>\n<p>\u5d07\u4f1f\u6700\u5927\u7684\u5bf9\u624b\u7edd\u5bf9\u662f <a href=\"\/zh\/lin-dan.html\/\">\u6797\u4e39<\/a>!<\/p>\n<p>\u5728\u4ed6\u4e89\u593a\u4e3b\u8981\u51a0\u519b\u5934\u8854\u7684\u8fc7\u7a0b\u4e2d\uff0c\u6797\u4e39\u4e00\u76f4\u6321\u7740\u4ed6\u7684\u8def\u3002\u6797\u4e39\u603b\u662f\u51fa\u73b0\u5728\u6bcf\u573a\u91cd\u5927\u8d5b\u4e8b\u7684\u51b3\u8d5b\u4e2d\uff0c\u4ee5\u6467\u6bc1\u9a6c\u6765\u897f\u4e9a\u4eba\u7684\u68a6\u60f3\u3002<\/p>\n<p>\u4e00\u4e2a\u5f88\u597d\u7684\u4f8b\u5b50\u5c31\u662f2008\u5e74\u5317\u4eac\u5965\u8fd0\u4f1a\u51b3\u8d5b\u548c2011\u5e74\u7fbd\u6bdb\u7403\u4e16\u9526\u8d5b\uff0c\u6797\u4e39\u5728\u51b3\u8d5b\u4e2d\u5f3a\u52bf\u963b\u6b62\u674e\u5b97\u4f1f\u593a\u91d1\u3002<\/p>\n<p>\u5982\u6b64\u4e00\u6765\uff0c\u6797\u4e39\u5728\u7fbd\u6bdb\u7403\u6bd4\u8d5b\u4e2d\u7684\u6bcf\u4e00\u6b21\u4ea4\u950b\uff0c\u90fd\u53d8\u5f97\u66f4\u52a0\u6fc0\u70c8\u3002\u8fd9\u4e24\u4e2a\u4eba\u5f7c\u6b64\u975e\u5e38\u4e86\u89e3\uff0c\u4ed6\u4eec\u90fd\u9700\u8981\u505a\u7684\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u7684\u201c\u6700\u4f73\u201d\u3002<\/p>\n<p>\u9664\u4e86\u6797\u4e39\u4e4b\u5916\uff0c2011\u5e74\u804c\u4e1a\u751f\u6daf\u5dc5\u5cf0\u671f\u7684\u5d07\u4f1f\u5355\u6253\u6253\u8d25\u4efb\u4f55\u4eba\u90fd\u4e0d\u6210\u95ee\u9898\u3002<\/p>\n<p>\u7fbd\u6bdb\u7403\u8001\u624b\u5982 <a href=\"\/zh\/peter-gade.html\/\">\u5f7c\u5f97\u76d6\u5fb7<\/a> \u548c <a href=\"\/zh\/taufik-hidayat.html\/\">\u9676\u83f2\u514b\u5e0c\u8fbe\u4e9a\u7279<\/a> \u5982\u679c\u4ed6\u4eec\u66f4\u5e74\u8f7b\uff0c\u4ed6\u4eec\u53ef\u4ee5\u6253\u5f97\u5f88\u597d\u3002<\/p>\n<p>\u8c0c\u9f99\u3001\u7530\u4e61\u5065\u4e00\u7b49\u5e74\u8f7b\u6709\u5929\u8d4b\u7684\u7fbd\u6bdb\u7403\u9009\u624b\u4e5f\u662f\u4e0d\u9519\u7684\u5bf9\u624b\u3002\u4ed6\u4eec\u5076\u5c14\u4f1a\u5bf9\u674e\u65bd\u538b\uff0c\u4f46\u4ecd\u4e0d\u8db3\u4ee5\u51fb\u8d25\u4ed6\u3002<\/p>\n<h3>\u6bd4\u8d5b\u98ce\u683c<\/h3>\n<p>\u5728\u4ed6\u804c\u4e1a\u751f\u6daf\u7684\u521d\u671f\uff0c\u4ed6\u6253\u4e86\u4e00\u573a\u975e\u5e38\u9632\u5b88\u7684\u6bd4\u8d5b\u3002\u8fd9\u4f4d\u9a6c\u6765\u897f\u4e9a\u4eba\u56e0\u5728\u7fbd\u6bdb\u7403\u5355\u6253\u6bd4\u8d5b\u4e2d\u8868\u73b0\u51fa\u8272\u7684\u7fbd\u6bdb\u7403\u9632\u5b88\u800c\u4e00\u4e3e\u6210\u540d\u3002<\/p>\n<p>\u5f53\u4ed6\u5f00\u59cb\u804c\u4e1a\u751f\u6daf\u65f6\uff0c\u4ed6\u4e0d\u613f\u610f\u5192\u9669\u8fdb\u884c\u653b\u51fb\u3002\u56e0\u6b64\uff0c\u4ed6\u6bd4\u5bf9\u624b\u66f4\u9891\u7e41\u5730\u89e3\u56f4\/\u540a\u7403\uff0c\u5f15\u8bf1\u5bf9\u624b\u8fdb\u653b\u3002<\/p>\n<h3>\u65b0\u6280\u80fd\u548c\u65b0\u6e38\u620f\u98ce\u683c<\/h3>\n<p>\u5728\u4ed6\u83b7\u5f97\u7fbd\u6bdb\u7403\u5355\u6253\u4e16\u754c\u7b2c\u4e00\u540e\u4e0d\u4e45\uff0c\u4ed6\u5f00\u59cb\u50cf\u4e16\u754c\u7ea7\u51a0\u519b\u4e00\u6837\u6253\u7403\u3002\u4ed6\u5f00\u59cb\u4f7f\u7528\u6b3a\u9a97\u6027\u7684\u7fbd\u6bdb\u7403\u51fb\u7403\u3002<\/p>\n<p>\u7136\u800c\uff0c\u674e\u7684\u6bd4\u8d5b\u98ce\u683c\u4ecd\u7136\u5b58\u5728\u4e00\u4e9b\u5f31\u70b9\u3002\u4ed6\u7ee7\u7eed\u73a9\u9632\u5b88\u6e38\u620f\u3002\u4ed6\u7684\u9a97\u672f\u662f\u88ab\u52a8\u7684\uff0c\u50cf\u6797\u4e39\u8fd9\u6837\u7684\u5f3a\u654c\u5f88\u5bb9\u6613\u770b\u7a7f\u4ed6\u7684\u9a97\u672f\u3002<\/p>\n<p>2011\u5e74\uff0c\u4ed6\u8fdb\u6b65\u660e\u663e\uff0c\u8fbe\u5230\u4e86\u771f\u6b63\u4e16\u754c\u7ea7\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u7684\u6807\u51c6\u3002<\/p>\n<p>\u770b\u770b\u4ed6\u5728 2011 \u5e74\u7684\u8868\u73b0\uff0c\u5f88\u96be\u76f8\u4fe1\u5b97\u4f1f\u6ca1\u6709\u83b7\u5f97\u4efb\u4f55\u91cd\u8981\u7684\u7fbd\u6bdb\u7403\u51a0\u519b\u5934\u8854\u3002<\/p>\n<p>\u4ed6\u7684\u9a97\u672f\u6709\u66f4\u591a\u53d8\u5316\u3002 2011\u5e74\uff0c\u4ed6\u4e0d\u518d\u6253\u88ab\u52a8\u548c\u9632\u5b88\u7684\u6bd4\u8d5b\uff0c\u800c\u662f\u7a81\u7136\u5f00\u59cb\u6253\u79ef\u6781\u7684\u6bd4\u8d5b\u3002\u4ed6\u7684\u6bd4\u8d5b\u8282\u594f\u4e5f\u66f4\u5feb\u3002<\/p>\n<p>\u622a\u81f3 2011 \u5e74\uff0c\u6211\u4eec\u53ef\u4ee5\u770b\u5230 <em>\u66f4\u5feb\u7684\u6ce8\u5165\u901f\u5ea6<\/em> \u548c <em>\u6b65\u4f10\u7684\u53d8\u5316<\/em> \u5728\u5d07\u4f1f\u7684\u6bd4\u8d5b\u4e2d\u3002<\/p>\n<p>\u4f5c\u4e3a\u9632\u5b88\u578b\u5355\u6253\u7403\u5458\uff0c\u4ed6\u6700\u521d\u7684\u8868\u73b0\u5c31\u50cf\u4e00\u53ea\u201c\u5367\u864e\u85cf\u9f99\u201d\u3002\u4e0d\u4e45\u4e4b\u540e\uff0c\u4ed6\u6539\u53d8\u4e86\u81ea\u5df1\u7684\u98ce\u683c\uff0c\u5728\u6bd4\u8d5b\u4e2d\u52c7\u4e8e\u5192\u9669\uff0c\u66f4\u591a\u5730\u8fdb\u653b\u3002<\/p>\n<p>\u4ee5\u4ed6\u7684\u901f\u5ea6\uff0c\u5bf9\u4ed6\u7684\u5bf9\u624b\u7684\u653b\u51fb\u662f\u6210\u529f\u7684\u3002\u4ed6\u8bbe\u6cd5\u8d85\u8d8a\u4e86\u5bf9\u624b\uff0c\u5e76\u5728\u4ed6\u4eec\u63aa\u624b\u4e0d\u53ca\u7684\u60c5\u51b5\u4e0b\u53d1\u8d77\u8fdb\u653b\u3002<\/p>\n<p>\u674e\u5b97\u4f1f\u73b0\u5728\u662f\u4e00\u4e2a\u8fd1\u4e4e\u5b8c\u7f8e\u7684\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u3002\u6280\u672f\u4e0a\uff0c\u53ea\u6709\u6797\u4e39\u80fd\u6218\u80dc\u4ed6\u3002<\/p>\n<p>\u4f46\u662f\uff0c\u9762\u5bf9\u6797\u4e39\uff0c\u4ed6\u8fd8\u662f\u7f3a\u4e4f\u5e95\u6c14\u3002\u6700\u91cd\u8981\u7684\u662f\uff0c\u5d07\u4f1f\u7684LUCK\u4e5f\u4e8e\u4e8b\u65e0\u8865\u3002\u662f\u7684\uff0c\u8fd0\u6c14\u5728\u4ed6\u4eec\u7684\u76f8\u9047\u4e2d\u53d1\u6325\u4e86\u4f5c\u7528\u3002<\/p>\n<h3>\u4e13\u4e1a<\/h3>\n<p><strong>\u75af\u72c2\u9632\u5fa1<\/strong><br \/>\n\u9a6c\u6765\u897f\u4e9a\u4eba\u4ee5\u5355\u6253\u9632\u5b88\u800c\u95fb\u540d\u3002<\/p>\n<p>\u9664\u975e\u6709\u4eba\u80fd\u6bd4\u4ed6\u79fb\u52a8\u5f97\u66f4\u5feb\uff0c\u5426\u5219\u51e0\u4e4e\u4e0d\u53ef\u80fd\u7a81\u7834\u4ed6\u7684\u9632\u5b88\u3002<\/p>\n<p>\u8fd9\u4e9b\u5929\u7fbd\u6bdb\u7403\u8fd0\u52a8\u7684\u5f3a\u5ea6\u5982\u6b64\u4e4b\u5927\u3002\u4eca\u5929\u7684\u4e16\u754c\u7ea7\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u63a5\u53d7\u8fc7\u8fdb\u653b\u8bad\u7ec3\uff08<em>\u51b2\u5411<\/em>) \u7fbd\u6bdb\u7403\u573a\u5730\u8fb9\u7ebf\u3002\u5f53\u5b8c\u7f8e\u7684\u673a\u4f1a\u51fa\u73b0\u65f6\uff0c\u8bb8\u591a\u5355\u6253\u7403\u5458\u53ef\u4ee5\u5411\u5355\u6253\u8fb9\u7ebf\u8fdb\u884c\u51c6\u786e\u7684\u6263\u7403\u3002<\/p>\n<p>\u7136\u800c\uff0c\u674e\u5b97\u4f1f\u975e\u5e38\u64c5\u957f\u5411\u8fb9\u7ebf\u6251\u6551\u5bf9\u624b\u7684\u6263\u7403\u3002\u674e\u5b97\u4f1f\u662f\u552f\u4e00\u4e00\u4f4d\u80fd\u591f\u8fde\u7eed\u8df3\u6c34\u4e24\u6b21\u7684\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u3002\u6211\u5c06\u5728\u4e0b\u9762\u7684\u89c6\u9891\u4e2d\u5411\u60a8\u5c55\u793a\u6211\u7684\u610f\u601d\u3002<\/p>\n<p>&nbsp;<\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/F2hvT3U7x0w\" width=\"560\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p>&nbsp;<\/p>\n<p><iframe loading=\"lazy\" src=\"http:\/\/www.youtube.com\/embed\/fFITT_uSXgc\" width=\"420\" height=\"315\" frameborder=\"0\" allowfullscreen=\"allowfullscreen\"><\/iframe><\/p>\n<p>\u4e0a\u9762\u7684\u89c6\u9891\u663e\u793a\u4ed6\u8fde\u7eed\u8fdb\u884c\u4e86 2 \u6b21\u7fbd\u6bdb\u7403\u8df3\u6c34\u3002<\/p>\n<p><strong>\u975e\u51e1\u7684\u5e73\u8861\u548c\u6b65\u6cd5<\/strong><br \/>\n\u8fd9\u662f <em>\u666e\u901a\u7684<\/em> \u89c2\u770b\u4e16\u754c\u7ea7\u7403\u5458\u8df3\u6c34\u62a2\u56de\u5bf9\u624b\u7684\u6263\u7403\u3002<\/p>\n<p>\u4f46\u662f\uff0c\u5411\u8fb9\u7ebf\u4fef\u51b2\u7684\u540e\u679c\u5c31\u662f\u4fef\u51b2\u4f1a\u8ba9\u4ed6\u4eec\u5931\u53bb\u9ad8\u5ea6\u7684\u5e73\u8861\u3002\u8fd9\u8ba9\u4ed6\u4eec\u66f4\u96be\u56de\u5230\u4f4d\u7f6e\u6765\u9632\u5b88\u4e0b\u4e00\u6b21\u6295\u7bee\u3002<\/p>\n<p>\u674e\u5b97\u4f1f\u662f <em>\u4ec5\u6709\u7684<\/em> \u8fc4\u4eca\u4e3a\u6b62\u53ef\u4ee5\u6267\u884c 2 \u6b21\u6f5c\u6c34\u4ee5\u68c0\u7d22 2 \u6b21\u8fde\u7eed\u51fb\u7403\u7684\u4eba\u3002\u5728\u8fdb\u884c\u4e00\u6b21\u4fef\u51b2\u540e\uff0c\u4ed6\u5f88\u5feb\u5c31\u53ef\u4ee5\u7ad9\u8d77\u6765\u5e76\u56de\u5230\u4ed6\u7684\u6b65\u6cd5\u57fa\u7840\u4e0a\u3002<\/p>\n<p>\u60a8\u9700\u8981\u9ad8\u6c34\u5e73\u7684\u5065\u8eab\u548c\u7075\u6d3b\u7684\u52a8\u4f5c\u624d\u80fd\u505a\u5230\u8fd9\u4e00\u70b9\uff01<\/p>\n<p><strong>\u8b66\u89c9\u6027\u548c\u53cd\u5e94<\/strong><br \/>\n\u9664\u4e86\u8df3\u6c34\u62a2\u56de\u6263\u7403\u5916\uff0c\u674e\u5b97\u4f1f\u7684\u5feb\u901f\u53cd\u5e94\u4ee4\u4eba\u60ca\u53f9\u3002\u4e0b\u9762\u7684\u89c6\u9891\u5c55\u793a\u4e86\u4ed6\u7684\u7fbd\u6bdb\u7403\u9632\u5b88\u7684\u4e00\u4e9b\u4f8b\u5b50\u3002<\/p>\n<p>&nbsp;<\/p>\n<p><iframe loading=\"lazy\" src=\"http: