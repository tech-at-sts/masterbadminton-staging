\u3002\u7ef4\u514b\u6258\u00b7\u5b89\u8d5b\u9f99\u5728\u4e09\u573a\u6bd4\u8d5b\u4e2d\u51fb\u8d25\u4e86\u9676\u83f2\u514b\u00b7\u5e0c\u8fbe\u4e9a\u7279\uff01<\/p>\n<h3>\u9676\u83f2\u514b\u7ecf\u5386\u4e86\u8270\u96be\u7684\u4e00\u5e74<\/h3>\n<p>\u9676\u83f2\u514b\u5728\u9526\u6807\u8d5b\u4e0a\u7684\u8868\u73b0\u5e76\u4e0d\u597d\uff0c\u56e0\u4e3a\u4ed6\u4ece\u672a\u8d62\u5f97\u8fc7\u8d85\u7ea7\u7cfb\u5217\u8d5b\u51a0\u519b\u3002<\/p>\n<p>\u4ed6\u8d70\u5f97\u6700\u8fdc\u7684\u662f\u4eca\u5e74\u5e74\u521d\u76842011\u5e74\u9a6c\u6765\u897f\u4e9a\u516c\u5f00\u8d5b\u51b3\u8d5b\uff0c\u51a0\u519b\u88ab\u516d\u5c4a\u536b\u5195\u51a0\u519b\u674e\u5b97\u4f1f\u593a\u5f97\u3002<\/p>\n<p>2011\u5e74\u5370\u5ea6\u5c3c\u897f\u4e9a\u8d85\u7ea7\u7cfb\u5217\u8d5b\u5728\u9676\u83f2\u514b\u7684\u7956\u56fd\u4e3e\u884c\u671f\u95f4\uff0c\u4eba\u4eec\u7edd\u5bf9\u671f\u5f85\u8fd9\u4f4d\u524d\u4e16\u754c\u51a0\u519b\u548c\u5965\u8fd0\u4f1a\u51a0\u519b\u80fd\u591f\u83b7\u80dc\u3002\u4f46\u4ed6\u6ca1\u80fd\u8fdb\u5165\u534a\u51b3\u8d5b\u3002<\/p>\n<p>2011\u5e74\u5728\u4f26\u6566\u4e3e\u884c\u7684\u7fbd\u6bdb\u7403\u4e16\u9526\u8d5b\u4e0a\uff0c\u9676\u83f2\u514b\u5728\u65e9\u671f\u6bd4\u8d5b\u4e2d\u5c31\u88ab\u6765\u81ea\u65b0\u52a0\u5761\u7684\u975e\u79cd\u5b50\u9009\u624b\u9ec4\u5fb7\u91cc\u514b\u51fb\u8d25\u3002<\/p>\n<p>\u6211\u8ba4\u4e3a\u4e3b\u8981\u95ee\u9898\u662f\u9676\u83f2\u514b\u7684\u5e74\u9f84\u3002\u968f\u7740\u4ed6\u63a5\u8fd1\u9000\u4f11\uff0c\u4e0e\u66f4\u5e74\u8f7b\u3001\u66f4\u654f\u6377\u7684\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u7ade\u4e89\u53d8\u5f97\u66f4\u52a0\u56f0\u96be\u3002<\/p>\n<p>\u81f3\u4e8e\u7ef4\u514b\u6258\u00b7\u5b89\u8d5b\u9f99\uff0c\u4ed6\u662f\u524d\u4e16\u754c\u7fbd\u8054\u4e16\u754c\u9752\u5e74\u9526\u6807\u8d5b\u51a0\u519b\uff0c\u4e5f\u662f\u552f\u4e00\u4e00\u4f4d\u8d62\u5f97\u4e16\u754c\u9752\u5e74\u9526\u6807\u8d5b\u51a0\u519b\u7684\u6b27\u6d32\u9752\u5c11\u5e74\u5355\u6253\u9009\u624b\u3002 2011\u5e74\u4ed6\u624d17\u5c81\uff01<\/p>\n<p>\u81ea2011\u5e74\u7fbd\u6bdb\u7403\u4e16\u9526\u8d5b\u4ee5\u6765\uff0c\u9676\u83f2\u514b\u7f3a\u5e2d\u4e86\u591a\u573a\u8d85\u7ea7\u7cfb\u5217\u8d5b\uff0c\u76f4\u52302011\u5e74\u5c24\u5c3c\u514b\u65af\u4e39\u9ea6\u516c\u5f00\u8d5b\uff0c\u4ed6\u51b3\u5b9a\u91cd\u8fd4\u7fbd\u6bdb\u7403\u8d5b\u573a\u3002<\/p>\n<h3>\u53ef\u518d\u751f\u80fd\u6e90<\/h3>\n<p>\u9676\u83f2\u514b\u51b3\u5fc3\u8d62\u5f97\u8fd9\u573a\u6bd4\u8d5b\u3002\u5728\u4f26\u6566\u4e16\u9526\u8d5b\u4e4b\u524d\uff0c\u9676\u83f2\u514b\u5728\u5927\u591a\u6570\u6bd4\u8d5b\u4e2d\u90fd\u7f3a\u4e4f\u6d3b\u529b\u548c\u654f\u6377\u3002<\/p>\n<p>\u5728\u51b3\u5b9a\u4f11\u606f\u7136\u540e\u91cd\u8fd4\u7fbd\u6bdb\u7403\u4e4b\u540e\uff0c\u6211\u4eec\u770b\u5230\u4e86\u4ed6\u66f4\u591a\u7684\u80fd\u91cf\u3002\u4ed6\u6253\u7403\u7684\u8282\u594f\u66f4\u5feb\u4e86\u3002\u5728\u8fd9\u573a\u6bd4\u8d5b\u4e2d\uff0c\u9676\u83f2\u514b\u7684\u8868\u73b0\u5c31\u50cf\u4ed6\u201c\u56de\u5230\u8fc7\u53bb\u201d\u4e00\u6837\uff0c\u5f53\u65f6\u4ed6\u66f4\u5e74\u8f7b\uff0c\u901f\u5ea6\u66f4\u5feb\u3002<\/p>\n<p>\u8fd9\u624d\u662f\u6211\u4eec\u6240\u671f\u5f85\u7684\u5965\u8fd0\u51a0\u519b\u7684\u8868\u73b0\uff01<\/p>\n<p>\u6bd4\u8d5b\u4e00\u5f00\u59cb\uff0c\u9676\u83f2\u514b\u5c31\u5411\u7ef4\u514b\u6258\u5f00\u51fa\u4e86\u653b\u51fb\u6027\u7684\u5c04\u95e8\u3002<\/p>\n<p>\u4ed6\u6269\u5927\u4e86\u6bd4\u5206\u5dee\u8ddd\u3002\u770b\u8d77\u6765\u9676\u83f2\u514b\u5c06\u8d62\u5f97\u8fd9\u573a\u6bd4\u8d5b\u5e76\u8fdb\u5165\u56db\u5206\u4e4b\u4e00\u51b3\u8d5b\u3002<\/p>\n<p>\u6bd4\u8d5b\u4e00\u5f00\u59cb\uff0c\u9676\u83f2\u514b\u5c31\u8fc5\u901f\u7ed3\u675f\u4e86\u5bf9\u5cd9\u3002<\/p>\n<h3>\u7ef4\u514b\u6258\u95ea\u8000<\/h3>\n<p>\u4f46\u4e00\u65e6\u7ef4\u514b\u6258\u5728\u7fbd\u6bdb\u7403\u573a\u4e0a\u627e\u5230\u4e86\u81ea\u5df1\u7684\u8282\u594f\uff0c\u4ed6\u5c31\u662f\u4e00\u5934\u771f\u6b63\u7684\u91ce\u517d\uff01<\/p>\n<p>\u6700\u7cbe\u5f69\u7684\u90e8\u5206\u662f\u7ef4\u514b\u6258\u51fa\u8272\u7684\u65cb\u8f6c\u7f51\u7403\u3002\u9676\u83f2\u514b\u5728\u7f51\u524d\u6839\u672c\u4e0d\u662f\u7ef4\u514b\u6258\u7684\u5bf9\u624b\u3002\u7ef4\u514b\u591a\u5371\u9669\u7684\u7f51\u524d\u6280\u5de7\u6467\u6bc1\u4e86\u9676\u83f2\u514b\u7684\u4fe1\u5fc3\u3002<\/p>\n<p>\u4ece\u7403\u573a\u540e\u9762\u6765\u770b\uff0c\u7ef4\u514b\u591a\u4e5f\u662f\u4e00\u4e2a\u5a01\u80c1\u3002\u4ed6\u975e\u5e38\u9ad8\uff08188 \u5398\u7c73\uff09\u3002<\/p>\n<p>\u4ed6\u5f88\u806a\u660e\u5730\u5229\u7528\u4e86\u81ea\u5df1\u7684\u8eab\u9ad8\u4f18\u52bf\u3002\u8fd9\u4f7f\u5f97\u81f4\u547d\u7684\u540a\u7403\u548c\u5267\u70c8\u7684\u7c89\u788e\u6210\u4e3a\u53ef\u80fd\u3002<\/p>\n<p>\u83b7\u80dc\u7684\u52bf\u5934\u8f6c\u79fb\u5230\u4e86\u5e74\u8f7b\u7684\u9752\u5c11\u5e74\u4e16\u754c\u51a0\u519b\u8eab\u4e0a\u3002\u8bf7\u5bc6\u5207\u5173\u6ce8\u7ef4\u514b\u6258\u5728\u7f51\u524d\u7684\u8868\u73b0\u3002<\/p>\n<p>\u5230\u76ee\u524d\u4e3a\u6b62\uff0c\u6211\u8ba4\u4e3a\u7ef4\u514b\u6258\u662f\u4e16\u754c\u4e0a\u6700\u597d\u7684\u7f51\u524d\u6295\u7bee\u624b\u4e4b\u4e00\u3002<\/p>\n<p><a href=\"\/zh\/osim-bwf-world-superseries-event-2011-season-review.html\/\">OSIM BWF \u4e16\u754c\u8d85\u7ea7\u7cfb\u5217\u8d5b 2011 \u5e74\u603b\u7ed3\u548c\u8d5b\u5b63\u56de\u987e<\/a><\/p>\n<div class=\"retnvbx1\"><\/div>\n<div class=\"fb-comments-intro-ns\">\n<div class=\"retnvbx\"><\/div>\n<h3><span class=\"teelmeww\">\u544a\u8bc9\u6211\u4f60\u7684\u60f3\u6cd5\uff01<\/span><\/h3>\n<p>\u4f60\u5bf9\u521a\u521a\u8bfb\u5230\u7684\u5185\u5bb9\u6709\u4f55\u770b\u6cd5\uff1f\u5728\u4e0b\u9762\u7ed9\u6211\u7559\u8a00\u3002<\/p>\n<\/div>\n<div id=\"COMMENTING\" class=\"fb-comment\">\n<div class=\"fb-comments\" data-href=\"http:\/\/www.how-to-play-badminton.com\/yonex-denmark-open-2011-Round2-taufikhidayat-viktoraxelsen.html\" data-num-posts=\"15\" data-width=\"100%\"><\/div>\n<h3 class=\"fblikeste\">\u559c\u6b22 Masterbadminton.com\uff1f<\/h3>\n<p>&nbsp;<\/p>\n<div id=\"fb-root\"><\/div>\n<p><script><![CDATA[\n(function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(d.getE