e0\u4e2a\u3002\u4f46\u5bf9\u4e8e\u6211\u5728\u5965\u8fd0\u4f1a\u4e0a\u7684\u6311\u6218\u6765\u8bf4\uff0c\u8fd9\u5f88\u96be\u8bf4\uff0c\u56e0\u4e3a\u5965\u8fd0\u4f1a\u671f\u95f4\u4f1a\u6709\u5f88\u5927\u7684\u538b\u529b\u3002\u4f60\u6c38\u8fdc\u4e0d\u4f1a\u6839\u636e\u5386\u53f2\u8868\u73b0\u6765\u9884\u6d4b\u8c01\u4f1a\u771f\u6b63\u8d62\u5f97\u5965\u8fd0\u4f1a\uff0c\u56e0\u4e3a\u4f60\u8fd8\u9700\u8981\u8003\u8651\u5f88\u591a\u56e0\u7d20\u3002\u538b\u529b\u5c31\u662f\u5176\u4e2d\u4e4b\u4e00\u3002<\/p>\n<p><strong>3.\u4f60\u73b0\u5728\u7684\u6559\u7ec3\u662f\u8c01\uff1f<\/strong><br \/>\n\u8fd8\u662f\u4e00\u6837\u7684\uff0c <strong>\u7a46\u5c14\u7ea6<\/strong>\u3002\u6211\u7684\u6559\u7ec3\u59cb\u7ec8\u662f\u540c\u4e00\u4e2a\u4eba\u3002\u5373\u4f7f\u76f4\u5230\u6211\u9000\u5f79\uff0c\u4ed6\u4ecd\u7136\u4f1a\u62c5\u4efb\u6559\u7ec3\u3002<\/p>\n<p><strong>4. \u60a8\u6253\u7b97\u4ec0\u4e48\u65f6\u5019\u9000\u4f11\uff1f<\/strong><br \/>\n\u4efb\u4f55\u65f6\u5019\u6211\u613f\u610f\u3002\u660e\u5929\uff0c\u540e\u5929\uff0c\u4e5f\u8bb8\u4e0b\u5468\uff1f \uff08\u9676\u83f2\u514b\u5f00\u73a9\u7b11\u5730\u8bf4\uff09<\/p>\n<p>\u53cd\u6b63\u5728\u6211\u4e4b\u540e\u5370\u5c3c\u8fd8\u6ca1\u6709\u4f18\u79c0\u7684\u5355\u6253\u9009\u624b\u3002\u9a6c\u6765\u897f\u4e9a\u4e5f\u662f\u5982\u6b64\u3002\u674e\u5b97\u4f1f\u9000\u5f79\u540e\uff0c\u6211\u8ba4\u4e3a\u76ee\u524d\u6ca1\u6709\u4efb\u4f55\u9a6c\u6765\u897f\u4e9a\u5355\u6253\u9009\u624b\u80fd\u591f\u95ef\u8fc7\u6bd4\u8d5b\u3002\u5370\u5ea6\u5c3c\u897f\u4e9a\u4e5f\u662f\u5982\u6b64\u3002<\/p>\n<p><strong>5. \u8003\u8651\u5230\u4f60\u53bb\u5e74\u7684\u8868\u73b0\uff0c\u4f60\u8ba4\u4e3a\u4f60\u9700\u8981\u5728\u54ea\u4e9b\u65b9\u9762\u8fdb\u884c\u6539\u8fdb\u624d\u80fd\u81f3\u5c11\u5728 2012 \u5e74\u4f26\u6566\u5965\u8fd0\u4f1a\u4e0a\u83b7\u5f97\u4e00\u679a\u5956\u724c\uff1f<\/strong><br \/>\n\u5176\u5b9e\u6211\u5bf9\u81ea\u5df1\u7684\u5965\u8fd0\u4f1a\u8fd8\u662f\u5f88\u6709\u4fe1\u5fc3\u7684\u3002<\/p>\n<p><strong>6. \u5c31 2012 \u5e