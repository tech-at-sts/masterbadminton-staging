vent-program.html\/#highlights\">\u521d\u6b65\u8981\u70b9\u548c\u6709\u8da3\u7684\u4e8b\u5b9e<\/a><br \/>\n<a href=\"\/zh\/yonex-australia-event-program.html\/#prize\">\u5956\u91d1\u548c\u9526\u6807\u8d5b<\/a><br \/>\n<a href=\"\/zh\/yonex-australia-event-program.html\/#winners\">\u5386\u5c4a\u83b7\u5956\u8005<\/a><br \/>\n<a href=\"\/zh\/yonex-australia-event-program.html\/#sponsors\">\u8d5e\u52a9\u5546\u548c\u652f\u6301\u8005<\/a><\/p>\n<p><a name=\"start\"><\/a><\/p>\n<h2>\u5f00\u59cb\u65f6\u95f4<\/h2>\n<p>\u6bd4\u8d5b\u5c06\u4e8e2011\u5e744\u67085\u65e5\u81f310\u65e5\uff08\u5468\u4e8c\u81f3\u5468\u65e5\uff09\u4e3e\u884c\u3002\u6d3b\u52a8\u65e5\u7a0b\u4e3a\uff1a<\/p>\n<p>\u5468\u4e8c\uff1a\u8d44\u683c\u8d5b\uff08\u4e0a\u5348 8:30 \u5f00\u59cb\uff09<br \/>\n\u5468\u4e09\uff1a\u7b2c\u4e00\u8f6e\uff08\u4e0a\u5348 9 \u70b9\u5f00\u59cb\uff09<br \/>\n\u5468\u56db\uff1a\u7b2c\u4e8c\u8f6e\uff08\u4e0a\u5348 9 \u70b9\u5f00\u59cb\uff09<br \/>\n\u5468\u4e94\uff1a\u56db\u5206\u4e4b\u4e00\u51b3\u8d5b\uff08\u4e0b\u5348 5:30 \u5f00\u59cb\uff09<br \/>\n\u5468\u516d\uff1a\u534a\u51b3\u8d5b\uff08\u4e0b\u5348 3 \u70b9\u5f00\u59cb\uff09<br \/>\n\u5468\u65e5\uff1a\u51b3\u8d5b\uff08\u4e0b\u5348 3 \u70b9\u5f00\u59cb\uff09<\/p>\n<p>\u7fbd\u6bdb\u7403\u7231\u597d\u8005\u4e0d\u5e94\u9519\u8fc7\u5468\u4e94\u89c2\u770b\u56db\u5206\u4e4b\u4e00\u51b3\u8d5b\u7684\u673a\u4f1a\u3002\u7ec4\u7ec7\u8005\u4e5f\u4e3a\u52b3\u52a8\u4eba\u6c11\u63d0\u4f9b\u4e86\u4fbf\u5229\u3002\u4e3a\u4ec0\u4e48\u4e0d\u5728\u5468\u4e94\u665a\u4e0a\u89c2\u770b\u4e16\u754c\u9876\u7ea7\u9009\u624b\u4e4b\u95f4\u7684\u73b0\u573a\u7fbd\u6bdb\u7403\u9526\u6807\u8d5b\u5462\uff1f<\/p>\n<p><a name=\"location\"><\/a><\/p>\n<h2>\u5730\u70b9<\/h2>\n<p>2011 \u5e74\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u5c06\u5728\u58a8\u5c14\u672c\u4f53\u80b2\u548c\u6c34\u4e0a\u8fd0\u52a8\u4e2d\u5fc3 (MSAC) \u4e3e\u884c\u3002<\/p>\n<p><a name=\"preview\"><\/a><\/p>\n<h2>\u90e8\u5206\u7cbe\u82f1\u73a9\u5bb6\u9884\u89c8<\/h2>\n<p>\u4eca\u5e74\u7684\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u975e\u5e38\u7279\u522b\u3002\u591a\u540d\u4e16\u754c\u7ea7\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\u5c06\u89d2\u9010\u51a0\u519b\u5934\u8854\u3002<\/p>\n<p><strong>\u7d22\u5c3c\u00b7\u5fb7\u7ef4\u00b7\u6606\u79d1\u7f57<\/strong> \u591a\u5e74\u6765\u8d62\u5f97\u4e86\u4e00\u5b9a\u7a0b\u5ea6\u7684\u5c0a\u91cd\uff0c\u4eca\u5e74\u5f88\u6709\u673a\u4f1a\u8d62\u5f97\u51a0\u519b\u3002\u6765\u81ea\u5370\u5ea6\u5c3c\u897f\u4e9a\uff0c\u7fbd\u6bdb\u7403\u4f20\u5947\u4eba\u7269\u4f0a\u5e93\u514b\u00b7\u82cf\u5409\u4e9a\u6258 (Icuk Sugiarto) \u7684\u513f\u5b50\uff0c <strong>\u6c64\u7c73\u00b7\u82cf\u5409\u4e9a\u6258<\/strong>\uff0c\u4e5f\u5c06\u53c2\u52a0\u6bd4\u8d5b\u3002<\/p>\n<p>2\u6b21\u82f1\u8054\u90a6\u8fd0\u52a8\u4f1a\u91d1\u724c\u5f97\u4e3b\u548c2003\u5e74\u5168\u82f1\u8d5b\u51a0\u519b <strong>\u83ab\u54c8\u672b\u54c8\u83f2\u5179\u54c8\u5e0c\u59c6<\/strong> \uff08MAS\uff09\u4eca\u5e74\u4e5f\u5c06\u4e89\u593a\u5927\u5956\u8d5b\u91d1\u724c\u3002<\/p>\n<p>\u53e6\u4e00\u4f4d\u82f1\u8054\u90a6\u8fd0\u52a8\u4f1a\u91d1\u724c\u5f97\u4e3b\u3001\u524d\u4e16\u754c\u6392\u540d\u7b2c\u4e8c <strong>\u9ec4\u7efc\u7ff0<\/strong> \u6765\u81ea\u9a6c\u6765\u897f\u4e9a\u7684\u9009\u624b\u4e5f\u5c06\u53c2\u52a0\u672c\u6b21\u6bd4\u8d5b\u3002\u8fd9\u4f4d\u7cbe\u82f1\u7403\u5458\u662f\u7fbd\u6bdb\u7403\u4f20\u5947\u4eba\u7269\u97e9\u5065\u7684\u5f92\u5f1f\u3002 Choong Hann\u662f90\u5e74\u4ee3\u672b\u548c2000\u5e74\u521d\u7684\u5386\u53f2\u4f1f\u4eba\u3002\u4ee5\u4ed6\u76ee\u524d\u7684\u5e74\u9f84\uff0c\u4ed6\u5e94\u8be5\u88ab\u89c6\u4e3a\u9000\u5f79\u7403\u5458\u3002\u7136\u800c\uff0c\u4ed6\u5728 2006 \u5e74\u58a8\u5c14\u672c\u82f1\u8054\u90a6\u8fd0\u52a8\u4f1a\u4e0a\u8d62\u5f97\u4e86\u91d1\u724c\u3002\u4eca\u5e74\u4ed6\u80fd\u518d\u6b21\u5728\u8fd9\u91cc\u8d62\u5f97\u6bd4\u8d5b\u5417\uff1f<\/p>\n<p>\u9664\u6b64\u4e4b\u5916\uff0c\u76ee\u524d\u4e16\u754c\u6392\u540d\u7b2c\u56db <strong>\u5e03\u8428\u84ec\u8428\u7eb3<\/strong> \u6cf0\u56fd\u961f\u6709\u671b\u8fdb\u5165\u51b3\u8d5b\u3002\u73b0\u4efb\u5973\u5b50\u4e16\u754c\u51a0\u519b <strong>\u738b\u6797<\/strong> \u4e5f\u662f\u6765\u4e89\u593a\u6fb3\u5927\u5229\u4e9a\u51a0\u519b\u7684\u3002\u66f4\u4e0d\u7528\u8bf4\u53bb\u5e74\u7684\u536b\u5195\u51a0\u519b <strong>\u962e\u8fdb\u660e<\/strong> \u5c06\u51c6\u5907\u597d\u634d\u536b\u4ed6\u7684\u6fb3\u5927\u5229\u4e9a\u51a0\u519b\u5934\u8854\uff01<\/p>\n<p><a name=\"highlights\"><\/a><\/p>\n<h2>\u521d\u6b65\u8981\u70b9\u548c\u6709\u8da3\u7684\u4e8b\u5b9e<\/h2>\n<p>\u4eca\u5e74\u7684\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u5347\u7ea7\u4e3a\u66f4\u9ad8\u7ea7\u522b\u7684\u8d5b\u4e8b\u3002\u4f17\u591a\u4e16\u754c\u7ea7\u9009\u624b\u5c06\u5728\u6fb3\u5927\u5229\u4e9a\u58a8\u5c14\u672c\u4e89\u593a\u5927\u5956\u8d5b\u91d1\u724c\u3002<\/p>\n<p>\u5728\u7b2c\u4e00\u8f6e\uff084 \u6708 9 \u65e5\u661f\u671f\u4e09\uff09\u4e2d\uff0c2010 \u5e74\u536b\u5195\u51a0\u519b\u5c06\u5bf9\u9635 2010 \u5e74\u4e9a\u519b\u5c24\u6839\u5fb7\u5170\u00b7\u514b\u91cc\u5e0c\u5357 (Yogendran Krishnan)\u3002\u8fd9\u4e24\u4f4d\u53bb\u5e74\u95ef\u5165\u51b3\u8d5b\u7684\u9009\u624b\uff0c\u4eca\u5e74\u5c06\u5728 <em>\u7b2c\u4e00\u56de\u5408<\/em> \u8fd9\u4e2a\u5b63\u8282\u7684\uff01<\/p>\n<p>\u5176\u4e2d\u4e00\u4eba\u5c06\u5728\u7b2c\u4e00\u8f6e\u88ab\u6dd8\u6c70\uff0c\u4f1a\u662f\u8c01\u5462\uff1f\u4eca\u5e74\u7684\u51a0\u519b\u4e4b\u8def\u5bf9\u4ed6\u4eec\u6765\u8bf4\u90fd\u6709\u4e9b\u56f0\u96be\uff0c\u56e0\u4e3a\u50cf Boonsak Ponsana\u3001Sony Dwi Kuncoro \u548c Wong Choong Hann \u8fd9\u6837\u7684\u9009\u624b\u7edd\u5bf9\u662f\u5f3a\u6709\u529b\u7684\u7ade\u4e89\u8005\u3002<\/p>\n<p>\u73b0\u4efbWS\u7fbd\u6bdb\u7403\u4e16\u754c\u51a0\u519b\u738b\u7433\u4e5f\u5c06\u53c2\u52a0\u4eca\u5e74\u7684\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u3002\u8003\u8651\u5230\u5979\u521a\u521a\u4ece2010\u5e74\u4e2d\u56fd\u5927\u5e08\u8d5b\u671f\u95f4\u97e7\u5e26\u65ad\u88c2\u7684\u819d\u4f24\u4e2d\u6062\u590d\u8fc7\u6765\uff0c\u6211\u4eec\u662f\u5426\u80fd\u591f\u89c1\u8bc1\u5979\u6700\u597d\u7684\u72b6\u6001\u8fd8\u4e0d\u786e\u5b9a\uff0c\u4f46\u5979\u53ef\u80fd\u4f1a\u7ed9\u6211\u4eec\u5e26\u6765\u60ca\u559c\uff0c\u53ea\u6709\u65f6\u95f4\u624d\u80fd\u8bc1\u660e\u4e00\u5207\u3002<\/p>\n<p>\u81ea\u4ece\u738b\u7433\u56e0\u819d\u4f24\u957f\u671f\u4f11\u606f\u4ee5\u6765\uff0c\u5979\u7684\u4e16\u754c\u7fbd\u8054\u4e16\u754c\u6392\u540d\u4e5f\u51fa\u73b0\u4e86\u5927\u5e45\u4e0b\u6ed1\u3002\u56e0\u6b64\uff0c\u5979\u5c06\u88ab\u8981\u6c42\u53c2\u52a0\u5468\u4e8c\uff084\u67085\u65e5\uff09\u7684\u8d44\u683c\u8d5b\uff0c\u5bf9\u624b\u662f\u4e2d\u534e\u53f0\u5317\u9009\u624b\u90d1\u742a\u96c5\u3002<\/p>\n<p>\u5373\u4f7f\u5728\u8d44\u683c\u8d5b\u4e2d\u83b7\u80dc\uff0c\u5bf9\u4e8e\u738b\u7433\u6765\u8bf4\uff0c\u8fd9\u4e5f\u662f\u4e00\u6761\u8270\u96be\u7684\u8def\uff0c\u56e0\u4e3a\u5979\u5c06\u9762\u4e34\u5218\u946b\uff08<em>\u76ee\u524d\u672c\u6b21\u8d5b\u4e8b\u4e16\u754c\u7fbd\u8054\u4e16\u754c\u6392\u540d\u6700\u9ad8\u7684\u7403\u5458<\/em>\uff09\u5468\u56db\uff084\u67087\u65e5\uff09\u4e2d\u56fd\u3002<\/p>\n<p>&nbsp;<\/p>\n<p><a name=\"prize\"><\/a><\/p>\n<h2>\u5956\u91d1\u548c\u9526\u6807\u8d5b<\/h2>\n<p>\u4eca\u5e74\uff0c\u5c24\u5c3c\u514b\u65af\u6fb3\u5927\u5229\u4e9a\u516c\u5f00\u8d5b\u5347\u7ea7\u4e3a\u66f4\u9ad8\u7ea7\u522b\u2014\u2014\u5927\u5956\u8d5b\u9ec4\u91d1\u8d5b\u3002\u4e0e\u5f80\u5e74\u76f8\u6bd4\uff0c\u4eca\u5e74\u8d5b\u4e8b\u7684\u8d5e\u52a9\u5956\u91d1\u66f4\u591a\u3002\u5e78\u8fd0\u7684\u662f\uff0c\u8fd9\u6807\u5fd7\u7740\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5728\u6fb3\u5927\u5229\u4e9a\u8d8a\u6765\u8d8a\u53d7\u6b22\u8fce\u3002<\/p>\n<p><em>\u603b\u5956\u91d1\u4e3a12\u4e07\u7f8e\u5143<\/em>.<\/p>\n<p>\u8fd9\u7b14\u91d1\u989d\u5c06\u6839\u636e\u4e16\u754c\u7fbd\u8054\u5b98\u65b9\u89c4\u5b9a\u5206\u914d\u7ed9 5 \u4e2a\u9879\u76ee\uff08MS\u3001WS\u3001MD\u3001WD \u548c XD\uff09\u3002<\/p>\n<p><a name=\"winners\"><\/a><\/p>\n<h2>\u5386\u5c4a\u83b7\u5956\u8005\uff082010 \u5e74\u5927\u5956\u8d5b\uff09\u2014\u2014\u7b2c\u4e00\u540d\u548c\u7b2c\u4e8c\u540d<\/h2>\n<p><strong>\u7537\u5b50\u5355\u6253<\/strong><br \/>\n1. \u962e\u8fdb\u660e\uff08\u8d8a\u5357\uff09<br \/>\n2. \u7ea6\u6839\u5fb7\u5170\u00b7\u514b\u91cc\u5e0c\u5357 (MAS)<\/p>\n<p><strong>\u7537\u5b50\u53cc\u6253<\/strong><br \/>\n1. \u8fdc\u85e4\u535a\u4e4b\/\u65e9\u5ddd\u5065\u4e00\uff08\u65e5\u672c\uff09<br \/>\n2. Kang Woo Kyum\/Park Tae Sang\uff08\u97e9\u56fd\uff09<\/p>\n<p><strong>\u5973\u5b50\u5355\u6253<\/strong><br \/>\n1.\u5f90\u6da6\u7199\uff08\u97e9\u56fd\uff09<br \/>\n2. \u4e09\u8c37\u7f8e\u590f (\u65e5\u672c)<\/p>\n<p><strong>\u5973\u5b50\u53cc\u6253<\/strong><br \/>\n1. \u91d1\u73c9\u745e\/\u674e\u4eac\u5143\uff08\u97e9\u56fd\uff09<br \/>\n2. \u59dc\u6d77\u5a9b\/\u5f90\u5141\u7199\uff08\u97e9\u56fd\uff09<\/p>\n<p><strong>\u6df7\u53cc<\/strong><br \/>\n1. \u66f9\u5efa\u5b87\/\u91d1\u73c9\u745e\uff08\u97e9\u56fd\uff09<br \/>\n2. \u5c0f\u5bab\u5c71\u8087\/\u9ebb\u539f\u5c0f\u767e\u5408\uff08\u65e5\u672c\uff09<\/p>\n<p><a name=\"sponsors\"><\/a><\/p>\n<h2>\u8d5e\u52a9\u5546\u548c\u652f\u6301\u8005<\/h2>\n<p><strong>\u4e3b\u8981\u8d5e\u52a9\u5546\uff1a<\/strong><br \/>\n\u5c24\u5c3c\u514b\u65af<\/p>\n<p><strong>\u5176\u4ed6\u8d5e\u52a9\u5546\uff1a <\/strong><br \/>\n\u7ef4\u591a\u5229\u4e9a\u5dde\u653f\u5e9c<\/p>\n<p><strong>\u4f19\u4f34\uff1a <\/strong><br \/>\n\u6fb3\u5927\u5229\u4e9a\u4f53\u80b2\u59d4\u5458\u4f1a\uff0c\u58a8\u5c14\u672c\u8bfa\u5bcc\u7279\u9152\u5e97<\/p>\n<p><strong>\u4e3b\u529e\u5355\u4f4d\uff1a <\/strong><br \/>\n\u7ef4\u591a\u5229\u4e9a\u7fbd\u6bdb\u7403, \u6fb3\u5927\u5229\u4e9a\u7fbd\u6bdb\u7403<\/p>\n<p><strong>\u5236\u88c1\u8005\uff1a <\/strong><br \/>\n\u4e16\u754c\u7fbd\u6bdb\u7403\u8054\u5408\u4f1a\uff08BWF\uff09\uff0c\u5927\u6d0b\u6d32\u7fbd\u6bdb\u7403\u3002<\/p>\n<p><strong>\u5730\u70b9\uff1a <\/strong><br \/>\n\u58a8\u5c14\u672c\u4f53\u80b2\u548c\u6c34\u4e0a\u8fd0\u52a8\u4e2d\u5fc3 (MSAC)<\/p>\n<p>\u5982\u9700\u8ba2\u7968\uff0c\u8bf7\u81f4\u7535 <strong>+61 3 9686 4777<\/strong> \u6216\u4f20\u771f +61 3 9686 6999\u3002<\/p>\n<p>&nbsp;<\/p>\n<h3>\u6d3b\u52a8\u73b0\u573a\u56fe\u7247<\/h3>\n<p>&nbsp;<\/p>\n<p>\u4e0b\u56fe\u4e3a2011\u5e74\u6fb3\u5927\u5229\u4e9a\u7f51\u7403\u516c\u5f00\u8d5b\u7684\u573a\u9986\u5e03\u7f6e\u3002\u90e8\u5206\u56fd\u5bb6\u961f\u6b63\u5728\u6bd4\u8d5b\u573a\u5730\u8fdb\u884c\u8bad\u7ec3\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/yonex-open1.jpg\" alt=\"Yonex Australia Open\" width=\"400\" height=\"266\" \/><\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/yonex-open2.jpg\" alt=\"Yonex Australia Open\" width=\"400\" height=\"266\" \/><\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/yonex-open3.jpg\" alt=\"Yonex Australia Open\" width=\"400\" height=\"266\" \/><\/p>\n<div class=\"retnvbx1\"><\/div>\n<div class=\"fb-comments-intro-ns\">\n<div class=\"retnvbx\"><\/div>\n<h3><span class=\"teelmeww\">\u544a\u8bc9\u6211\u4f60\u7684\u60f3\u6cd5\uff01<\/span><\/h3>\n<p>\u4f60\u5bf9\u521a\u521a\u8bfb\u5230\u7684\u5185\u5bb9\u6709\u4f55\u770b\u6cd5\uff1f\u5728\u4e0b\u9762\u7ed9\u6211\u7559\u8a00\u3002<\/p>\n<\/div>\n<div id=\"COMMENTING\" class=\"fb-comment\">\n<div class=\"fb-comments\" data-href=\"http:\/\/www.how-to-play-badminton.com\/yonex-australia-event-program.html\" data-num-posts=\"15\" data-width=\"100%\"><\/div>\n<h3 class=\"fblikeste\">\u559c\u6b22 Masterbadminton.com\uff1f<\/h3>\n<p>&nbsp;<\/p>\n<div id=\"fb-root\"><\/div>\n<p><script><![CDATA[\n(function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(d.getElementById(id)){return;}js=d.createElement(s);js.id=id;js.src=\"..\/connect.facebook.net\/en_US\/all.js#xfbml=1\";fjs.parentNode.insertBefore(js,fjs);}(document,'script','facebook-jssdk'));\n><\/script>\n\n\n<div align=\"left\"><\/div>\n\n\n<\/div>\n\n\n<\/div