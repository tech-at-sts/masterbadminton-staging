d5b\u4e2d\uff0c\u6709\u65f6\u201c\u597d\u7684\u9632\u5b88\u5c31\u662f\u597d\u7684\u8fdb\u653b\uff01\u201d<\/p>\n<p>\u5f53\u60a8\u5177\u6709\u5f3a\u5927\u7684\u7fbd\u6bdb\u7403\u9632\u5b88\u80fd\u529b\u65f6\uff0c\u60a8\u7684\u5bf9\u624b\u5f88\u96be\u4ece\u60a8\u8fd9\u91cc\u8d62\u5f97\u5206\u6570\uff01\u60a8\u7684\u5bf9\u624b\u8d8a\u52aa\u529b\u5730\u8bd5\u56fe\u7a81\u7834\u60a8\u7684\u9632\u5b88\uff0c\u4ed6\u72af\u9519\u8bef\u7684\u673a\u4f1a\u5c31\u8d8a\u5927\u3002<\/p>\n<p class=\"translation-block\">\u5b9e\u73b0\u575a\u5b9e\u7684\u7fbd\u6bdb\u7403\u9632\u5b88\u7684\u5173\u952e\u662f\uff0c\u5f53\u60a8\u9884\u6d4b\u5230\u5bf9\u624b\u8981\u53d1\u51fa\u4e00\u8bb0 smash \u65f6\uff0c\u91c7\u7528\u7fbd\u6bdb\u7403\u9632\u5b88\u59ff\u52bf\u3002<\/p>\n<p class=\"translation-block\">\u70b9\u51fb\u6b64\u5904\u9605\u8bfb\u66f4\u591a\u5173\u4e8e\u7fbd\u6bdb\u7403\u9632\u5b88\u59ff\u52bf\u7684\u5185\u5bb9\u3002<\/p>\n<p><strong>\u5982\u4f55\u9884\u6d4b\u60a8\u7684\u5bf9\u624b\u4f55\u65f6\u4f1a\u53d1\u51fa smash\uff1f<\/strong><\/p>\n<p class=\"translation-block\">\u5f88\u7b80\u5355\uff0c\u6bcf\u5f53\u60a8\u6253\u51fa\u4e00\u8bb0\u7fbd\u6bdb\u7403\u9ad8\u8fdc\u7403\u6216\u7f51\u524d\u62c9\u7403\u65f6\uff0c\u7acb\u5373\u5207\u6362\u5230\u9632\u5b88\u59ff\u52bf\u3002\u53ea\u6709\u5f53\u60a8\u5c06\u7fbd\u6bdb\u7403\u6253\u5f97\u5f88\u9ad8\u65f6\uff0c\u60a8\u7684\u5bf9\u624b\u624d\u6709\u673a\u4f1a\u53d1\u51fa smash.<\/p>\n<h2 style=\"text-align: left;\">\u6559\u7a0b<\/h2>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/defense-spot-3.jpg\" alt=\"defending badminton smash position\" width=\"400\" height=\"203\" \/><\/p>\n<p class=\"translation-block\">\u6bcf\u5f53\u60a8\u5c06\u7fbd\u6bdb\u7403\u9ad8\u8fdc\u7403\u6216\u7f51\u524d\u62c9\u7403\u4f20\u7ed9\u5bf9\u624b\u65f6\uff0c\u8bf7\u8fc5\u901f\u79fb\u52a8\u5230\u56fe\u4e2d\u6240\u793a\u7684 X \u70b9\u3002<\/p>\n<p>\u5728\u9632\u5b88 smash \u65f6\uff0c\u5c06\u81ea\u5df1\u7684\u4f4d\u7f6e\u7565\u5fae\u653e\u5728\u811a\u6b65\u57fa\u7840\u4e4b\u540e\uff08\u7565\u5fae\u9760\u540e\u4e8e\u7403\u573a\u4e2d\u5fc3\uff09\u3002\u8fd9\u6837\u53ef\u4ee5\u8ba9\u60a8\u6709\u4e9b\u65f6\u95f4\u6765\u201c\u6355\u6349\u201d smash \u7684\u98de\u884c\u65b9\u5411\uff0c\u4ee5\u4fbf\u60a8\u6709\u8db3\u591f\u7684\u65f6\u95f4\u505a\u51fa\u53cd\u5e94\u3002<\/p>\n<p>\u5f53\u4f60\u5728\u56fe\u4e2d\u7684 X \u70b9\u65f6\uff0c\u91c7\u53d6\u9632\u5fa1\u59ff\u6001\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/defense1-3.jpg\" alt=\"defending in badminton\" width=\"320\" height=\"400\" \/><\/p>\n<p>\u4e0a\u56fe\u5c55\u793a\u4e86\u60a8\u5728\u9884\u6599\u5bf9\u624b\u53d1\u51fa\u5f3a\u529b smash \u65f6\u6240\u91c7\u7528\u7684\u9632\u5b88\u59ff\u52bf\u3002<\/p>\n<p>&nbsp;<\/p>\n<ul>\n<li class=\"translation-block\">\u5c3d\u53ef\u80fd\u5730\u5f2f\u8170\u3002\u6700\u4f73\u72b6\u6001\uff1a\u5f2f\u8170\u76f4\u81f3\u4f60\u7684\u773c\u775b\u4e0e\u7fbd\u6bdb\u7403\u7f51\u9876\u90e8\u6c34\u5e73\u5bf9\u9f50\u3002<\/li>\n<li>\u4fdd\u6301\u80f8\u90e8\u633a\u76f4\uff0c\u62c9\u76f4\u4e0b\u80cc\u90e8\u3002\u5f2f\u66f2\u819d\u76d6\uff0c\u907f\u514d\u5f2f\u66f2\u810a\u67f1\u3002<\/li>\n<li class=\"translation-block\">\u786e\u4fdd\u4f60\u63e1\u62cd\u7684\u624b\u81c2\u5728\u4f60\u7684\u524d\u65b9\u3002\u8fd9\u662f\u4e3a\u4e86\u786e\u4fdd\u5f53\u4f60\u7684\u5bf9\u624b\u6263\u6740\u7403\u5230\u4f60\u65f6\uff0c\u4f60\u53ef\u4ee5\u8fc5\u901f\u505a\u51fa\u53cd\u5e94\uff08\u901a\u5e38\u662f\u8fdb\u884c\u4e0b\u65cb\u7403\uff09\u3002<\/li>\n<li class=\"translation-block\">\u65e0\u6cd5\u786e\u5b9a\u4f60\u7684\u5bf9\u624b\u662f\u5426\u4f1a\u6263\u5411\u4f60\u7684\u6b63\u624b\u6216\u53cd\u624b\u533a\u57df\u3002\u56e0\u6b64\uff0c\u4e0d\u8981\u63e1\u62cd\u592a\u7d27\u3002\u8fd9\u662f\u4e3a\u4e86\u80fd\u591f\u8f7b\u677e\u5730\u5207\u6362\u6b63\u624b\u548c\u53cd\u624b\u63e1\u62cd\uff08\u53cd\u4e4b\u4ea6\u7136\uff09\u3002<\/li>\n<li class=\"translation-block\">\u6b64\u5916\uff0c\u63e1\u62cd\u592a\u7d27\u4f1a\u51cf\u5c11\u4f60\u7684\u624b\u8155\u52a8\u4f5c\u3002\u70b9\u51fb\u8fd9\u91cc\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u7fbd\u6bdb\u7403\u624b\u8155\u52a8\u4f5c\u7684\u5185\u5bb9\u3002<\/li>\n<\/ul>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/defense2-3.jpg\" alt=\"badminton defense\" width=\"301\" height=\"400\" \/><\/p>\n<p class=\"translation-block\">\u4fdd\u6301\u4f60\u7684\u975e\u7403\u62cd\u81c2\u4e5f\u8981\u6d3b\u52a8\u3002\u8fd9\u6709\u52a9\u4e8e\u4fdd\u6301\u7fbd\u6bdb\u7403\u8eab\u4f53\u5e73\u8861\u3002<\/p>\n<p>\u5f53\u63a5\u6536\u5bf9\u624b\u7684\u4e00\u8bb0\u653b\u51fb\u65f6\uff0c<\/p>\n<ul>\n<li>\u4fdd\u6301\u4e13\u6ce8\u548c\u653e\u677e\uff0c<\/li>\n<li>\u7ad9\u5728\u7262\u56fa\u7684\u9632\u5b88\u59ff\u52bf\u4e0a\uff0c<\/li>\n<li>\u4e0d\u8981\u5bb3\u6015\u7fbd\u6bdb\u7403\uff0c\u5b83\u4e0d\u4f1a\u4f24\u5bb3\u4f60\u3002<\/li>\n<\/ul>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" class=\"aligncenter\" src=\"http:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/defense3-3.jpg\" alt=\"badminton defensive technique\" width=\"351\" height=\"400\" \/><\/p>\n<p>\u5728\u7fbd\u6bdb\u7403\u7684\u9632\u5b88\u59ff\u52bf\u4e2d\uff0c\u53ea\u8981\u4f60\u9762\u5411\u524d\u65b9\uff08\u8eab\u4f53\u671d\u5411\u5bf9\u624b\uff09\uff0c\u5c31\u5f88\u5bb9\u6613\u5411\u5de6\u6216\u5411\u53f3\u79fb\u52a8\uff0c\u8fd9\u4f7f\u4f60\u80fd\u591f\u4ece\u5de6\u8fb9\u6216\u53f3\u8fb9\u63a5\u56de\u4e00\u8bb0\u653b\u51fb\u3002<\/p>\n<p class=\"translation-block\">\u9632\u5b88\u7fbd\u6bdb\u7403\u653b\u51fb\u6709\u4e9b\u7c7b\u4f3c\u4e8e\u8db3\u7403\u95e8\u5c06\u4fdd\u62a4\u7403\u95e8\uff0c\u53ea\u4e0d\u8fc7\u4f60\u662f\u7528\u7403\u62cd\u800c\u4e0d\u662f\u624b\u6765\u8fdb\u884c\u9632\u5b88\u3002<\/p>\n<h2>\u91cd\u8981\u63d0\u793a\/\u5efa\u8bae<\/h2>\n<ol>\n<li>\u9632\u5b88\u5bf9\u624b\u5f3a\u529b\u6263\u7403\u7684\u5173\u952e\u662f\u91c7\u53d6\u9632\u5b88\u59ff\u6001\u3002<\/li>\n<li>\u7ad9\u5728\u7403\u573a\u4e2d\u592e\u7a0d\u5fae\u9760\u540e\u7684\u4f4d\u7f6e\uff0c\u8ba9\u81ea\u5df1\u6709\u66f4\u591a\u65f6\u95f4\u89c2\u5bdf\u5bf9\u624b\u6263\u7403\u7684\u98de\u884c\u65b9\u5411\u3002<\/li>\n<li>\u4e0d\u8981\u5bb3\u6015\u73ed\u8f66\u3002\u5f53\u4f60\u5bb3\u6015\u7a7f\u68ad\u65f6\uff0c\u4f60\u81ea\u7136\u4f1a\u5fae\u5fae\u4fa7\u8138\u3002\u8fd9\u610f\u5473\u7740\u4f60\u8eab\u4f53\u7684\u4e00\u4fa7\u5c06\u9762\u5411\u4f60\u7684\u5bf9\u624b\u3002\u5982\u679c\u662f\u8fd9\u6837\uff0c\u4f60\u5c06\u65e0\u6cd5\u8986\u76d6\u5e7f\u89d2\u3002<\/li>\n<li>\u5f53\u60a8\u9884\u6599\u5230\u5bf9\u624b\u7684\u5f3a\u529b\u7c89\u788e\u65f6\uff0c\u8bf7\u5feb\u901f\u79fb\u52a8\u5230\u8fd9\u4e2a\u201c\u9632\u5b88\u57fa\u5730\u201d\u3002\u4f60\u8d8a\u5feb\u79fb\u52a8\u5230\u8fd9\u4e00\u70b9\u5e76\u91c7\u53d6\u7fbd\u6bdb\u7403\u9632\u5b88\u7ad9\u4f4d\uff0c\u4f60\u5c31\u80fd\u66f4\u597d\u5730\u51c6\u5907\u597d\u8fce\u63a5\u5bf9\u624b\u7684\u6263\u7403\u3002<\/li>\n<\/ol>\n<div class=\"retnvbx1\"><\/div>\n<div class=\"fb-comments-intro-ns\">\n<div class=\"retnvbx\"><\/div>\n<h3><span class=\"teelmeww\">\u544a\u8bc9\u6211\u4f60\u7684\u60f3\u6cd5\uff01<\/span><\/h3>\n<p>\u4f60\u5bf9\u521a\u521a\u8bfb\u5230\u7684\u5185\u5bb9\u6709\u4f55\u770b\u6cd5\uff1f\u5728\u4e0b\u9762\u7ed9\u6211\u7559\u8a00\u3002<\/p>\n<\/div>\n<div id=\"COMMENTING\" class=\"fb-comment\">\n<div class=\"fb-comments\" data-href=\"http:\/\/www.how-to-play-badminton.com\/badminton-defense.html\" data-num-posts=\"15\" data-width=\"100%\"><\/div>\n<div id=\"fb-root\"><\/div>\n<p><script>\/\/ <![CDATA[\n(function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(d.getElementById(id)){return;}js=d.createElement(s);js.id=id;js.src=\"..\/connect.facebook.net\/en_US\/all.js#xfbml=1\";fjs.parentNode.insertBefore(js,fjs);}(docu