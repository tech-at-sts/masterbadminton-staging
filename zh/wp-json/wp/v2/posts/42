.png 1024w, https:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/Drop-Shot-v3-768x546.png 768w, https:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/Drop-Shot-v3-18x12.png 18w, https:\/\/masterbadminton.com\/wp-content\/uploads\/2016\/05\/Drop-Shot-v3-640x455.png 640w\" sizes=\"auto, (max-width: 599px) 100vw, 599px\" \/><\/div>\n<p class=\"translation-block\">\u5feb\u901f\u4e0b\u65cb\u7403\uff1a\u4ee5\u9661\u5ced\u7684\u89d2\u5ea6\u98de\u884c\uff0c\u4f46\u7740\u9646\u4f4d\u7f6e\u6bd4\u79bb\u7f51\u66f4\u8fdc\u3002<\/p>\n<p class=\"translation-block\">\u6162\u901f\u4e0b\u65cb\u7403\uff1a\u4e0d\u4ee5\u9661\u5ced\u7684\u89d2\u5ea6\u98de\u884c\uff0c\u4f46\u7740\u9646\u4f4d\u7f6e\u66f4\u9760\u8fd1\u7f51\u3002<\/p>\n<p>\u65e0\u8bba\u662f\u6162\u901f\u843d\u7403\u8fd8\u662f\u5feb\u901f\u843d\u7403\uff0c\u8d28\u91cf\u597d\u7684\u7fbd\u6bdb\u7403\u843d\u7403\u90fd\u4f1a\u8ba9\u7fbd\u6bdb\u7403\u7565\u9ad8\u4e8e\u7403\u7f51\u3002<\/p>\n<p>\u4f5c\u4e3a\u521d\u5b66\u8005\uff0c\u4e0d\u8981\u592a\u62c5\u5fc3\u5148\u505a\u5b8c\u7f8e\u7684\u4e0b\u964d\u3002<\/p>\n<p class=\"translation-block\">\u5b66\u4e60\u6267\u884c\u7fbd\u6bdb\u7403\u843d\u7403\u7684\u6b63\u786e\u6280\u5de7\uff0c\u7136\u540e\u7ec3\u4e60\u4ee5\u4f7f\u5176\u5b8c\u7f8e\u3002<\/p>\n<p><span style=\"font-size: 18.6px; color: #ff3300;\"><b>\u5feb\u901f\u4e0b\u964d\u5c04\u51fb\u7684\u7406\u60f3\u7740\u9646\u70b9<br \/>\n<\/b><\/span><\/p>\n<p class=\"translation-block\">\u5bf9\u4e8e Fast Drop Shot\uff0c\u822a\u5929\u98de\u673a\u5c06\u964d\u843d\u5728\u4e0b\u65b9\u9ec4\u8272\u533a\u57df\u7684\u67d0\u4e2a\u4f4d\u7f6e\u3002<\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/400xNxfast-drop-landing-area.jpg.pagespeed.ic.8jjH86WLY2.jpg\" width=\"400\" data-pin-media=\"images\/fast-drop-landing-area.jpg\" \/><\/div>\n<p>\u4e4b\u6240\u4ee5\u79f0\u4e3a Fast Drop\uff0c\u662f\u56e0\u4e3a\u7a7f\u68ad\u7403\u5411\u4e0b\u79fb\u52a8\u5230\u5bf9\u624b\u4e00\u4fa7\u7684\u901f\u5ea6\u66f4\u5feb\uff0c\u4f46\u843d\u5728\u66f4\u9760\u8fd1\u4e2d\u573a\u7684\u4f4d\u7f6e\u3002\u7406\u60f3\u60c5\u51b5\u4e0b\uff0cFast Drop \u5c06\u964d\u843d\u5728\u670d\u52a1\u7ebf\u4e4b\u4e0a\u6216\u4e4b\u540e\u3002<\/p>\n<p><span style=\"font-size: 18.6px; color: #ff3300;\"><b>\u6162\u901f\u4e0b\u964d\u5c04\u51fb\u7684\u7406\u60f3\u7740\u9646\u70b9<\/b><\/span><\/p>\n<p class=\"translation-block\">\u5bf9\u4e8e Slow Drop Shot\uff0c\u822a\u5929\u98de\u673a\u5c06\u964d\u843d\u5728\u4e0b\u65b9\u7ea2\u8272\u533a\u57df\u7684\u67d0\u4e2a\u4f4d\u7f6e\u3002<\/p>\n<div class=\"ImageBlock ImageBlockCenter\"><img decoding=\"async\" class=\"aligncenter\" src=\"..\/wp-content\/uploads\/2016\/04\/400xNxslow-drop-landing-area.jpg.pagespeed.ic.mvGC-yPgdW.jpg\" width=\"400\" data-pin-media=\"images\/slow-drop-landing-area.jpg\" \/><\/div>\n<p>\u6211\u4eec\u79f0\u5176\u4e3a\u6162\u901f\u4e0b\u964d\uff0c\u56e0\u4e3a\u7403\u5728\u843d\u5230\u5bf9\u624b\u4e00\u4fa7\u4e4b\u524d\u9700\u8981\u4e00\u4e9b\u65f6\u95f4\u3002\u4f46\u662f\uff0c\u5b83\u4f1a\u66f4\u63a5\u8fd1\u7f51\u7edc\u3002\u4e00\u4e2a\u597d\u7684 Slow Drop \u5e94\u8be5\u5728\u670d\u52a1\u7ebf\u4e4b\u524d\u7740\u9646\u3002<\/p>\n<p style=\"text-align: left;\"><span style=\"font-size: 18.6px; color: #ff3300;\"><b>\u6253\u7fbd\u6bdb\u7403\u540a\u7403\u7684\u76ee\u7684<\/b><\/span><\/p>\n<ol>\n<li class=\"translation-block\">\u8ba9\u5bf9\u624b\u5931\u53bb\u7a33\u5b9a\u4f4d\u7f6e\u3002\u4e0b\u65cb\u7403\u4f1a\u5c06\u5bf9\u624b\u5438\u5f15\u5230\u7403\u573a\u524d\u65b9\u3002\u4e00\u8bb0\u597d\u7684\u4e0b\u65cb\u7403\u53ef\u4ee5\u5e72\u6270\u5bf9\u624b\u7684\u6b65\u4f10\u3002<\/li>\n<li class=\"translation-block\">\u6539\u53d8\u6bd4\u8d5b\u7684\u8282\u594f\u662f\u4e00\u79cd\u5e38\u89c1\u7b56\u7565\u3002\u5728\u6b63\u786e\u7684\u65f6\u673a\u4f7f\u7528\u4e0b\u65cb\u7403\u53ef\u4ee5\u5236\u9020\u51fa\u6781\u5927\u7684\u6b3a\u9a97\u6027\u3002\u5173\u952e\u5728\u4e8e\u5f53\u5bf9\u624b\u671f\u671b\u6311\u9ad8\u6216\u6263\u6740\u65f6\uff0c\u6253\u51fa\u4e0b\u65cb\u7403\u3002\u7136\u540e\uff0c\u60a8\u53ef\u4ee5\u671f\u671b\u5bf9\u624b\u56de\u7403\u8f83\u5f31\uff0c\u5e0c\u671b\u5c06\u7fbd\u6bdb\u7403\u56de\u5230\u60a8\u7684\u4e2d\u573a\u3002<\/li>\n<\/ol>\n<p><span style=\"font-size: 18.6px; color: #ff3300;\"><b>\u843d\u7403\u6559\u7a0b<\/b><\/span><\/p>\n<p class=\"translation-block\">\u53ef\u4ee5\u4f7f\u7528\u6b63\u624b\u8fc7\u9876\u548c\u53cd\u624b\u8fc7\u9876\u51fb\u7403\u6765\u6267\u884c\u843d\u7403\uff08\u5feb\u901f\u548c\u6162\u901f\uff09\u3002<\/p>\n<p class=\"translation-block\">\u5982\u4f55\u51fb\u6253\u8fc7\u9876\u6b63\u624b\u540a\u7403 \u5b66\u4e60\u4f7f\u7528\u8fc7\u9876\u6b63\u624b\u8fdb\u884c\u5feb\u901f\u548c\u6162\u901f\u540a\u7403\u7684\u6b63\u786e\u6280\u5de7\u3002\u5728\u5355\u6253\u548c\u53cc\u6253\u4e2d\u90fd\u975e\u5e38\u6709\u7528\u3002<\/p>\n<p class=\"translation-block\">\u5982\u4f55\u51fb\u7403\u8fc7\u9876\u53cd\u624b\u540a\u7403 \u5f53\u4f60\u7684\u5bf9\u624b\u5c06\u7403\u51fb\u5230\u4f60\u7684\u53cd\u624b\u533a\u57df\u65f6\uff0c\u8fd9\u79cd\u51fb\u7403\u5c31\u53d8\u5f97\u975e\u5e38\u6709\u7528\u3002\u6211\u5efa\u8bae\u4f60\u53ea\u5b66\u4e60\u53cd\u624b\u843d\u7403\u7684\u5feb\u901f\u843d\u7403\uff0c\u56e0\u4e3a\u6162\u7403\u843d\u7403\u9700\u8981\u4e00\u4e9b\u5207\u5206\u3002\u5207\u7247\u662f\u4e00\u9879\u975e\u5e38\u56f0\u96be\u7684\u6280\u672f\uff0c\u5982\u679c\u60a8\u662f\u521d\u5b66\u8005\uff0c\u6211\u4e0d\u5efa\u8bae\u60a8\u5207\u7247\u3002<\/p>\n<p><span style=\"font-size: 18.6px; color: #ff3300;\"><b>\u9ad8\u7ea7\u7fbd\u6bdb\u7403\u6311\u7403\u6280\u5de7<\/b><\/span><\/p>\n<p class=\"translation-block\">\u5982\u4f55\u6253\u51fa\u5207\u7403\u6311\u7403\uff1a\u5982\u679c\u4f60\u5df2\u7ecf\u638c\u63e1\u4e86\u5feb\u901f\u548c\u6162\u901f\u6311\u7403\u7684\u6280\u5de7\uff0c\u90a3\u4e48\u4f60\u53ef\u80fd\u60f3\u5c06\u4f60\u7684\u6280\u80fd\u63d0\u5347\u5230\u66f4\u9ad8\u7684\u6c34\u5e73\u3002<\/p>\n<p>\u5207\u7403\u6311\u7403\u53ef\u4ee5\u8ba9\u4f60\u66f4\u8fdb\u4e00\u6b65\u5730\u6b3a\u9a97\u4f60\u7684\u5bf9\u624b\u3002<\/p>\n<p>\u4f60\u8fd8\u5c06\u5b66\u4e60\u5982\u4f55\u4f7f\u7528\u5207\u7403\u6765\u6253\u51fa\u66f4\u597d\u7684\u8d28\u91cf\u7684\u6162\u901f\u6311\u7403\u3002\u4f60\u662f\u5426\u5bf9\u659c\u7ebf\u6162\u901f\u6311\u7403\u611f\u5230\u5438\u5f15\uff1f\u70b9\u51fb\u67e5\u770b\u5982\u4f55\u505a\u5230\uff01<\/p>\n<div class=\"CalloutBox\" style=\"box-sizing: border-box;\">\n<p>\u201c\u6bcf\u4e2a\u4eba\u90fd\u77e5\u9053\u5982\u4f55\u51fb\u7403\u3002\u8bb8\u591a\u7403\u5458\u90fd\u80fd\u6253\u51fa\u6f02\u4eae\u7684\u6263\u7403\u3002\u4f46\u662f\u80fd\u6253\u51fa\u597d\u7684Drops\u7684\u73a9\u5bb6\u5e76\u4e0d\u591a\u3002<\/p>\n<p>\u8981\u6253\u51fa\u6f02\u4eae\u7684\u843d\u7403\uff0c\u4f60\u9700\u8981\u5c06\u7403\u4e3e\u9ad8\u5e76\u201c\u5207\u5165\u201d\u5b83\uff0c\u4f46\u8981\u5728\u53d1\u7403\u524d\u6253\u51fa\u4e00\u8bb0\u843d\u7403\u5e76\u4e0d\u4f1a\u5728\u7f51\u4e0a\u98de\u5f97\u592a\u9ad8\uff0c\u8fd9\u9700\u8981\u5f88\u591a\u6280\u5de7\u3002 \u2013 <em><a href=\"\/zh\/interview-arvind.html\/\">\u963f\u6587\u5fb7\u00b7\u5df4\u7279<\/a>, 2008 \u5e74\u548c 2011 \u5e74\u5370\u5ea6\u5168\u56fd\u51a0\u519b<\/em> &#8211;<\/p>\n<\/div>\n<p>\u60f3\u8981\u5236\u9020\u51fa\u9876\u7ea7\u4e0b\u65cb\u7403\u5e76\u4e0d\u5bb9\u6613\uff0c\u5176\u4e2d\u5b58\u5728\u7740\u98ce\u9669\u3002\u5f53\u5c1d\u8bd5\u6253\u51fa\u5b8c\u7f8e\u7684\u4e0b\u65cb\u7403\u65f6\uff0c<\/p>\n<ul>\n<li>\u7fbd\u6bdb\u7403\u53ef\u80fd\u4f1a\u88ab\u7f51\u62e6\u4f4f\uff0c\u5bfc\u81f4\u60a8\u5931\u53bb\u5f97\u5206\u3002<\/li>\n<li>\u7fbd\u6bdb\u7403\u53ef\u80fd\u98de\u5f97\u592a\u9ad8\uff0c\u8d8a\u8fc7\u7f51\u53e3\u3002<\/li>\n<\/ul>\n<p>\u4e00\u5207\u90fd\u5728\u4e8e\u7ec3\u4e60\uff0c\u7ec3\u4e60\u548c\u518d\u7ec3\u4e60...<\/p>\n<p>\u795d\u4f60\u597d\u8fd0\uff01<\/p>\n<p><a href=\"\/zh\/\">\u6253\u5b8c\u7fbd\u6bdb\u7403\u56de\u5bb6<\/a><\/p>\n<p style=\"text-align: center;\"><span style=\"color: #ff3300;\"><b style=\"d