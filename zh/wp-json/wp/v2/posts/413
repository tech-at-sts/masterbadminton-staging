02<\/p>\n<p>\u65e5\u672c\u516c\u5f00\u8d5b\u51b3\u8d5b\u4e2d\uff0c\u674e\u5b97\u4f1f\u82e6\u6218\u4e09\u5c40\u4e0d\u654c\u8c0c\u9f99\u3002 <a href=\"\/zh\/leechongwei-chenlong-yonex-japan-open-2011-men-singles-finals-analysis.html\/\">\u70b9\u51fb\u6b64\u5904\u89c2\u770b <strong>\u5c24\u5c3c\u514b\u65af\u65e5\u672c\u516c\u5f00\u8d5b 2011<\/strong><\/a>.<\/p>\n<p>\u636e\u8bf4\u674e\u5b97\u4f1f\u5728\u7fbd\u6bdb\u7403\u573a\u4e0a\u5f88\u96be\u627e\u5230\u81ea\u5df1\u7684\u8282\u594f\u3002<\/p>\n<p>\u6797\u4e39\u5728\u65e5\u672c\u516c\u5f00\u8d5b\u51b3\u8d5b\u4e2d\u62d2\u7edd\u4e0e\u674e\u5b97\u4f1f\u4ea4\u950b\uff0c\u4ece\u800c\u7ed9\u4e86\u540c\u80de\u8c0c\u9f99\u5728\u51b3\u8d5b\u4e2d\u4e0e\u4e16\u754c\u6392\u540d\u7b2c\u4e00\u7684\u673a\u4f1a\u3002<\/p>\n<h3>\u6797\u4e39\u8f93\u7ed9\u975e\u79cd\u5b50\u9009\u624b\uff1f<\/h3>\n<p>\u672c\u6b21\u6bd4\u8d5b\uff0c\u6797\u4e39\u57282011\u5e74\u5c24\u5c3c\u514b\u65af\u4e39\u9ea6\u516c\u5f00\u8d5b\u7b2c\u4e8c\u8f6e\u4e2d\u88ab\u6765\u81ea\u9999\u6e2f\u7684\u975e\u79cd\u5b50\u9009\u624b\u9ec4\u6c38\u57fa\u51fb\u8d25\u3002<\/p>\n<p>\u6bcf\u4e2a\u4eba\u90fd\u77e5\u9053\u8fd9\u662f\u4e0d\u53ef\u80fd\u7684\u3002\u552f\u4e00\u7684\u539f\u56e0\u5c31\u662f\u6797\u4e39\u5728\u8fd9\u573a\u6bd4\u8d5b\u4e2d\u6ca1\u6709\u8ba4\u771f\u593a\u51a0\u3002<\/p>\n<h3>\u4ed6\u4eec\u518d\u6b21\u76f8\u9047<\/h3>\n<p>\u8fd9\u662f\u8fd9\u4e24\u4f4d\u9009\u624b\u8fde\u7eed\u7b2c\u4e8c\u6b21\u5728 OSIM BWF \u8d85\u7ea7\u7cfb\u5217\u8d5b\u7684\u51b3\u8d5b\u4e2d\u76f8\u9047\u3002<\/p>\n<p>\u6b64\u6b21\uff0c\u8c0c\u9f99\u8fde\u593a2011\u5c24\u5c3c\u514b\u65af\u4e39\u9ea6\u516c\u5f00\u8d5b\u51a0\u519b\u3002<\/p>\n<h3>\u8c0c\u9f99\u5c55\u73b0\u975e\u51e1\u9632\u5b88\u6280\u5de7<\/h3>\n<p>\u8c0c\u9f99\u4e0e\u5b97\u4f1f\u7684\u6bd4\u8d5b\u975e\u5e38\u7cbe\u5f69\u3002\u8c0c\u9f99\u7684\u9632\u5b88\u975e\u5e38\u51fa\u8272\uff0c\u8ba9\u674e\u5b97\u4f1f\u7684\u653b\u51fb\u65e0\u6548\u3002<\/p>\n<p>\u6709\u597d\u51e0\u6b21\uff0c\u674e\u5b97\u4f1f\u51b2\u4e0a\u524d\u8fdb\u884c\u7f51\u6740\uff0c\u8ba9\u4ed6\u7684\u540e\u573a\u4e0d\u582a\u4e00\u51fb\u3002<\/p>\n<p>\u8c0c\u9f99\u6210\u529f\u56de\u51fb\u4e86\u5b97\u4f1f\u7684\u6740\u7403\uff0c\u5c06\u7403\u63a8\u5411\u4e86\u5b97\u4f1f\u7684\u540e\u573a\u3002\u6211\u4eec\u5728 2011 \u5e74\u5c24\u5c3c\u514b\u65af\u65e5\u672c\u516c\u5f00\u8d5b\u4e0a\u76ee\u7779\u4e86\u540c\u6837\u7684\u573a\u666f\u3002<\/p>\n<p>\u4e5f\u8bb8\u5b97\u4f1f\u5e94\u8be5\u91c7\u53d6\u53e6\u4e00\u79cd\u7b56\u7565\u3002\u8c0c\u9f99\u4f3c\u4e4e\u5f88\u8f7b\u677e\u5730\u4ece\u4e16\u754c\u7b2c\u4e00\u624b\u4e2d\u593a\u56de\u4e86\u51c0\u51fb\u6740\u6570\u3002<\/p>\n<p>\u8c0c\u9f99\u7684\u53cd\u5e94\u901f\u5ea6\u6781\u5feb\u3002\u5728\u91cc\u9762 <a href=\"\/zh\/leechongwei-chenlong-yonex-japan-open-2011-men-singles-finals-analysis.html\/\">2011\u5e74\u5c24\u5c3c\u514b\u65af\u65e5\u672c\u516c\u5f00\u8d5b\u6bd4\u8d5b\u5206\u6790<\/a>\uff0c\u6211\u89e3\u91ca\u8bf4\u8c0c\u9f99\u64c5\u957f\u7fbd\u6bdb\u7403\u53d1\u7403\u3002<\/p>\n<p>\u8fd9\u8fdb\u4e00\u6b65\u5f3a\u8c03\u4e86\u6211\u7684\u89c2\u70b9\uff0c\u5373\u4ed6\u7684\u53cd\u5e94\u901f\u5ea6\u5f88\u5feb\uff0c\u56e0\u6b64\u80fd\u591f\u51fa\u8272\u5730\u51fb\u7403\u5e76\u4ea7\u751f\u5feb\u901f\u8fdb\u653b\uff0c\u4f8b\u5982\u7f51\u6740\u3002<\/p>\n<h3>\u8c0c\u9f99\u7684\u806a\u660e\u6253\u6cd5<\/h3>\n<p>\u5c3d\u7ba1\u5982\u6b64\uff0c\u5bfc\u81f4\u674e\u5b97\u4f1f\u57282011\u5e74\u5c24\u5c3c\u514b\u65af\u4e39\u9ea6\u516c\u5f00\u8d5b\u4e0a\u5931\u5229\u7684\u4e3b\u8981\u539f\u56e0\u8fd8\u662f\u8c0c\u9f99\u53d1\u6325\u4e86\u81ea\u5df1\u7684\u4f18\u52bf\u3002<\/p>\n<p>\u4f5c\u4e3a\u4e00\u540d\u8eab\u6750\u6781\u9ad8\u7684\u7fbd\u6bdb\u7403\u8fd0\u52a8\u5458\uff0c\u8c0c\u9f99\u5f88\u597d\u5730\u5229\u7528\u4e86\u81ea\u5df1\u7684\u8eab\u9ad8\u83b7\u5f97\u4e86\u4f18\u52bf\u3002<\/p>\n<p>\u5c06\u822a\u5929\u98de\u673a\u9001\u5230\u7403\u573a\u540e\u9762\u5e76\u6ca1\u6709\u5e2e\u52a9\u3002\u6bd4\u8d5b\u4e2d\uff0c\u6bcf\u5f53\u674e\u5b97\u4f1f\u5c06\u7403\u4e3e\u5230\u8c0c\