{"id":294,"date":"2016-05-16T12:53:12","date_gmt":"2016-05-16T12:53:12","guid":{"rendered":"http:\/\/masterbadminton.dev\/advanced-technique-the-reverse-slice-drop-shot\/"},"modified":"2016-08-31T08:11:35","modified_gmt":"2016-08-31T08:11:35","slug":"reverse-slice-drop-shot-html-html","status":"publish","type":"post","link":"https:\/\/masterbadminton.com\/zh\/reverse-slice-drop-shot.html","title":{"rendered":"\u8fdb\u9636\u6280\u672f\uff1a\u53cd\u5411\u5207\u7247\u6295\u7bee"},"content":{"rendered":"<div id=\"ContentColumn\">\n<div class=\"Liner\">\n<div style=\"float: left;\"><\/div>\n<p>&nbsp;<\/p>\n<table border=\"1\" width=\"400px\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td bgcolor=\"#f79651\" width=\"50%\" height=\"20px\"><span style=\"color: #fbfbef; font-family: Arial; font-size: small;\"><strong>\u53cd\u5411\u5207\u7247\u4e0b\u964d\u5c04\u51fb<\/strong><\/span><\/td>\n<\/tr>\n<tr>\n<td bgcolor=\"#ffffff\" width=\"50%\"><span style=\"color: #000000; font-family: Arial; font-size: small;\"><span style=\"color: #000000; font-family: Arial; font-size: small;\"><br \/>\n<\/span><\/span><\/p>\n<table border=\"0\">\n<tbody>\n<tr>\n<td><strong>\u7b49\u7ea7<\/strong><\/td>\n<td>\u9ad8\u7ea7<\/td>\n<\/tr>\n<tr>\n<td><strong>\u7c7b\u578b<\/strong><\/td>\n<td>\u653b\u51fb\u6027<\/td>\n<\/tr>\n<tr>\n<td><strong>\u5148\u51b3\u6761\u4ef6<\/strong><\/td>\n<td><a href=\"\/zh\/badminton-drop.html\/\">\u57fa\u672c\u6295\u7403<\/a><\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<h3>\u4ecb\u7ecd<\/h3>\n<p>\u638c\u63e1\u57fa\u672c\u7684\u7fbd\u6bdb\u7403\u540a\u7403\u540e\uff0c\u8003\u8651\u5c06\u60a8\u7684\u540a\u7403\u6280\u80fd\u63d0\u5347\u5230\u4e00\u4e2a\u65b0\u7684\u6c34\u5e73\u3002<\/p>\n<p>\u53cd\u5411\u5207\u7403\u843d\u7403\u662f\u4e00\u79cd\u5148\u8fdb\u7684\u7fbd\u6bdb\u7403\u6280\u672f\u3002<\/p>\n<p>\u5b83\u7528\u4f5c\uff1a<\/p>\n<ul>\n<li><strong>\u66f4\u81f4\u547d\u7684\u7a7a\u6295\u3002 <\/strong> \u5207\u7403\u4f7f\u7403\u4e0b\u964d\u5f97\u66f4\u9661\uff0c\u8ba9\u4f60\u7684\u5bf9\u624b\u66f4\u96be\u6536\u56de\uff01<\/li>\n<li><strong>\u4e00\u67aa\u6b3a\u9a97\u4f60\u7684\u5bf9\u624b\u3002 <\/strong> \u5982\u679c\u6267\u884c\u5f97\u5f53\uff0c\u4f60\u7684\u5bf9\u624b\u4f1a\u8ba4\u4e3a\u7403\u662f\u671d\u7740\u4e00\u4e2a\u65b9\u5411\u524d\u8fdb\uff0c\u800c\u4f60\u5374\u5c06\u5b83\u53d1\u9001\u5230\u53e6\u4e00\u4e2a\u65b9\u5411\u3002<\/li>\n<\/ul>\n<p>\u5728\u672c\u6559\u7a0b\u4e2d\uff0c\u60a8\u5c06\u5b66\u4e60\u5982\u4f55\u5c06\u8fd9\u4e24\u79cd\u6280\u672f\u878d\u5165\u60a8\u7684 drop \u4e2d\uff1a<\/p>\n<ul>\n<li>\u7684\u6280\u672f<strong> \u5207\u7247<\/strong><\/li>\n<li>\u8fd9 <strong>\u53cd\u5411\u52a8\u4f5c<\/strong><\/li>\n<\/ul>\n<p>\u56e0\u6b64\u5f97\u540d\u201c\u53cd\u5411\u5207\u7247\u6ef4\u5c04\u201d\u3002<\/p>\n<h3>\u66f4\u9ad8\u8d28\u91cf\u7684\u843d\u7403<\/h3>\n<p>\u8981\u4f7f\u6c34\u6ef4\u6025\u5267\u4e0b\u964d\uff0c\u60a8\u9700\u8981\u5207\u5f00\u68ad\u5b50\u3002\u901a\u8fc7\u8fd9\u6837\u505a\uff0c\u60a8\u53ef\u4ee5\u4f7f\u7403\u6025\u5267\u4e0b\u964d\u5e76\u901a\u8fc7\u7403\u7f51\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/reverse-slice-trajectory.jpg\" alt=\"reverse slice trajectory\" width=\"397\" height=\"224\" \/><\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/reverse-slice-position.jpg\" alt=\"reverse slice position\" width=\"400\" height=\"203\" \/><\/p>\n<p>\u57fa\u672c\u7684\u540a\u7403\u843d\u5728 A \u70b9\u3002\u53e6\u4e00\u65b9\u9762\uff0c\u53cd\u5411\u5207\u7403\u540a\u7403\u843d\u5728 B \u70b9\uff08\u5373\u843d\u5f97\u66f4\u9661\uff0c\u843d\u5f97\u66f4\u9760\u8fd1\u7f51\uff09\u3002\u5728 B \u70b9\u627e\u56de\u7a7a\u6295\u8981\u56f0\u96be\u5f97\u591a\u3002<\/p>\n<h3>\u6b3a\u9a97\u4f60\u7684\u5bf9\u624b<\/h3>\n<p>\u8fd9\u662f\u901a\u8fc7\u4e00\u4e2a <strong>\u53cd\u5411\u52a8\u4f5c<\/strong>.\u53cd\u5411\u52a8\u4f5c\u53ea\u662f\u610f\u5473\u7740\u5c06\u7403\u62cd\u5411\u4e00\u4e2a\u65b9\u5411\u6446\u52a8\uff0c\u540c\u65f6\u5c06\u7fbd\u6bdb\u7403\u5411\u53e6\u4e00\u4e2a\u65b9\u5411\u6325\u52a8\u3002<\/p>\n<p>\u5f53\u60a8\u6267\u884c <strong>\u53cd\u5411\u5207\u7247\u6ef4\u5c04<\/strong>\uff0c\u4f60\u4f1a\u4ea7\u751f\u4e00\u4e2a\u8de8\u7403\u573a\u7684\u8f68\u8ff9\u3002<\/p>\n<p>\u8fd9\u4e2a\u60f3\u6cd5\u662f\u8ba9\u4f60\u7684\u5bf9\u624b\u8ba4\u4e3a\u4f60\u4f1a\u76f4\u63a5\u51fb\u7403\u3002\u7136\u540e\u901a\u8fc7\u5c06\u7403\u62cd\u5934\u8c03\u6574\u6210\u4e00\u5b9a\u89d2\u5ea6\uff0c\u5c06\u7fbd\u6bdb\u7403\u5207\u5f00\u5e76\u4ee5\u4e00\u5b9a\u89d2\u5ea6\u53d1\u9001\u3002<\/p>\n<p>\u4ece\u7403\u573a\u540e\u65b9\u7684\u5de6\u4fa7\u6216\u53f3\u4fa7\u6267\u884c\u53cd\u5411\u5207\u7403\u6295\u7bee\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/reverse-slice-trajectory-1.jpg\" alt=\"badminton reverse slice direction\" width=\"400\" height=\"203\" \/><\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/reverse-slice-trajectory-2.jpg\" alt=\"badminton reverse slice direction\" width=\"400\" height=\"203\" \/><\/p>\n<p>\u5728\u4e0a\u56fe\u4e2d\uff0c\u60a8\u5411\u524d\u6325\u52a8\u7403\u62cd\uff08\u7ea2\u7ebf\uff09\u3002\u540c\u65f6\uff0c\u5207\u5f00\u7fbd\u6bdb\u7403\uff0c\u4f7f\u5176\u7a7f\u8fc7\u573a\u5730\u98de\u5411 B \u70b9\uff08\u84dd\u7ebf\uff09\u3002<\/p>\n<h3>\u6559\u7a0b<\/h3>\n<p>\u8be5\u6280\u672f\u4e0e\u6267\u884c\u57fa\u672c\u7684\u6b63\u624b\u7fbd\u6bdb\u7403\u51fb\u7403\u5b8c\u5168\u76f8\u540c\u3002\u552f\u4e00\u7684\u533a\u522b\u662f\u60a8\u5c06\u7403\u62cd\u9762\u503e\u659c\u653e\u7f6e\u4ee5\u5207\u5f00\u7403\u3002<\/p>\n<p>\u5bf9\u4e8e\u57fa\u672c\u7684\u7fbd\u6bdb\u7403\u843d\u7403\uff0c\u7fbd\u6bdb\u7403\u7684\u8fd0\u52a8\u65b9\u5411\u4e0e\u6325\u6746\u65b9\u5411\u76f8\u540c\u3002<\/p>\n<p>\u8fd9\u610f\u5473\u7740\u5982\u679c\u4f60\u5411\u524d\u6325\u52a8\u7403\u62cd\uff0c\u4f60\u5c06\u4ea7\u751f\u4e00\u4e2a\u76f4\u7ebf\u4e0b\u964d\u7403\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/straight-drop-shot.jpg\" alt=\"badminton straight drop shot\" width=\"212\" height=\"378\" \/><\/p>\n<p>\u5c06\u7403\u62cd\u9762\u7a0d\u5fae\u5411\u53f3\u503e\u659c\uff0c\u5c06\u4f60\u7684\u843d\u7403\u5207\u5411\u7403\u573a\u7684\u53f3\u4fa7\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/reverse-slice-right.jpg\" alt=\"reverse slice drop shot\" width=\"212\" height=\"378\" \/><\/p>\n<p>\u5c06\u7403\u62cd\u9762\u7a0d\u5fae\u5411\u5de6\u503e\u659c\uff0c\u4ee5\u5c06\u60a8\u7684\u540a\u7403\u5207\u5411\u7403\u573a\u7684\u5de6\u4fa7\u3002<\/p>\n<p class=\"Thumbnail\"><img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/reverse-slice-left.jpg\" alt=\"reverse slice drop shot\" width=\"242\" height=\"378\" \/><\/p>\n<p>\u4ece\u7403\u573a\u540e\u65b9\u5207\u7403\u9700\u8981<\/p>\n<ul>\n<li>\u5f88\u597d\u7684\u63a7\u5236<\/li>\n<li>\u5b8c\u7f8e\u7684\u5c04\u95e8\u529b\u91cf<\/li>\n<\/ul>\n<p>\u5982\u679c\u4f60\u80fd\u6267\u884c <a href=\"\/zh\/badminton-strokes.html\/\">\u597d\u7684\u7fbd\u6bdb\u7403\u51fb\u7403<\/a>\uff0c\u60a8\u81ea\u7136\u4f1a\u62e5\u6709\u63a7\u5236\u6743\u548c\u6743\u529b\u3002<\/p>\n<h4>\u826f\u597d\u7684\u63a7\u5236<\/h4>\n<p>\u6267\u884c\u53cd\u5411\u5207\u7247\u65f6\uff0c\u60a8\u9700\u8981\u5bf9\u7403\u62cd\u6709\u826f\u597d\u7684\u63a7\u5236\u3002<\/p>\n<p>\u6211\u7684\u610f\u601d\u662f\u4f60\u5fc5\u987b\u8c03\u6574\u4f60\u7684\u7403\u62cd\u7684\u89d2\u5ea6\u4ee5\u786e\u4fdd\u7403\u662f\u7a7f\u8fc7\u7403\u573a\u7684\u3002\u5982\u679c\u89d2\u5ea6\u6b63\u786e\uff0c\u5b83\u4f1a\u843d\u5728\u91cc\u9762\u3002\u5982\u679c\u4f60\u8fc7\u5ea6\uff08\u5373\u4f60\u7684\u7403\u62cd\u503e\u659c\u592a\u591a\uff09\uff0c\u7403\u5c31\u4f1a\u98de\u51fa\u53bb\uff01<\/p>\n<h4>\u5b8c\u7f8e\u7684\u5c04\u95e8\u529b\u91cf<\/h4>\n<p>\u5207\u7247\u4e0e\u6b63\u5e38\u51fb\u7403\u5b8c\u5168\u4e0d\u540c\u3002\u5f53\u4f60\u6b63\u5e38\u51fb\u7403\u65f6\uff0c\u4f60\u51fb\u7403\u7684\u6240\u6709\u529b\u91cf\u90fd\u4f1a\u8f6c\u79fb\u5230\u4f60\u7684\u51fb\u7403\u4e0a\u3002<\/p>\n<p>\u81f3\u4e8e\u5207\u7403\uff0c\u5e76\u4e0d\u662f\u6240\u6709\u7684\u51fb\u7403\u529b\u91cf\u90fd\u8f6c\u79fb\u5230\u4e86\u51fb\u7403\u4e0a\u3002\u8fd9\u610f\u5473\u7740\u60a8\u9700\u8981\u66f4\u6709\u529b\u7684\u51fb\u7403\u6765\u5207\u5f00\u7a7f\u68ad\u6a2a\u7403\u573a\uff01<\/p>\n<p>\u8fd9\u5c31\u662f\u56f0\u96be\u7684\u5730\u65b9\u3002\u5982\u679c\u4f60\u7684\u51fb\u7403\u529b\u91cf\u592a\u5927\uff0c\u4f60\u7684\u5207\u7403\u53ef\u80fd\u4f1a\u5c06\u7403\u9001\u51fa\u7403\u573a\u3002<\/p>\n<p>\u5177\u6709\u8db3\u591f\u529b\u91cf\u7684\u8f7b\u67d4\u51fb\u6253\u662f\u5b8c\u7f8e\u5207\u7247\u7684\u5173\u952e\u3002<\/p>\n<p>\u5207\u7247\u65f6\u907f\u514d\u589e\u52a0\u624b\u8155\u52a8\u4f5c\u3002\u624b\u8155\u52a8\u4f5c\u53ef\u4ee5\u4ea7\u751f\u5f88\u5927\u7684\u529b\u91cf\uff0c\u4f46\u662f\u8981\u63a7\u5236\u98de\u68ad\u7684\u65b9\u5411\u975e\u5e38\u56f0\u96be\u3002<\/p>\n<p>\u56e0\u6b64\uff0c\u4e13\u6ce8\u4e8e\u826f\u597d\u7684\u884c\u7a0b\u3002\u4f60\u7684\u6b63\u624b\u6325\u6746\u52a8\u4f5c\u53ef\u4ee5\u66f4\u597d\u5730\u63a7\u5236\u65b9\u5411\u3002<\/p>\n<h3>\u91cd\u8981\u63d0\u793a\/\u5efa\u8bae<\/h3>\n<h4>1.\u638c\u63e1\u5b83\uff01<\/h4>\n<p>\u5b66\u4e60\u5b83\u662f\u4e0d\u591f\u7684\u3002\u8fd9\u4e2a\u6280\u80fd\u9700\u8981\u7ec3\u4e60\uff01\u8c03\u6574\u7403\u62cd\u9762\u7684\u89d2\u5ea6\u4ee5\u4ea7\u751f\u826f\u597d\u7684\u6a2a\u5207\u7403\u3002\u7ee7\u7eed\u5c1d\u8bd5\uff0c\u76f4\u5230\u83b7\u5f97\u6b63\u786e\u7684\u89d2\u5ea6\u3002<\/p>\n<h4>2.\u6b3a\u9a97\u4f60\u7684\u5bf9\u624b\u3002<\/h4>\n<p>\u5982\u679c\u4f60\u80fd\u5b8c\u7f8e\u5730\u5b8c\u6210\u8fd9\u4e2a\u7fbd\u6bdb\u7403\u51fb\u7403\uff0c\u4f60\u5c31\u80fd\u6b3a\u9a97\u4f60\u7684\u5bf9\u624b\u3002<\/p>\n<p>\u5728\u4f60\u771f\u6b63\u51fb\u4e2d\u5b83\u4e4b\u524d\uff0c\u5f88\u96be\u731c\u6d4b\u4f60\u7684\u51fb\u7403\u65b9\u5411\u3002\u5982\u679c\u4f60\u7684\u5bf9\u624b\u4e13\u6ce8\u4e8e\u4f60\u7684\u7403\u62cd\u79fb\u52a8\uff0c\u4ed6\u4eec\u5f88\u53ef\u80fd\u4f1a\u843d\u5165\u4f60\u7684\u5708\u5957\u3002<\/p>\n<h4>3. \u8fd9\u4e2a\u955c\u5934\u9700\u8981\u51fa\u8272\u7684\u63a7\u5236\u3002<\/h4>\n<p>\u907f\u514d\u4f7f\u7528\u624b\u8155\u52a8\u4f5c\uff0c\u56e0\u4e3a\u5b83\u5f88\u96be\u63a7\u5236\u3002\u4f60\u7684\u6325\u6746\u4f1a\u4ea7\u751f\u529b\u91cf\uff0c\u65b9\u5411\u5c06\u6765\u81ea\u4f60\u7684\u7403\u62cd\u7684\u5b9a\u4f4d\u3002<\/p>\n<h4>4.\u4f7f\u7528\u8f83\u7ec6\u7684\u7fbd\u6bdb\u7403\u7ebf\u3002<\/h4>\n<p>\u76f4\u5f84\u8f83\u7ec6\u7684\u7fbd\u6bdb\u7403\u7ebf\u53ef\u80fd\u66f4\u9002\u5408\u5207\u7403\u3002\u5982\u679c\u8981\u6267\u884c\u5b8c\u7f8e\u7684\u53cd\u5411\u5207\u7247\uff0c\u8bf7\u907f\u514d\u4f7f\u7528\u7c97\u4e8e 0.66 \u6beb\u7c73\u7684\u7434\u5f26\u3002<\/p>\n<p>\u6211\u4e2a\u4eba\u4f7f\u7528 <strong>Yonex BG66 Ultimax \u7fbd\u6bdb\u7403\u7ebf\uff080.65mm\uff09<\/strong> \u6211\u53d1\u73b0\u81ea\u5df1\u4ece\u540e\u573a\u4ea7\u751f\u4e86\u9ad8\u8d28\u91cf\u7684\u53cd\u5411\u5207\u7403\u3002<\/p>\n<div class=\"retnvbx1\"><\/div>\n<div class=\"fb-comments-intro-ns\">\n<div class=\"retnvbx\"><\/div>\n<h3><span class=\"teelmeww\">\u544a\u8bc9\u6211\u4f60\u7684\u60f3\u6cd5\uff01<\/span><\/h3>\n<p>\u4f60\u5bf9\u521a\u521a\u8bfb\u5230\u7684\u5185\u5bb9\u6709\u4f55\u770b\u6cd5\uff1f\u5728\u4e0b\u9762\u7ed9\u6211\u7559\u8a00\u3002<\/p>\n<\/div>\n<div id=\"COMMENTING\" class=\"fb-comment\">\n<div class=\"fb-comments\" data-href=\"http:\/\/www.how-to-play-badminton.com\/reverse-slice-drop-shot.html\" data-num-posts=\"15\" data-width=\"100%\"><\/div>\n<h3 class=\"fblikeste\">\u559c\u6b22 Masterbadminton.com\uff1f<\/h3>\n<p>&nbsp;<\/p>\n<div id=\"fb-root\"><\/div>\n<p><script><![CDATA[\n(function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if