{"id":79,"date":"2016-05-16T12:50:06","date_gmt":"2016-05-16T12:50:06","guid":{"rendered":"http:\/\/masterbadminton.dev\/how-to-choose-a-good-badminton-shoe\/"},"modified":"2016-09-06T10:51:29","modified_gmt":"2016-09-06T10:51:29","slug":"badminton-shoe","status":"publish","type":"post","link":"https:\/\/masterbadminton.com\/zh\/badminton-shoe.html","title":{"rendered":"\u5982\u4f55\u9009\u62e9\u4e00\u53cc\u597d\u7684\u7fbd\u6bdb\u7403\u978b"},"content":{"rendered":"<div id=\"ContentColumn\">\n<div class=\"Liner\">\n<div style=\"float: left;\"><\/div>\n<p>\u5728\u4f60\u5306\u5fd9\u8d2d\u4e70\u7fbd\u6bdb\u7403\u978b\u4e4b\u524d\uff0c\u8fd9\u91cc\u6709\u4e00\u4e9b\u9009\u62e9\u6700\u4f73\u978b\u5b50\u7684\u91cd\u8981\u63d0\u793a\u3002<\/p>\n<p>\u9009\u62e9\u4e00\u53cc\u597d\u978b\u7684\u4e24\u4e2a\u4e3b\u8981\u539f\u56e0\uff1a<\/p>\n<ul>\n<li>\u5b83\u80fd\u591f\u5728\u6bd4\u8d5b\u4e2d\u6700\u5927\u5316\u8fd0\u52a8\u8868\u73b0<\/li>\n<li>\u5b83\u80fd\u591f\u9884\u9632\u53d7\u4f24<\/li>\n<\/ul>\n<h2>\u597d\u7684\u978b\u5b50\u5982\u4f55\u6700\u5927\u5316\u7403\u573a\u8868\u73b0<\/h2>\n<p>\u7fbd\u6bdb\u7403\u978b\u7684\u5e38\u89c1\u6280\u672f\u6709\uff1a<\/p>\n<h3>1. Ergoshape\uff08\u63d0\u4f9b\u7a33\u5b9a\u6027\uff09<\/h3>\n<p>\u4e3a\u524d\u811a\u638c\u548c\u811a\u8dbe\u63d0\u4f9b\u8212\u9002\u548c\u7a33\u5b9a\u6027.<\/p>\n<p>\u811a\u8dbe\u90e8\u4f4d\u7684\u7075\u6d3b\u6027\u5bf9\u4e8e\u6709\u6548\u548c\u6709\u7ec4\u7ec7\u7684\u7fbd\u6bdb\u7403\u6b65\u6cd5\u975e\u5e38\u91cd\u8981.<\/p>\n<p>\u4f8b\u5982\uff0c\u5f53\u4f60\u5904\u4e8e\u51c6\u5907\u59ff\u52bf\u65f6\uff0c\u4f60\u53ef\u4ee5\u5229\u7528\u811a\u8dbe\u5e2e\u52a9\u4f60\u5411\u524d\u6216\u5411\u540e\u5f39\u8df3\u3002<\/p>\n<p class=\"translation-block\">\u5b83\u53ef\u4ee5\u5e2e\u52a9\u4f60\u66f4\u6709\u7206\u53d1\u529b\u5730\u79fb\u52a8\u5230\u7fbd\u6bdb\u7403\u573a\u7684\u524d\u540e\u533a\u57df\uff08\u6b63\u5982\u6211\u5728\u6709\u6548\u7684\u7fbd\u6bdb\u7403\u6b65\u6cd5\u6559\u7a0b\u4e2d\u6240\u89e3\u91ca\u7684\u90a3\u6837\uff0c\u4f60\u7684\u811a\u8dbe\u53ef\u4ee5\u5e2e\u52a9\u4f60\u5411\u524d\u6216\u5411\u540e\u5f39\u8df3\uff0c\u8fd9\u5c31\u662f\u4e3a\u4ec0\u4e48\u5408\u9002\u7684\u978b\u5b50\u5f88\u91cd\u8981\uff09<\/p>\n<h3>2. Power Cushion\uff08\u4f5c\u4e3a\u51cf\u9707\u5668\uff09<\/h3>\n<p>\u5b83\u4f5c\u4e3a\u51cf\u9707\u5668\uff0c\u4f7f\u7a7f\u7740\u8005\u80fd\u591f\u5feb\u901f\u8fdb\u884c\u53cd\u5411\u79fb\u52a8.<\/p>\n<p class=\"translation-block\">\u4f8b\u5982\uff0c\u5f53\u4f60\u5411\u524d\u4f38\u5c55\u5230\u7403\u573a\u7684\u524d\u534a\u533a\u4ee5\u8fdb\u884c\u53cd\u624b\u7fbd\u6bdb\u7403\u6e05\u7403\u65f6\uff0c\u4f60\u7684\u524d\u817f\u5c06\u652f\u6491\u4f60\u7684\u4f53\u91cd\u3002\nPower Cushion\u5c06\u4f5c\u4e3a\u51cf\u9707\u5668\uff08\u7c7b\u4f3c\u4e8e\u6c7d\u8f66\u5236\u52a8\u5668\uff09\uff0c\u5438\u6536\u4f60\u4f53\u91cd\u5728\u524d\u65b9\u7684\u538b\u529b\u3002<\/p>\n<p>\u51cf\u9707\u5668\u5bf9\u4e8e\u5e2e\u52a9\u4f60\u4fdd\u6301\u8eab\u4f53\u5e73\u8861\u975e\u5e38\u6709\u6548\u3002\u8fd9\u4f7f\u5f97\u4f60\u53ef\u4ee5\u5feb\u901f\u5730\u56de\u5230\u7403\u573a\u4e2d\u5fc3\u3002<\/p>\n<h3>3. \u53cc\u91cdRussell Mesh\uff08\u63a7\u5236\u6e7f\u5ea6\uff09<\/h3>\n<p>\u5b83\u6bd4\u666e\u901a\u978b\u5b50\u63d0\u4f9b8\u500d\u7684\u7a7a\u6c14\u4ea4\u6362\uff0c\u4ee5\u9632\u6b62\u6e7f\u6c14\/\u6c57\u6c34\u5728\u4f60\u7684\u811a\u5468\u56f4\u79ef\u805a\u3002\u5b83\u4e5f\u662f\u8f7b\u4fbf\u8010\u7528\u7684\u3002<\/p>\n<p>\u7531\u4e8e\u53cc\u91cdRussell Mesh\u907f\u514d\u4e86\u978b\u5b50\u5185\u90e8\u7684\u6c57\u6c34\u79ef\u805a\uff0c\u6240\u4ee5\u4f60\u5728\u6253\u7fbd\u6bdb\u7403\u65f6\u4f1a\u611f\u89c9\u66f4\u52a0\u8212\u9002\u3002\u6b64\u5916\uff0c\u5f53\u978b\u5b50\u5185\u90e8\u6ca1\u6709\u6e7f\u6c14\u65f6\uff0c\u4f60\u4e5f\u80fd\u591f\u9884\u9632\u6c34\u6ce1\u7684\u4ea7\u751f\u3002<\/p>\n<h2>\u597d\u978b\u5b50\u5982\u4f55\u9884\u9632\u53d7\u4f24<\/h2>\n<h3>1. \u8e1d\u5173\u8282\u53d7\u4f24<\/h3>\n<p class=\"translation-block\">\u9632\u9707\u673a\u5236\u5bf9\u4e8e\u9884\u9632\u8e1d\u5173\u8282\u53d7\u4f24\u81f3\u5173\u91cd\u8981\u3002\u978b\u5b50\u7684\u9632\u9707\u6027\u5dee\u53ef\u80fd\u4f1a\u5bfc\u81f4\u4f60\u626d\u4f24\u6216\u626d\u66f2\u8e1d\u5173\u8282\u3002\u66f4\u4e25\u91cd\u7684\u4f24\u5bb3\u5305\u62ec\u635f\u4f24\u4f60\u8e1d\u90e8\u5468\u56f4\u7684\u808c\u8171\u6216\u9aa8\u9abc\u3002<\/p>\n<p>\u4e25\u91cd\u7684\u8e1d\u5173\u8282\u53d7\u4f24\u53ef\u80fd\u4f1a\u8ba9\u4f60\u5728\u7fbd\u6bdb\u7403\u6216\u5176\u4ed6\u8fd0\u52a8\u4e2d\u957f\u8fbe6\u4e2a\u6708\u4e0d\u80fd\u6d3b\u52a8\u3002\u4f60\u4e0d\u60f3\u53d1\u751f\u8fd9\u79cd\u60c5\u51b5\u5427\uff1f<\/p>\n<p>\u5982\u679c\u4f60\u6bd4\u8f83\u6fc0\u70c8\u5730\u8fdb\u884c\u6bd4\u8d5b\uff0c\u5982\u679c\u4f60\u4e0d\u7a7f\u6b63\u786e\u7684\u978b\u5b50\uff0c\u90a3\u4e48\u53d7\u4f24\u7684\u98ce\u9669\u5c31\u66f4\u9ad8\u3002\u6240\u4ee5\u8981\u9009\u62e9\u4e00\u53cc\u5408\u9002\u7684\u978b\u5b50\uff01<\/p>\n<h3>2.\u6c34\u6ce1<\/h3>\n<p class=\"translation-block\">\u7fbd\u6bdb\u7403\u8fd0\u52a8\u978b\u7684\u7279\u6b8a\u978b\u5e95\u5bf9\u4e8e\u9884\u9632\u6c34\u6ce1\u975e\u5e38\u91cd\u8981\u3002\u6301\u7eed\u5728\u786c\u8868\u9762\u4e0a\u6469\u64e6\u4f1a\u5bfc\u81f4\u76ae\u80a4\u6c34\u6ce1\u3002<\/p>\n<p class=\"translation-block\">\u7fbd\u6bdb\u7403\u978b\u7684\u8bbe\u8ba1\u53ef\u4ee5\u907f\u514d\u6469\u64e6\u3002Ergoshape\u662f\u9884\u9632\u6c34\u6ce1\u7684\u6709\u6548\u89e3\u51b3\u65b9\u6848\u3002<\/p>\n<p class=\"translation-block\">\u6b64\u5916\uff0cDoubles Russell Mesh\u53ef\u4ee5\u9632\u6b62\u978b\u5185\u79ef\u805a\u6e7f\u6c14\u3002\u6ca1\u6709\u6e7f\u6c14\uff0c\u4f60\u7684\u811a\u5c31\u4e0d\u4f1a\u4e0e\u889c\u5b50\u6216\u978b\u5b50\u5185\u90e8\u6469\u64e6\uff0c\u4ece\u800c\u6709\u52a9\u4e8e\u9884\u9632\u6c34\u6ce1\u3002<\/p>\n<p class=\"translation-block\">\u6211\u4eec\u901a\u5e38\u5c06\u978b\u5b50\u5206\u4e3a\u4f4e\u7aef\u3001\u4e2d\u6863\u548c\u9ad8\u7aef\u3002\u4e2d\u6863\u7684\u7fbd\u6bdb\u7403\u978b\u5e94\u8be5\u5177\u5907\u4e0a\u8ff0\u6280\u672f\uff08\u6216\u7c7b\u4f3c\u6280\u672f\uff09\uff0c\u5e76\u4e14\u5176\u76ee\u7684\u4f1a\u5f97\u5230\u5f88\u597d\u7684\u5b9e\u73b0\u3002<\/p>\n<p class=\"translation-block\">\u5982\u679c\u4f60\u60f3\u8981\u4e00\u53cc\u8db3\u591f\u9002\u5408\u4f11\u95f2\u7fbd\u6bdb\u7403\u6bd4\u8d5b\u7684\u978b\u5b50\uff0c\u53ef\u4ee5\u8003\u8651Hi Tec\u7fbd\u6bdb\u7403\u978b\u3002\u5b83\u4eec\u4ef7\u683c\u4e0d\u7b97\u592a\u8d35\uff0c\u5176\u4ef7\u683c\u53cd\u6620\u4e86\u978b\u5b50\u7684\u771f\u5b9e\u4ef7\u503c\u3002<\/p>\n<p class=\"translation-block\">\u7136\u800c\uff0c\u5982\u679c\u4f60\u60f3\u8fdb\u4e00\u6b65\u63d0\u9ad8\u5728\u7fbd\u6bdb\u7403\u6bd4\u8d5b\u4e2d\u7684\u8868\u73b0\uff0c\u73b0\u5728\u5e02\u573a\u4e0a\u6709\u66f4\u591a\u7684\u6280\u672f\u53ef\u7528\u3002\u5b83\u4eec\u5305\u62ecTough Brid\u3001Lateral Claw\u3001Hyper msLite\u7b49\u3002<\/p>\n<p>\u8bf7\u67e5\u770bYonex\u978b\u5b50\u6280\u672f\u7684\u7f51\u7ad9\uff0c\u4ee5\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u7fbd\u6bdb\u7403\u978b\u7684\u53ef\u7528\u6280\u672f\u3002<\/p>\n<h2>\u8d2d\u4e70\u7fbd\u6bdb\u7403\u978b\u65f6\u8981\u8003\u8651\u7684\u5176\u4ed6\u4e8b\u9879:<\/h2>\n<h3>1. \u9009\u62e9\u5408\u811a\u7684\u978b\u5b50<\/h3>\n<p>\u5982\u679c\u4f60\u7684\u978b\u5b50\u6709\u989d\u5916\u7684\u7a7a\u95f4\uff08\u6216\u8005\u4f60\u7684\u811a\u53ef\u4ee5\u5728\u978b\u5185\u79fb\u52a8\uff09\uff0c\u4f60\u7684\u811a\u548c\u978b\u5b50\u4e4b\u95f4\u7684\u6469\u64e6\u4f1a\u5f15\u8d77\u6c34\u6ce1\u3002<\/p>\n<h3>2. \u4e3a\u4f60\u7684\u978b\u5b50\u63d0\u4f9b\u201c\u5b63\u8282\u201d\u7a7a\u95f4<\/h3>\n<p>\u8fd0\u52a8\u978b\u5728\u7a7f\u51e0\u6b21\u540e\u6700\u7ec8\u4f1a\u677e\u4e00\u70b9\u662f\u5f88\u5e38\u89c1\u7684\u3002<\/p>\n<p>\u56e0\u6b64\uff0c\u5982\u679c\u60a8\u7a7f\u7684\u5c3a\u7801\u5408\u9002\u4f46\u611f\u89c9\u6709\u70b9\u7d27\uff0c\u8bf7\u5fcd\u8010\u4e00\u4e0b\uff0c\u4e0d\u8981\u9009\u62e9\u4e0b\u4e00\u4e2a\u5c3a\u7801\u3002\u5b83\u4f1a\u5b63\u8282\u3002<\/p>\n<p>\u786e\u4fdd\u60a8\u7a7f\u7740\u5408\u9002\u5c3a\u7801\u7684\u4e00\u79cd\u597d\u6