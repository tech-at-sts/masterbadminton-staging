f5c\u7684\u4eba\u4eec\u80fd\u591f\u51c6\u65f6\u5b8c\u6210\u4efb\u52a1\u3002<\/p>\n<p>\u4e0d\u8fc7\uff0c\u56db\u5206\u4e4b\u4e00\u51b3\u8d5b\u63d0\u524d\u5728\u4e0b\u53483\u70b9\u5f00\u59cb\u5bf9\u7403\u5458\u6765\u8bf4\u662f\u4ef6\u597d\u4e8b\u3002<\/p>\n<p>\u5982\u679c\u56db\u5206\u4e4b\u4e00\u51b3\u8d5b\u662f\u4e0b\u53486\u70b9\u5f00\u59cb\uff0c\u90a3\u4e48\u5f88\u53ef\u80fd\u4f1a\u5728\u4e2d\u534812\u70b9\u5de6\u53f3\u7ed3\u675f\uff01<\/p>\n<p>\u7b2c\u4e8c\u5929\u8fdb\u5165\u534a\u51b3\u8d5b\u7684\u7403\u5458\u53ef\u80fd\u9700\u8981\u4f11\u606f\u548c\u6062\u590d\u3002\u4e5f\u8bb8\u8fd8\u53ef\u4ee5\u4e0e\u751f\u7406\u5b66\u5bb6\u8fdb\u884c\u4e00\u6b21\u7b80\u77ed\u7684\u4f1a\u9762\u3002\u7b49\u4ed6\u4eec\u4f11\u606f\u7684\u65f6\u5019\uff0c\u5df2\u7ecf\u51cc\u6668\u4e00\u4e24\u70b9\u4e86\u3002<\/p>\n<p>\u6240\u4ee5\u4e5f\u8bb8\u9a6c\u6765\u897f\u4e9a\u7fbd\u534f\u5728\u56db\u5206\u4e4b\u4e00\u51b3\u8d5b\u4e2d\u8003\u8651\u4e86\u7403\u5458\u7684\u5174\u8da3\u3002<\/p>\n<h3>\u5730\u70b9<\/h3>\n<p>2012\u5e74\u9a6c\u6765\u4e9a\u94f6\u884c\u9a6c\u6765\u897f\u4e9a\u516c\u5f00\u8d5b\u5c06\u5728\u4f4d\u4e8e\u6b66\u5409\u52a0\u91cc\u5c14\u56fd\u5bb6\u4f53\u80b2\u4e2d\u5fc3\u7684\u5e03\u7279\u62c9\u4f53\u80b2\u573a\u4e3e\u884c\u3002<\/p>\n<p>\u4f53\u80b2\u573a\u662f\u4f53\u80b2\u4e2d\u5fc3\u7684\u4f17\u591a\u5efa\u7b51\u4e4b\u4e00\u3002\u5982\u679c\u60a8\u4e0d\u719f\u6089\u8fd9\u4e2a\u5730\u65b9\uff0c\u60a8\u53ef\u80fd\u4f1a\u5f88\u96be\u627e\u5230\u5b83\u3002\n<\/p>\n<p>\u4e00\u4e2a\u597d\u7684\u65b9\u6cd5\u662f <strong>\u968f\u6ce2\u9010\u6d41<\/strong> \u56e0\u4e3a\u4ed6\u4eec\u5728\u8fd9\u4e9b\u65e5\u671f\u6765\u5230\u56fd\u5bb6\u7efc\u5408\u5927\u697c\u7684\u552f\u4e00\u539f\u56e0\u662f\u89c2\u770b\u9a6c\u6765\u897f\u4e9a\u8d85\u7ea7\u7cfb\u5217\u8d5b\u3002<\/p>\n<p>\u4ee5\u9632\u4e07\u4e00\u4f60\u8ba4\u4e3a\u81ea\u5df1\u4f1a\u8ff7\u8def <a href=\"http:\/\/maps.google.com.my\/maps?q=stadium+putra&amp;oe=utf-8&amp;rls=org.mozilla:en-US:official&amp;client=firefox-a&amp;um=1&amp;ie=UTF-8&amp;hl=en&amp;sa=N&amp;tab=wl\" target=\"_blank\" onclick=\"return FIX.track(this);\">\u70b9\u51fb\u8fd9\u91cc\u67e5\u770b\u5e03\u7279\u62c9\u4f53\u80b2\u573a\u7684\u4f4d\u7f6e<\/a>.<\/p>\n<p class=\"Thumbnail\"><a href=\"\/zh\/maybank-malaysia-open-2012.html\/\" onclick=\"return FIX.track(this);\"> <img loading=\"lazy\" decoding=\"async\" src=\"..\/wp-content\/uploads\/2016\/03\/msia-open-1.jpg\" width=\"436\" height=\"81\" alt=\"badminton malaysia open\"\/><\/a><\/p>\n<h3>\u521d\u6b65\u8981\u70b9\u548c\u4e00\u4e9b\u6709\u8da3\u7684\u4e8b\u5b9e<\/h3>\n<p>2012 \u5e74\u9a6c\u6765\u897f\u4e9a\u7fbd\u6bdb\u7403\u516c\u5f00\u8d5b\u662f OSIM BWF \u4e16\u754c\u8d85\u7ea7\u7cfb\u5217\u8d5b\u7684\u4e00\u9879\u8d5b\u4e8b\uff0c2012 \u5e74\u5c06\u662f\u4e16\u754c\u7cfb\u5217\u8d5b\u7684\u7b2c\u4e8c\u4e2a\u8d5b\u5b63\u3002<\/p>\n<p>\u6211\u4eec\u7b54\u5e94\u7ed9\u4f60\u4e00\u4e9b\u7fbd\u6bdb\u7403\u620f\u5267 <a href=\"\/zh\/maybank-malaysia-open-2012.html\/\" onclick=\"return FIX.track(this);\">2012 \u5e74\u9a6c\u6765\u4e9a\u94f6\u884c\u9a6c\u6765\u897f\u4e9a\u516c\u5f00\u8d5b\u516c\u544a\u9875\u9762<\/a>\uff0c\u6240\u4ee5\u5c31\u5728\u8fd9\u91cc\u3002<\/p>\n<p>2011\u5e74\u4e16\u754c\u8d85\u7ea7\u7cfb\u5217\u8d5b\u7b2c\u4e00\u8d5b\u5b63\uff0c\u6765\u81ea\u4e16\u754c\u5404\u5730\u7684\u9876\u5c16\u7fbd\u6bdb\u7403\u9009\u624b\u594b\u529b\u62fc\u640f\uff0c\u53ea\u4e3a\u8d62\u5f97\u5b9d\u8d35\u7684\u4e16\u754c\u7fbd\u8054\u6392\u540d\u79ef\u5206\uff0c\u5f53\u7136\u8fd8\u6709\u5956\u91d1\uff01<\/p>\n<p>\u6211\u4eec\u89c1\u8bc1\u4e86\u4f20\u5947\u7684\u9668\u843d\u548c\u65b0\u661f\u7684\u5d1b\u8d77\u3002<\/p>\n<p>2012\u5e74\u9a6c\u6765\u897f\u4e9a\u8d85\u7ea7\u7cfb\u5217\u8d5b\u6807\u5fd7\u7740\u8d5b\u5b63\u7684\u5f00\u59cb\uff0c\u53ea\u662f\u5c06\u53bb\u5e74\u7684\u7fbd\u6bdb\u7403\u5927\u620f\u5168\u90e8\u5411\u524d\u63a8\u8fdb\u3002<\/p>\n<p>\u4e00\u5e74\u524d\u76842011\u5b9d\u817e\u9a6c\u6765\u897f\u4e9a\u516c\u5f00\u8d5b\u4e0a\uff0c\u73b0\u4efb\u4e16\u754c\u7b